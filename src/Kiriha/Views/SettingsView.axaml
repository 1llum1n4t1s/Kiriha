<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kiriha.ViewModels"
             xmlns:m="using:Kiriha.Models"
             xmlns:c="using:Kiriha.Controls"
             x:Class="Kiriha.Views.SettingsView"
             x:DataType="vm:TabViewModel">
    <!-- 設定タブの中身。MainWindow.axaml から分離（DataContext は TabViewModel、ウィンドウ設定へは $parent[Window] 経由）。
         表示文字列は Assets/Locales の Text.* を DynamicResource で引く（言語切り替えで即時反映される）。 -->
    <Border Background="{DynamicResource SettingsPageBg}">
                        <Grid Margin="24">
                        <TabControl Classes="settingsnav">

                            <!-- ===== 表示 ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="fico" Text="&#xE890;" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Settings.Display}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer>
                                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                                        <Border Classes="settingshero">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Classes="settingsheroicon">
                                                    <TextBlock Classes="fico" Text="&#xE890;" FontSize="21"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="settingsh1" Text="{DynamicResource Text.Settings.Display}" />
                                                    <TextBlock Classes="settingsherosubtitle" Text="{DynamicResource Text.Settings.Display.Subtitle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Language}">
                                            <StackPanel Classes="settingsfields">
                                                <ComboBox Classes="settingsfield" MinWidth="240" HorizontalAlignment="Left"
                                                          ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LocaleOptions}"
                                                          SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptLocale, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="m:Locale">
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Classes="settingscaption" TextWrapping="Wrap"
                                                           Text="{DynamicResource Text.Settings.Language.Note}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Explorer}">
                                            <StackPanel Classes="settingsfields">
                                                <CheckBox Content="{DynamicResource Text.Settings.ShowHidden}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptShowHidden}" />
                                                <CheckBox Content="{DynamicResource Text.Settings.ShowExtensions}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptShowExtensions}" />
                                                <CheckBox Content="{DynamicResource Text.Settings.ShowCheckBoxes}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptShowCheckBoxes}" />
                                                <CheckBox Content="{DynamicResource Text.Settings.ShowBookmarksBar}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowBookmarksBar}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.FolderTree}">
                                            <StackPanel Classes="settingsfields">
                                                <CheckBox Content="{DynamicResource Text.Settings.TreeDragDisabled}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptSidebarTreeDragDisabled}" />
                                                <CheckBox Content="{DynamicResource Text.Settings.TreeDropDisabled}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptSidebarTreeDropDisabled}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Mouse}">
                                            <StackPanel Spacing="10">
                                                <!-- 表示はロケール文字列、内部値（settings.json）は英語（テーマ設定と同じ Tag 方式） -->
                                                <TextBlock Text="{DynamicResource Text.Settings.Mouse.TabDoubleClick}" FontSize="13" />
                                                <ComboBox Classes="settingsfield" MinWidth="240" HorizontalAlignment="Left"
                                                          SelectedValue="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptTabDoubleClickAction}"
                                                          SelectedValueBinding="{Binding Tag, x:DataType=ComboBoxItem}">
                                                    <ComboBoxItem Tag="None" Content="{DynamicResource Text.Settings.Mouse.None}" />
                                                    <ComboBoxItem Tag="Pin" Content="{DynamicResource Text.Settings.Mouse.Pin}" />
                                                    <ComboBoxItem Tag="Close" Content="{DynamicResource Text.Settings.Mouse.CloseTab}" />
                                                </ComboBox>
                                                <TextBlock Text="{DynamicResource Text.Settings.Mouse.TabMiddleClick}" FontSize="13" Margin="0,6,0,0" />
                                                <ComboBox Classes="settingsfield" MinWidth="240" HorizontalAlignment="Left"
                                                          SelectedValue="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptTabMiddleClickAction}"
                                                          SelectedValueBinding="{Binding Tag, x:DataType=ComboBoxItem}">
                                                    <ComboBoxItem Tag="None" Content="{DynamicResource Text.Settings.Mouse.None}" />
                                                    <ComboBoxItem Tag="Pin" Content="{DynamicResource Text.Settings.Mouse.Pin}" />
                                                    <ComboBoxItem Tag="Close" Content="{DynamicResource Text.Settings.Mouse.CloseTab}" />
                                                </ComboBox>
                                                <TextBlock Text="{DynamicResource Text.Settings.Mouse.BackgroundDoubleClick}" FontSize="13" Margin="0,6,0,0" />
                                                <ComboBox Classes="settingsfield" MinWidth="240" HorizontalAlignment="Left"
                                                          SelectedValue="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptBackgroundDoubleClickAction}"
                                                          SelectedValueBinding="{Binding Tag, x:DataType=ComboBoxItem}">
                                                    <ComboBoxItem Tag="None" Content="{DynamicResource Text.Settings.Mouse.None}" />
                                                    <ComboBoxItem Tag="Up" Content="{DynamicResource Text.Settings.Mouse.Up}" />
                                                    <ComboBoxItem Tag="Refresh" Content="{DynamicResource Text.Settings.Mouse.Refresh}" />
                                                </ComboBox>
                                                <TextBlock Text="{DynamicResource Text.Settings.Mouse.BackgroundMiddleClick}" FontSize="13" Margin="0,6,0,0" />
                                                <ComboBox Classes="settingsfield" MinWidth="240" HorizontalAlignment="Left"
                                                          SelectedValue="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptBackgroundMiddleClickAction}"
                                                          SelectedValueBinding="{Binding Tag, x:DataType=ComboBoxItem}">
                                                    <ComboBoxItem Tag="None" Content="{DynamicResource Text.Settings.Mouse.None}" />
                                                    <ComboBoxItem Tag="Up" Content="{DynamicResource Text.Settings.Mouse.Up}" />
                                                    <ComboBoxItem Tag="Refresh" Content="{DynamicResource Text.Settings.Mouse.Refresh}" />
                                                </ComboBox>
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Icons}">
                                            <StackPanel Classes="settingsfields">
                                                <ComboBox Classes="settingsfield" MinWidth="240" HorizontalAlignment="Left"
                                                          SelectedValue="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptIconSet}"
                                                          SelectedValueBinding="{Binding Tag, x:DataType=ComboBoxItem}">
                                                    <ComboBoxItem Tag="Original" Content="{DynamicResource Text.Settings.IconSet.Original}" />
                                                    <ComboBoxItem Tag="Material" Content="{DynamicResource Text.Settings.IconSet.Material}" />
                                                    <ComboBoxItem Tag="Windows" Content="{DynamicResource Text.Settings.IconSet.Windows}" />
                                                </ComboBox>
                                                <TextBlock Classes="settingscaption" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="{DynamicResource Text.Settings.IconSet.Note}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Theme}">
                                            <StackPanel Spacing="12">
                                                <!-- 表示はロケール文字列、内部値（settings.json / ApplyTheme の switch）は英語のまま。
                                                     SelectedValueBinding=Tag で ComboBoxItem.Tag を選択値として扱う。 -->
                                                <ComboBox Classes="settingsfield"
                                                          SelectedValue="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptTheme}"
                                                          SelectedValueBinding="{Binding Tag, x:DataType=ComboBoxItem}"
                                                          MinWidth="200" HorizontalAlignment="Left">
                                                    <ComboBoxItem Tag="System" Content="{DynamicResource Text.Settings.Theme.System}" />
                                                    <ComboBoxItem Tag="Light" Content="{DynamicResource Text.Settings.Theme.Light}" />
                                                    <ComboBoxItem Tag="Dark" Content="{DynamicResource Text.Settings.Theme.Dark}" />
                                                    <ComboBoxItem Tag="OneDark">One Dark</ComboBoxItem>
                                                </ComboBox>
                                                <CheckBox Content="{DynamicResource Text.Settings.Acrylic}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptUseAcrylicBackground}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- ===== 起動 ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="fico" Text="&#xE7E8;" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Settings.Startup}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer>
                                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                                        <Border Classes="settingshero">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Classes="settingsheroicon">
                                                    <TextBlock Classes="fico" Text="&#xE7E8;" FontSize="21"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="settingsh1" Text="{DynamicResource Text.Settings.Startup}" />
                                                    <TextBlock Classes="settingsherosubtitle" Text="{DynamicResource Text.Settings.Startup.Subtitle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Startup.Behavior}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="settingscaption" Margin="0"
                                                           Text="{DynamicResource Text.Settings.Startup.PathCaption}" />
                                                <TextBox Classes="settingsfield"
                                                         Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptStartupPath}"
                                                         MinWidth="400" HorizontalAlignment="Left" />
                                                <CheckBox Content="{DynamicResource Text.Settings.Startup.RestoreTabs}" Margin="0,8,0,0"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptRestoreAllTabs}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Window}">
                                            <StackPanel Classes="settingsfields">
                                                <CheckBox Content="{DynamicResource Text.Settings.Window.RememberBounds}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptRememberWindowBounds}" />
                                                <TextBlock Classes="settingscaption"
                                                           Text="{DynamicResource Text.Settings.Window.RememberBoundsNote}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.WindowsIntegration}">
                                            <StackPanel Classes="settingsfields">
                                                <CheckBox Content="{DynamicResource Text.Settings.RunAtStartup}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptRunAtStartup}" />
                                                <TextBlock Classes="settingscaption"
                                                           Text="{DynamicResource Text.Settings.RunAtStartupNote}" />
                                                <CheckBox Content="{DynamicResource Text.Settings.ExplorerContextMenu}" Margin="0,8,0,0"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptExplorerContextMenu}" />
                                                <TextBlock Classes="settingscaption"
                                                           Text="{DynamicResource Text.Settings.ExplorerContextMenuNote}" />
                                                <CheckBox Content="{DynamicResource Text.Settings.DefaultFolderApp}" Margin="0,8,0,0"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptDefaultFolderApp}" />
                                                <TextBlock Classes="settingscaption" TextWrapping="Wrap"
                                                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptDefaultFolderAppStatus}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Tray}">
                                            <StackPanel Classes="settingsfields">
                                                <CheckBox Content="{DynamicResource Text.Settings.MinimizeToTray}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptMinimizeToTray}" />
                                                <TextBlock Classes="settingscaption"
                                                           Text="{DynamicResource Text.Settings.MinimizeToTrayNote}" />
                                                <CheckBox Content="{DynamicResource Text.Settings.StartMinimizedToTray}" Margin="0,8,0,0"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptStartMinimizedToTray}" />
                                                <TextBlock Classes="settingscaption"
                                                           Text="{DynamicResource Text.Settings.StartMinimizedToTrayNote}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- ===== 更新と情報 ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="fico" Text="&#xE895;" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Settings.Updates}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer>
                                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                                        <Border Classes="settingshero">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Classes="settingsheroicon">
                                                    <TextBlock Classes="fico" Text="&#xE895;" FontSize="21"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="settingsh1" Text="{DynamicResource Text.Settings.Updates}" />
                                                    <TextBlock Classes="settingsherosubtitle" Text="{DynamicResource Text.Settings.Updates.Subtitle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Updates.VersionCard}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                <Border Grid.RowSpan="2" Grid.Column="0" Width="58" Height="58" Margin="0,0,16,0"
                                                        Background="{DynamicResource SettingsIconBg}" CornerRadius="14">
                                                    <Image Width="48" Height="48" Source="avares://Kiriha/icon/app_icon.png"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VersionText}"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text=".NET 10 / Avalonia UI / Native AOT" Margin="0,4,0,0"
                                                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                                <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                                                          Content="{DynamicResource Text.Settings.Updates.CheckOnStartup}"
                                                          IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OptCheckUpdatesOnStartup}" />
                                                <Button Grid.RowSpan="2" Grid.Column="2" Classes="cmd"
                                                        Content="{DynamicResource Text.Settings.Updates.CheckNow}" Click="CheckUpdate_Click"
                                                        Margin="20,0,0,0" VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                            </Grid>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.License}">
                                            <StackPanel Spacing="10">
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LicenseStatusText}" />
                                                <!-- 認証済みなら購入導線・キー入力欄は不要なので非表示にする -->
                                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsNotLicensed}"
                                                           Text="{DynamicResource Text.License.PurchaseNote}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsNotLicensed}">
                                                    <TextBox Width="330" PlaceholderText="{DynamicResource Text.License.KeyPlaceholder}"
                                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LicenseKeyInput}" />
                                                    <Button Classes="cmd" Content="{DynamicResource Text.License.Activate}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActivateLicenseCommand}"
                                                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                                </StackPanel>
                                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LicenseMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LicenseMessage}" />
                                                <Button Classes="cmd" Content="{DynamicResource Text.License.OpenPurchase}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenLicensePurchasePageCommand}"
                                                        HorizontalAlignment="Left"
                                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsNotLicensed}"
                                                        BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.About}">
                                            <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Text="{DynamicResource Text.Settings.About.Body}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- ===== メンテナンス ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="fico" Text="&#xE90F;" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Settings.Maintenance}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer>
                                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                                        <Border Classes="settingshero">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Classes="settingsheroicon">
                                                    <TextBlock Classes="fico" Text="&#xE90F;" FontSize="21"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="settingsh1" Text="{DynamicResource Text.Settings.Maintenance}" />
                                                    <TextBlock Classes="settingsherosubtitle" Text="{DynamicResource Text.Settings.Maintenance.Subtitle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <HeaderedContentControl Classes="settingscard" Header="{DynamicResource Text.Settings.Maintenance.Data}">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="cmd" Content="{DynamicResource Text.Settings.Maintenance.ReloadQuickAccess}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ReloadSidebarCommand}"
                                                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                                    <Button Classes="cmd" Content="{DynamicResource Text.Settings.Maintenance.OpenLogFolder}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenLogFolderCommand}"
                                                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                                </StackPanel>
                                                <Button Classes="cmd" Content="{DynamicResource Text.Settings.Maintenance.ResetSettings}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResetSettingsCommand}"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- ===== ショートカット ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="fico" Text="&#xE765;" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Settings.Shortcuts}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer>
                                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                                        <Border Classes="settingshero">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Classes="settingsheroicon">
                                                    <TextBlock Classes="fico" Text="&#xE765;" FontSize="21"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="settingsh1" Text="{DynamicResource Text.Settings.Shortcuts}" />
                                                    <TextBlock Classes="settingsherosubtitle" Text="{DynamicResource Text.Settings.Shortcuts.Subtitle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,Auto">
                                            <HeaderedContentControl Grid.Row="0" Grid.Column="0" Classes="settingscard" Header="{DynamicResource Text.Settings.Shortcuts.Tabs}">
                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}" LineHeight="24"
                                                           Text="{DynamicResource Text.Settings.Shortcuts.TabsBody}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Grid.Row="0" Grid.Column="2" Classes="settingscard" Header="{DynamicResource Text.Settings.Shortcuts.Navigation}">
                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}" LineHeight="24"
                                                           Text="{DynamicResource Text.Settings.Shortcuts.NavigationBody}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Grid.Row="1" Grid.ColumnSpan="3" Classes="settingscard" Header="{DynamicResource Text.Settings.Shortcuts.FileOps}">
                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}" LineHeight="24"
                                                           Text="{DynamicResource Text.Settings.Shortcuts.FileOpsBody}" />
                                            </HeaderedContentControl>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>
                        </Grid>
    </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kiriha.ViewModels"
        xmlns:m="using:Kiriha.Models"
        xmlns:c="using:Kiriha.Controls"
        xmlns:v="using:Kiriha.Views"
        x:Class="Kiriha.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/icon/app_icon.png"
        Width="1100" Height="720"
        MinWidth="560" MinHeight="360"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="BorderOnly"
        UseLayoutRounding="True"
        Background="{DynamicResource TabStripBg}">

    <Window.Styles>
        <StyleInclude Source="avares://Kiriha/Views/MainWindowStyles.axaml" />
    </Window.Styles>

    <Panel>
        <!-- Lhamiel / RealTimeTranslator と同等のアクリル背景（設定 > 表示 でON/OFF）。
             実際にぼかしが乗るには Window.Background 側（TabStripBg）が透明である必要があり、
             ON/OFF の色差し替えは ThemeService.ApplyAcrylicBackgrounds が担う。 -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False"
                                   IsVisible="{Binding OptUseAcrylicBackground}">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="{DynamicResource AcrylicTintColor}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <!-- ぼかしの上に重ねるテーマ色の膜。BackgroundSource="Digger" はウィンドウの描画を
             背後の合成面まで掘り抜くので、Window.Background を半透明にしても濃さは変えられず、
             MaterialOpacity / TintOpacity も Win32 のアクリル経路ではほとんど効かない
             （0.85→0.97 に上げても実測で 1 段しか変わらなかった）。濃さの調整はこの膜で行う。
             ここが無いと、透ける部分だけ壁紙の色に染まって不透明な面から浮いて見える。
             濃さは ThemeService.AcrylicScrimBrush が現在のテーマ色から作る。 -->
        <Border Background="{DynamicResource AcrylicScrimBrush}" IsHitTestVisible="False" />

    <!-- ライセンスロック中は IsEnabled で操作領域全体を無効化する。ロック画面のオーバーレイは
         ヒットテスト（マウス）しか塞げず、フォーカスが残った一覧への Delete / Ctrl+X/V 等の
         コントロール直付け KeyDown ハンドラは Window.OnKeyDown のガードより先に発火するため、
         キーボード経路まで塞ぐにはこの無効化が必要。 -->
    <!-- 先頭行（タイトルバー）の高さは、ギャラリーの全画面表示で 0 に畳む
         （MainWindow.ApplyGalleryFullScreen が RowDefinitions[0] を書き換える）。 -->
    <Grid x:Name="RootGrid" RowDefinitions="32,*" ColumnDefinitions="Auto,*"
          IsEnabled="{Binding !IsLicenseLocked}">

        <!-- タブのドラッグ中に、掴んだタブがカーソルへ追従して浮くゴースト表示のオーバーレイ。
             ヒットテストは無効（下の操作を邪魔しない）で、全面に最前面で重ねる。 -->
        <Canvas x:Name="TabDragOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                IsHitTestVisible="False" ZIndex="1000">
            <Border x:Name="TabDragGhost" IsVisible="False"
                    Height="30" MinWidth="110" MaxWidth="240"
                    Background="{DynamicResource TabActiveBg}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                    CornerRadius="8" Opacity="0.95"
                    BoxShadow="0 8 22 0 #66000000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0,12,0" Spacing="8">
                    <TextBlock x:Name="TabDragGhostIcon" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="TabDragGhostText" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ===== 垂直タブ専用タイトルバー ===== -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto"
              Background="Transparent"
              IsVisible="{Binding IsGalleryChromeVisible}"
              PointerPressed="TitleBar_PointerPressed"
              DoubleTapped="TitleBar_DoubleTapped">

            <!-- タブバーと同じ幅の領域にアプリ名と現在のタブ名をまとめ、左ペインの起点を揃える。 -->
            <Grid Grid.Column="0" Width="{Binding VerticalTabWidth}" Margin="12,0,10,0"
                  ColumnDefinitions="Auto,Auto,*" IsHitTestVisible="False">
                <TextBlock Grid.Column="0" Text="Kiriha" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="1" Height="16" Margin="10,0"
                        Background="{DynamicResource Divider}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding SelectedTab.Title}" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- キャプションボタン（WindowDecorations=BorderOnly のためシステム側は描画されない） -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Classes="caption" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="{DynamicResource Text.Caption.Minimize}" />
                <Button Classes="caption" Content="&#xE922;" Click="MaximizeRestore_Click" AutomationProperties.Name="{DynamicResource Text.Caption.MaximizeRestore}" />
                <Button Classes="caption close" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="{DynamicResource Text.Common.Close}" />
            </StackPanel>
        </Grid>

        <!-- ===== 垂直タブバー ===== -->
        <Grid x:Name="VerticalTabStrip" Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto"
              Width="{Binding VerticalTabWidth}"
              IsVisible="{Binding IsGalleryChromeVisible}"
              DragDrop.AllowDrop="True">
            <Grid Grid.Column="0" ClipToBounds="True">
                <!-- ON/OFFともにタイトルバーと同じウィンドウ背景をそのまま見せる。 -->
                <Border Background="{DynamicResource VerticalTabsSurfaceBg}">
                    <Grid RowDefinitions="*,Auto">
                    <ListBox x:Name="VerticalTabsListBox" Grid.Row="0" Classes="verticaltabs"
                             IsVisible="{Binding !SelectedTab.IsGalleryView}"
                             AutomationProperties.Name="{DynamicResource Text.A11y.VerticalTabs}"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding SelectedTab}"
                             DragDrop.AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PointerMoved="Tabs_PointerMoved"
                             PointerReleased="Tabs_PointerReleased">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TabViewModel">
                                <Grid Height="34" ColumnDefinitions="36,*,Auto"
                                      AutomationProperties.Name="{Binding Title}"
                                      Opacity="{Binding TabRowOpacity}"
                                      DoubleTapped="TabRow_DoubleTapped"
                                      Background="Transparent" ToolTip.Tip="{Binding PathText}">
                                    <Grid.ContextMenu>
                                        <ContextMenu Opened="TabMenu_Opened">
                                            <MenuItem Header="{DynamicResource Text.Tab.NewBelow}" Click="TabNewRight_Click" />
                                            <MenuItem Header="{DynamicResource Text.Tab.Duplicate}" Click="TabDuplicate_Click"
                                                      IsVisible="{Binding IsNormalTab}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Tab.Pin}"
                                                      IsVisible="{Binding !IsPinned}"
                                                      Command="{Binding TogglePinCommand}" />
                                            <MenuItem Header="{DynamicResource Text.Tab.Unpin}"
                                                      IsVisible="{Binding IsPinned}"
                                                      Command="{Binding TogglePinCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Tab.Close}"
                                                      Command="{Binding CloseSelfCommand}" />
                                            <MenuItem Header="{DynamicResource Text.Tab.CloseBelow}" Click="TabCloseRight_Click" />
                                            <MenuItem Header="{DynamicResource Text.Tab.CloseOthers}" Click="TabCloseOthers_Click" />
                                            <MenuItem Header="{DynamicResource Text.Tab.MoreActions}" Tag="tabActions" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Tab.Reopen}" Click="TabReopen_Click"
                                                      InputGesture="Ctrl+Shift+T" />
                                            <MenuItem Header="{DynamicResource Text.Tab.RecentlyClosed}" Tag="recent" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Common.CopyPath}" Click="TabCopyPath_Click" />
                                            <MenuItem Header="{DynamicResource Text.Common.OpenInExplorer}"
                                                      Command="{Binding OpenInExplorerCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- 固定タブの目印。行全体へアクセント色を薄く敷き、左端に太めの
                                         アクセントバーを出す。選択中の印（ContentPresenter 側の左 2px 枠）
                                         とは色の面積が違うので、選択と固定は同時に出ても見分けがつく。 -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            IsVisible="{Binding IsPinned}"
                                            Background="{DynamicResource AccentHoverBrush}"
                                            CornerRadius="8" IsHitTestVisible="False" />
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            IsVisible="{Binding IsPinned}"
                                            Width="3" HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="8,0,0,8" IsHitTestVisible="False" />

                                    <Grid Grid.Column="0">
                                        <TextBlock Text="📁" FontSize="13"
                                                   IsVisible="{Binding IsNormalTab}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="⚙" FontSize="13"
                                                   IsVisible="{Binding IsSettingsTab}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               Margin="0,0,8,0" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Classes="fico" Text="&#xE718;"
                                               IsVisible="{Binding IsPinned}" FontSize="12.5"
                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"
                                               ToolTip.Tip="{DynamicResource Text.Tab.Pinned}" />
                                    <Button Grid.Column="2" Classes="tabclose" Content="&#xE8BB;"
                                            IsVisible="{Binding !IsPinned}"
                                            AutomationProperties.Name="{DynamicResource Text.Tab.Close}"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            Command="{Binding CloseSelfCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ギャラリー表示中はタブ一覧の場所に、選択中画像の Exif・メタ情報を出す。
                         新しいタブ / 設定のフッター（下 2 行）はそのまま残す。 -->
                    <Border Grid.Row="0" Padding="12,10,10,8"
                            IsVisible="{Binding SelectedTab.IsGalleryView}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="2">
                                <!-- 回転と拡大縮小の操作は、メイン画像へ重なる共通コントロールバーへ集約した
                                     （MainWindow.axaml の Border.gallerybar）。ここには Exif 等の情報だけを出す。 -->
                                <TextBlock Text="{DynamicResource Text.Gallery.ImageInfo}" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <!-- ファイル名は Exif の読み取りを待たずに出したいので、メタ情報の一覧
                                     （GalleryMetadata）へ混ぜず独立して置く。混ぜると読み込み中は消え、
                                     Exif を持たないファイルでは「情報なし」の案内が出せなくなる。
                                     ラベルは詳細表示の「名前」列と同じキーを使い回す。 -->
                                <StackPanel Margin="0,0,0,9"
                                            IsVisible="{Binding SelectedTab.SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{DynamicResource Text.Column.Name}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding SelectedTab.SelectedEntry.DisplayName}" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap"
                                               ToolTip.Tip="{Binding SelectedTab.SelectedEntry.FullPath}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SelectedTab.GalleryMetadata}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:GalleryMetadataItem">
                                            <StackPanel Margin="0,0,0,9">
                                                <TextBlock Text="{Binding Label}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding Value}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource Text.Gallery.NoImageInfo}" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding SelectedTab.GalleryMetadataEmpty}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- タブ一覧のフッター。アイコンだけを横に並べ、意味はツールチップで伝える。
                         幅の狭いタブ列でも操作が縦に伸びないようにするため。 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2"
                                Margin="8,4,3,10" HorizontalAlignment="Left">
                        <Button x:Name="VerticalNewTabButton"
                                Classes="verticaltabaction verticaltabicon"
                                Command="{Binding NewTabCommand}"
                                AutomationProperties.Name="{DynamicResource Text.Tab.New}"
                                ToolTip.Tip="{DynamicResource Text.Tab.NewTip}">
                            <TextBlock Classes="fico" Text="&#xE710;" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- 並べ替え。固定タブと通常タブは、それぞれのブロック内だけで並び替わる。 -->
                        <Button x:Name="TabSortButton"
                                Classes="verticaltabaction verticaltabicon"
                                AutomationProperties.Name="{DynamicResource Text.Tab.SortTip}"
                                ToolTip.Tip="{DynamicResource Text.Tab.SortTip}">
                            <TextBlock Classes="fico" Text="&#xE8CB;" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedLeft">
                                    <MenuItem Header="{DynamicResource Text.TabAction.SortByName}"
                                              Command="{Binding SortTabsByNameCommand}" />
                                    <MenuItem Header="{DynamicResource Text.TabAction.SortByPath}"
                                              Command="{Binding SortTabsByPathCommand}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Text.TabAction.Reverse}"
                                              Command="{Binding ReverseTabOrderCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="SettingsButton"
                                Classes="verticaltabaction verticaltabicon"
                                AutomationProperties.Name="{DynamicResource Text.Nav.OpenSettings}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="{DynamicResource Text.Nav.OpenSettings}">
                            <TextBlock Classes="fico" Text="&#xE713;" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Thumb x:Name="VerticalTabsResizeThumb" Grid.Column="1" Classes="tabsplit"
                   AutomationProperties.Name="{DynamicResource Text.A11y.ResizeVerticalTabs}"
                   DragDelta="VerticalTabsThumb_DragDelta" />
        </Grid>

        <!-- ===== 選択中タブの中身 =====
             左マージンだけ 0。タブ列側の余白 (3) と掴み代の Thumb (5) で 8px の隙間が
             できており、ここに更に 6 を足すとウィンドウ左端側の 8px と幅が揃わなくなる。
             ギャラリーを画面いっぱいで見ているあいだは余白ごと落とす（MainWindowViewModel
             .IsGalleryEdgeToEdge）。この 6px と下の輪郭線が、最大化時にディスプレイの端へ
             走って「ウィンドウ枠」に見えていたもの。 -->
        <ContentControl Grid.Row="1" Grid.Column="1"
                        Margin="{Binding ContentIslandMargin}"
                        Content="{Binding SelectedTab}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                    <Panel>
                    <Border x:Name="ContentIsland"
                            Background="{DynamicResource ContentBg}"
                            CornerRadius="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ContentIslandCornerRadius}">
                    <Border.Clip>
                        <!-- ClipToBounds は矩形なので、実寸へ追従する角丸ジオメトリで子要素まで切り抜く。
                             Geometry は論理ツリーに乗らないので $parent や DataContext が届かない。
                             角丸は Border 自身から ElementName でもらう（値が 2 か所に散らない利点もある）。 -->
                        <RectangleGeometry Rect="{Binding Bounds, ElementName=ContentIsland}"
                                           RadiusX="{Binding CornerRadius.TopLeft, ElementName=ContentIsland}"
                                           RadiusY="{Binding CornerRadius.TopLeft, ElementName=ContentIsland}" />
                    </Border.Clip>
                    <Panel>

                    <!-- 設定タブの中身。Lhamiel / Shisui / RealTimeTranslator の実装を直接調査し、
                         浮遊カード状サイドバー TabControl + HeaderedContentControl 積みの数値を実測値どおりに再現。 -->
                    <v:SettingsView IsVisible="{Binding IsSettingsTab}" />

                    <!-- アドレスバー・コマンドバー行はいずれも Auto（高さは各要素側で指定）。
                         ギャラリー表示で隠したとき行ごと畳むため -->
                    <!-- 最終行（ステータスバー）も Auto。高さは要素側の 28 で決め、隠したときは
                         行ごと畳む（固定 28 にすると、非表示でも下端に空の帯が残る）。 -->
                    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource ContentBg}"
                          IsVisible="{Binding IsNormalTab}">

                        <!-- ナビゲーション + アドレスバー（テキスト表示） + 検索。ギャラリー表示でも残し、
                             全画面表示のときだけ行ごと畳む（見ている場所と戻る手段を常に出しておく）。 -->
                        <Grid Grid.Row="0" Height="48" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
                              Background="{DynamicResource TabActiveBg}"
                              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsGalleryChromeVisible}">
                            <Button Grid.Column="0" Classes="nav" Content="&#xE72B;" Margin="8,0,0,0"
                                    Command="{Binding GoBackCommand}" ToolTip.Tip="{DynamicResource Text.Nav.BackTip}"
                                    AutomationProperties.Name="{DynamicResource Text.Nav.Back}"
                                    PointerReleased="NavBack_PointerReleased"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="nav" Content="&#xE72A;" Margin="2,0,0,0"
                                    Command="{Binding GoForwardCommand}" ToolTip.Tip="{DynamicResource Text.Nav.ForwardTip}"
                                    AutomationProperties.Name="{DynamicResource Text.Nav.Forward}"
                                    PointerReleased="NavForward_PointerReleased"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="nav" Content="&#xE72C;" Margin="2,0,0,0"
                                    Command="{Binding RefreshCommand}" ToolTip.Tip="{DynamicResource Text.Nav.Refresh}"
                                    AutomationProperties.Name="{DynamicResource Text.Nav.Refresh}"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="nav" Content="&#xE74A;" Margin="2,0,0,0"
                                    Command="{Binding GoUpCommand}" ToolTip.Tip="{DynamicResource Text.Nav.UpTip}"
                                    AutomationProperties.Name="{DynamicResource Text.Nav.UpFolder}"
                                    PointerReleased="NavUp_PointerReleased"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="4" Classes="nav" Content="&#xE80F;" Margin="2,0,0,0"
                                    Click="Home_Click" ToolTip.Tip="{DynamicResource Text.Nav.HomeTip}"
                                    AutomationProperties.Name="{DynamicResource Text.Nav.Home}"
                                    PointerReleased="Home_PointerReleased"
                                    VerticalAlignment="Center" />

                            <Border Grid.Column="5" Background="{DynamicResource OmniboxBg}" CornerRadius="17"
                                    Height="34" Margin="8,0,4,0" VerticalAlignment="Center"
                                    PointerPressed="BreadcrumbBar_PointerPressed"
                                    PointerReleased="BreadcrumbBar_PointerReleased">

                                <Panel>
                                    <!-- 通常表示は Web ブラウザと同じプレーンテキスト（パンくずはステータスバー側）。
                                         クリックで直接入力モードへ切り替わる。 -->
                                    <Border Background="Transparent"
                                            IsVisible="{Binding !IsEditingPath}"
                                            ToolTip.Tip="{DynamicResource Text.Nav.EditPathTip}">
                                        <TextBlock Text="{Binding PathText}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="14,0" />
                                    </Border>

                                    <!-- 直接入力モード -->
                                    <TextBox IsVisible="{Binding IsEditingPath}"
                                             Text="{Binding PathText}"
                                             KeyDown="PathBox_KeyDown"
                                             LostFocus="PathBox_LostFocus"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="13.5"
                                             Foreground="{DynamicResource TextPrimary}"
                                             VerticalContentAlignment="Center"
                                             Margin="10,0">
                                        <TextBox.Styles>
                                            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                        </TextBox.Styles>
                                    </TextBox>
                                </Panel>
                            </Border>

                            <!-- 今開いているフォルダーのパスをコピー。アドレスバーのクリックはクリップボードへ
                                 触れなくなったので（パスを貼り付けたいときに上書きされてしまうため）、コピーは
                                 このボタンで明示的に行う。選択項目のパスはコマンドバー側のボタンが担当する。 -->
                            <Button Grid.Column="6" Classes="nav" Content="&#xE71B;" Margin="0,0,8,0"
                                    ToolTip.Tip="{DynamicResource Text.Command.CopyFolderPathTip}"
                                    AutomationProperties.Name="{DynamicResource Text.Command.CopyFolderPath}"
                                    IsEnabled="{Binding CanCopyFolderPath}"
                                    VerticalAlignment="Center" Click="CopyFolderPath_Click" />

                            <!-- 検索ボックス幅の変更 -->
                            <Thumb Grid.Column="7" Classes="searchsplit"
                                   DragDelta="SearchBoxThumb_DragDelta" />

                            <!-- 検索ボックス（入力でサブフォルダーを含む検索。現在のフォルダーの即時絞り込み表示後に
                                 再帰検索結果へ置き換わる。Enter はデバウンスを待たない即時実行） -->
                            <Border Grid.Column="8"
                                    Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SearchBoxWidth}"
                                    Height="34"
                                    Background="{DynamicResource OmniboxBg}" CornerRadius="17"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Classes="fico" Text="&#xE721;" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes="searchbox"
                                             Text="{Binding SearchText}"
                                             PlaceholderText="{Binding SearchPlaceholder}"
                                             KeyDown="SearchBox_KeyDown"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12.5"
                                             Foreground="{DynamicResource TextPrimary}"
                                             VerticalContentAlignment="Center"
                                             Margin="4,0,10,0">
                                        <TextBox.Styles>
                                            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                        </TextBox.Styles>
                                    </TextBox>
                                    <Button Grid.Column="2" Classes="tabclose" Content="&#xE8BB;"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            ToolTip.Tip="{DynamicResource Text.Search.ClearTip}" AutomationProperties.Name="{DynamicResource Text.Search.ClearTip}"
                                            IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Click="SearchClear_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- コマンドバー（エクスプローラー同等）。ギャラリー表示中は隠す -->
                        <Border Grid.Row="1" Height="40" Background="{DynamicResource ContentBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                IsVisible="{Binding !IsGalleryView}">
                            <StackPanel Orientation="Horizontal" Margin="10,0" Spacing="2">
                                <Button Classes="cmd cmdicon" Content="&#xE8A0;"
                                        ToolTip.Tip="{DynamicResource Text.Command.SidebarTip}"
                                        AutomationProperties.Name="{DynamicResource Text.A11y.ToggleSidebar}"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSidebarCommand}" />

                                <Border Width="1" Height="20" Background="{DynamicResource Divider}"
                                        VerticalAlignment="Center" Margin="4,0" />

                                <Button Classes="cmd" VerticalAlignment="Center" Click="NewFolderButton_Click"
                                        IsEnabled="{Binding CanCreateNew}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="fico" Text="&#xE8F4;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Command.NewFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Border Width="1" Height="20" Background="{DynamicResource Divider}"
                                        VerticalAlignment="Center" Margin="4,0" />

                                <Button Classes="cmd cmdicon" Content="&#xE8C6;" ToolTip.Tip="{DynamicResource Text.Command.CutTip}" AutomationProperties.Name="{DynamicResource Text.Command.Cut}"
                                        VerticalAlignment="Center" Command="{Binding CutCommand}" />
                                <Button Classes="cmd cmdicon" Content="&#xE8C8;" ToolTip.Tip="{DynamicResource Text.Command.CopyTip}" AutomationProperties.Name="{DynamicResource Text.Common.Copy}"
                                        VerticalAlignment="Center" Command="{Binding CopyCommand}" />
                                <!-- 選択した項目のパスをコピー（アドレスバー隣のボタンはフォルダー専用なので、
                                     選択項目のパスはここから取る）。選択が無いときは無効。 -->
                                <Button Classes="cmd cmdicon" Content="&#xE71B;" ToolTip.Tip="{DynamicResource Text.Command.CopyPathTip}" AutomationProperties.Name="{DynamicResource Text.Command.CopyPath}"
                                        VerticalAlignment="Center" IsEnabled="{Binding CanCopySelectedPath}" Click="CopyPath_Click" />
                                <Button Classes="cmd cmdicon" Content="&#xE77F;" ToolTip.Tip="{DynamicResource Text.Command.PasteTip}" AutomationProperties.Name="{DynamicResource Text.Command.Paste}"
                                        VerticalAlignment="Center" Command="{Binding PasteCommand}" />
                                <Button Classes="cmd cmdicon" Content="&#xE8AC;" ToolTip.Tip="{DynamicResource Text.Command.RenameTip}" AutomationProperties.Name="{DynamicResource Text.Command.Rename}"
                                        VerticalAlignment="Center" Command="{Binding RenameCommand}" />
                                <Button Classes="cmd cmdicon" Content="&#xE72D;" ToolTip.Tip="{DynamicResource Text.Command.Share}" AutomationProperties.Name="{DynamicResource Text.Command.Share}"
                                        VerticalAlignment="Center" Command="{Binding ShareCommand}" />
                                <Button Classes="cmd cmdicon" Content="&#xE74D;" ToolTip.Tip="{DynamicResource Text.Command.DeleteTip}" AutomationProperties.Name="{DynamicResource Text.Common.Delete}"
                                        VerticalAlignment="Center" Command="{Binding DeleteCommand}" />
                                <Button Classes="cmd cmdicon" Content="&#xE946;" ToolTip.Tip="{DynamicResource Text.Command.PropertiesTip}"
                                        AutomationProperties.Name="{DynamicResource Text.Common.Properties}"
                                        VerticalAlignment="Center" Command="{Binding ShowPropertiesCommand}" />

                                <Border Width="1" Height="20" Background="{DynamicResource Divider}"
                                        VerticalAlignment="Center" Margin="4,0" />

                                <Button Classes="cmd" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="fico" Text="&#xE8CB;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Command.Sort}" VerticalAlignment="Center" />
                                        <TextBlock Classes="fico" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="{DynamicResource Text.Column.Name}" ToggleType="Radio"
                                                      IsChecked="{Binding IsSortByName}"
                                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Name" />
                                            <MenuItem Header="{DynamicResource Text.Column.Modified}" ToggleType="Radio"
                                                      IsChecked="{Binding IsSortByModified}"
                                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Modified" />
                                            <MenuItem Header="{DynamicResource Text.Column.Created}" ToggleType="Radio"
                                                      IsChecked="{Binding IsSortByCreated}"
                                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Created" />
                                            <MenuItem Header="{DynamicResource Text.Column.Type}" ToggleType="Radio"
                                                      IsChecked="{Binding IsSortByType}"
                                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Type" />
                                            <MenuItem Header="{DynamicResource Text.Column.Size}" ToggleType="Radio"
                                                      IsChecked="{Binding IsSortBySize}"
                                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Size" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Sort.Ascending}" ToggleType="Radio"
                                                      IsChecked="{Binding IsSortAscending}"
                                                      Command="{Binding SetSortAscendingCommand}" CommandParameter="True" />
                                            <MenuItem Header="{DynamicResource Text.Sort.Descending}" ToggleType="Radio"
                                                      IsChecked="{Binding IsSortDescending}"
                                                      Command="{Binding SetSortAscendingCommand}" CommandParameter="False" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <Button Classes="cmd" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="fico" Text="&#xE890;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Command.View}" VerticalAlignment="Center" />
                                        <TextBlock Classes="fico" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <!-- 「PC」は並べて表示に固定するので、表示方法の選択だけ無効化する
                                                 （下のコンパクトビュー以降のトグルは PC でも使える） -->
                                            <MenuItem Header="{DynamicResource Text.View.ExtraLarge}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewExtraLarge}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="ExtraLargeIcons" />
                                            <MenuItem Header="{DynamicResource Text.View.Large}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewLarge}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons" />
                                            <MenuItem Header="{DynamicResource Text.View.Medium}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewMedium}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="MediumIcons" />
                                            <MenuItem Header="{DynamicResource Text.View.Small}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewSmall}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="SmallIcons" />
                                            <MenuItem Header="{DynamicResource Text.View.List}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewList}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="List" />
                                            <MenuItem Header="{DynamicResource Text.View.Details}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewDetails}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="Details" />
                                            <MenuItem Header="{DynamicResource Text.View.Tiles}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewTiles}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="Tiles" />
                                            <MenuItem Header="{DynamicResource Text.View.Gallery}" ToggleType="Radio"
                                                      IsChecked="{Binding IsViewGallery}" IsEnabled="{Binding CanChangeViewMode}"
                                                      Command="{Binding SetViewModeCommand}" CommandParameter="Gallery" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.View.Compact}" ToggleType="CheckBox"
                                                      IsChecked="{Binding IsCompactView}"
                                                      Command="{Binding ToggleCompactViewCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.View.NavigationPane}" ToggleType="CheckBox"
                                                      IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowSidebar}"
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSidebarCommand}" />
                                            <MenuItem Header="{DynamicResource Text.View.PreviewPane}" ToggleType="CheckBox"
                                                      InputGesture="Alt+P"
                                                      IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowPreviewPane}"
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TogglePreviewPaneCommand}" />
                                            <MenuItem Header="{DynamicResource Text.View.StatusBar}" ToggleType="CheckBox"
                                                      IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowStatusBar}"
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleStatusBarCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.View.HiddenFiles}" ToggleType="CheckBox"
                                                      IsChecked="{Binding ShowHidden}"
                                                      Command="{Binding ToggleShowHiddenCommand}" />
                                            <MenuItem Header="{DynamicResource Text.View.FileExtensions}" ToggleType="CheckBox"
                                                      IsChecked="{Binding ShowExtensions}"
                                                      Command="{Binding ToggleShowExtensionsCommand}" />
                                            <MenuItem Header="{DynamicResource Text.View.ItemCheckBoxes}" ToggleType="CheckBox"
                                                      IsChecked="{Binding ShowCheckBoxes}"
                                                      Command="{Binding ToggleShowCheckBoxesCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <Button Classes="cmd cmdicon" Content="&#xE713;" ToolTip.Tip="{DynamicResource Text.Command.Options}" AutomationProperties.Name="{DynamicResource Text.Command.Options}"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSettingsCommand}" />

                                <Button Classes="cmd cmdicon" Content="&#xE712;" ToolTip.Tip="{DynamicResource Text.Command.More}" AutomationProperties.Name="{DynamicResource Text.Command.More}"
                                        VerticalAlignment="Center">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="{DynamicResource Text.Select.All}" Click="SelectAll_Click" InputGesture="Ctrl+A" />
                                            <MenuItem Header="{DynamicResource Text.Select.None}" Click="SelectNone_Click" />
                                            <MenuItem Header="{DynamicResource Text.Select.Invert}" Click="SelectInvert_Click" />
                                            <MenuItem Header="{DynamicResource Text.Select.FoldersOnly}" Click="SelectFolders_Click" />
                                            <MenuItem Header="{DynamicResource Text.Select.FilesOnly}" Click="SelectFiles_Click" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Common.OpenInTerminal}" Command="{Binding OpenTerminalCommand}" />
                                            <MenuItem Header="{DynamicResource Text.Common.OpenInExplorer}" Command="{Binding OpenInExplorerCommand}" />
                                            <MenuItem Header="{DynamicResource Text.Common.PinToQuickAccess}" Click="PinToQuickAccess_Click" />
                                            <MenuItem Header="{DynamicResource Text.Common.AddToBookmarks}" Click="AddBookmark_Click" InputGesture="Ctrl+D" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Common.CopyPath}" Click="CopyPath_Click" InputGesture="Ctrl+Shift+C" />
                                            <MenuItem Header="{DynamicResource Text.Common.Properties}" Command="{Binding ShowPropertiesCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Text.Menu.NewWindow}" Click="NewWindow_Click" InputGesture="Ctrl+N" />
                                            <MenuItem Header="{DynamicResource Text.Menu.CheckUpdate}" Click="CheckUpdate_Click" />
                                            <MenuItem Header="{DynamicResource Text.Menu.About}"
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSettingsCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 左ペイン + ファイル一覧 + プレビュー -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                            <!-- 左ペイン: Windows のクイックアクセス + PC -->
                            <!-- 右の仕切り線は隣の Thumb (colsplit) が描くため Border 側には引かない -->
                            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                                    Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SidebarWidth}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).ShowSidebar" />
                                        <Binding Path="!IsGalleryView" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <Grid RowDefinitions="Auto,Auto,*">
                                <!-- 左ペインの表示切り替え（クイックアクセス / ツリー表示 / お気に入り）。
                                     3 つで 1 組のラジオ相当なので幅を等分する。ラベルはアイコンだけにしてある:
                                     既定幅 230px を 3 分割すると「クイックアクセス」ですら入り切らず、17 言語には
                                     日本語より長い表記もあるため、名前はツールチップと読み上げ名で出す。 -->
                                <Grid Grid.Row="0" Margin="8,8,8,2" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                    <ToggleButton Grid.Column="0" Classes="chip" HorizontalAlignment="Stretch"
                                                  IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarQuickAccess, Mode=TwoWay}"
                                                  AutomationProperties.Name="{DynamicResource Text.Sidebar.QuickAccess}"
                                                  ToolTip.Tip="{DynamicResource Text.Sidebar.QuickAccess}">
                                        <TextBlock Classes="fico" Text="&#xE718;" FontSize="13" VerticalAlignment="Center" />
                                    </ToggleButton>
                                    <ToggleButton Grid.Column="1" Classes="chip" HorizontalAlignment="Stretch"
                                                  IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarTree, Mode=TwoWay}"
                                                  AutomationProperties.Name="{DynamicResource Text.Sidebar.TreeView}"
                                                  ToolTip.Tip="{DynamicResource Text.Sidebar.TreeView}">
                                        <TextBlock Classes="fico" Text="&#xEC0A;" FontSize="13" VerticalAlignment="Center" />
                                    </ToggleButton>
                                    <ToggleButton Grid.Column="2" Classes="chip" HorizontalAlignment="Stretch"
                                                  IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarBookmarks, Mode=TwoWay}"
                                                  AutomationProperties.Name="{DynamicResource Text.Sidebar.Bookmarks}"
                                                  ToolTip.Tip="{DynamicResource Text.Sidebar.Bookmarks}">
                                        <TextBlock Classes="fico" Text="&#xE735;" FontSize="13" VerticalAlignment="Center" />
                                    </ToggleButton>
                                </Grid>

                                <!-- ツリーのヘッダー操作（VSCode のエクスプローラーと同じ 4 ボタン:
                                     新しいファイル / 新しいフォルダー / 最新の情報に更新 / すべて折りたたむ）。
                                     アイコンは VSCode の codicon のパスデータ（CC BY 4.0、
                                     Assets/Codicons/NOTICE.md 参照）。 -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="8,2,8,0"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarTree}">
                                    <Button Classes="treehdr" Click="TreeNewFile_Click"
                                            ToolTip.Tip="{DynamicResource Text.Tree.NewFile}"
                                            AutomationProperties.Name="{DynamicResource Text.Tree.NewFile}">
                                        <Path Width="16" Height="16" Fill="{DynamicResource TextSecondary}"
                                              Data="M5 14C4.448 14 4 13.552 4 13V3C4 2.448 4.448 2 5 2H8V4.5C8 5.328 8.672 6 9.5 6H12V6.025C12.344 6.056 12.677 6.121 13 6.213V5.414C13 5.016 12.842 4.635 12.561 4.353L9.647 1.439C9.366 1.158 8.984 1 8.586 1H5C3.895 1 3 1.895 3 3V13C3 14.105 3.895 15 5 15H7.261C7.008 14.693 6.791 14.357 6.607 14H5ZM9 2.207L11.793 5H9.5C9.224 5 9 4.776 9 4.5V2.207ZM11.5 7C9.015 7 7 9.015 7 11.5C7 13.985 9.015 16 11.5 16C13.985 16 16 13.985 16 11.5C16 9.015 13.985 7 11.5 7ZM14 12H12V14C12 14.276 11.776 14.5 11.5 14.5C11.224 14.5 11 14.276 11 14V12H9C8.724 12 8.5 11.776 8.5 11.5C8.5 11.224 8.724 11 9 11H11V9C11 8.724 11.224 8.5 11.5 8.5C11.776 8.5 12 8.724 12 9V11H14C14.276 11 14.5 11.224 14.5 11.5C14.5 11.776 14.276 12 14 12Z" />
                                    </Button>
                                    <Button Classes="treehdr" Click="TreeNewFolder_Click"
                                            ToolTip.Tip="{DynamicResource Text.Tree.NewFolder}"
                                            AutomationProperties.Name="{DynamicResource Text.Tree.NewFolder}">
                                        <Path Width="16" Height="16" Fill="{DynamicResource TextSecondary}"
                                              Data="M2 4.5V6H5.58579C5.71839 6 5.84557 5.94732 5.93934 5.85355L7.29289 4.5L5.93934 3.14645C5.84557 3.05268 5.71839 3 5.58579 3H3.5C2.67157 3 2 3.67157 2 4.5ZM1 4.5C1 3.11929 2.11929 2 3.5 2H5.58579C5.98361 2 6.36514 2.15804 6.64645 2.43934L8.20711 4H12.5C13.8807 4 15 5.11929 15 6.5V7.25716C14.6929 7.00353 14.3578 6.78261 14 6.59971V6.5C14 5.67157 13.3284 5 12.5 5H8.20711L6.64645 6.56066C6.36514 6.84197 5.98361 7 5.58579 7H2V11.5C2 12.3284 2.67157 13 3.5 13H6.20703C6.30564 13.3486 6.43777 13.6832 6.59971 14H3.5C2.11929 14 1 12.8807 1 11.5V4.5ZM16 11.5C16 13.9853 13.9853 16 11.5 16C9.01472 16 7 13.9853 7 11.5C7 9.01472 9.01472 7 11.5 7C13.9853 7 16 9.01472 16 11.5ZM12 9C12 8.72386 11.7761 8.5 11.5 8.5C11.2239 8.5 11 8.72386 11 9V11H9C8.72386 11 8.5 11.2239 8.5 11.5C8.5 11.7761 8.72386 12 9 12H11V14C11 14.2761 11.2239 14.5 11.5 14.5C11.7761 14.5 12 14.2761 12 14V12H14C14.2761 12 14.5 11.7761 14.5 11.5C14.5 11.2239 14.2761 11 14 11H12V9Z" />
                                    </Button>
                                    <Button Classes="treehdr" Click="TreeRefresh_Click"
                                            ToolTip.Tip="{DynamicResource Text.Tree.Refresh}"
                                            AutomationProperties.Name="{DynamicResource Text.Tree.Refresh}">
                                        <Path Width="16" Height="16" Fill="{DynamicResource TextSecondary}"
                                              Data="M3 8C3 5.23858 5.23858 3 8 3C9.63527 3 11.0878 3.78495 12.0005 5H10C9.72386 5 9.5 5.22386 9.5 5.5C9.5 5.77614 9.72386 6 10 6H12.8904C12.8973 6.00014 12.9041 6.00014 12.911 6H13C13.2761 6 13.5 5.77614 13.5 5.5V2.5C13.5 2.22386 13.2761 2 13 2C12.7239 2 12.5 2.22386 12.5 2.5V4.03138C11.4009 2.78613 9.79253 2 8 2C4.68629 2 2 4.68629 2 8C2 11.3137 4.68629 14 8 14C11.1301 14 13.6999 11.6035 13.9756 8.54488C14.0003 8.26985 13.7975 8.0268 13.5225 8.00202C13.2474 7.97723 13.0044 8.1801 12.9796 8.45512C12.75 11.003 10.6079 13 8 13C5.23858 13 3 10.7614 3 8Z" />
                                    </Button>
                                    <Button Classes="treehdr" Click="TreeCollapse_Click"
                                            ToolTip.Tip="{DynamicResource Text.Tree.CollapseAll}"
                                            AutomationProperties.Name="{DynamicResource Text.Tree.CollapseAll}">
                                        <Path Width="16" Height="16" Fill="{DynamicResource TextSecondary}"
                                              Data="M14 4.27051C14.5999 4.62053 15 5.26009 15 6V11C15 13.21 13.21 15 11 15H6C5.26009 15 4.62053 14.5999 4.27051 14H11C12.65 14 14 12.65 14 11V4.27051Z M9.5 7C9.776 7 10 7.224 10 7.5C10 7.776 9.776 8 9.5 8H5.5C5.224 8 5 7.776 5 7.5C5 7.224 5.224 7 5.5 7H9.5Z M11 2C12.103 2 13 2.897 13 4V11C13 12.103 12.103 13 11 13H4C2.897 13 2 12.103 2 11V4C2 2.897 2.897 2 4 2H11ZM4 3C3.449 3 3 3.449 3 4V11C3 11.552 3.449 12 4 12H11C11.551 12 12 11.552 12 11V4C12 3.449 11.551 3 11 3H4Z" />
                                    </Button>
                                    <!-- VS のソリューションエクスプローラーと同じ「アクティブ ドキュメントとの同期」トグル。
                                         オンの間はナビゲーションへツリーが自動追従する（Path の Fill は
                                         チェック状態でアクセント色に変えるためスタイル側で指定）。 -->
                                    <ToggleButton Classes="treehdr"
                                                  IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SidebarTreeSyncActive, Mode=TwoWay}"
                                                  ToolTip.Tip="{DynamicResource Text.Tree.SyncActive}"
                                                  AutomationProperties.Name="{DynamicResource Text.Tree.SyncActive}">
                                        <Path Width="16" Height="16"
                                              Data="M8.58594 1.00098C8.98394 1.00098 9.36646 1.15943 9.64746 1.44043L12.5605 4.35352C12.8415 4.63552 13.001 5.01704 13.001 5.41504V13.001C13.001 14.106 12.106 15.001 11.001 15.001H5.00098C3.89599 15.001 3.00098 14.106 3.00098 13.001V6.00098H4.00098V13.001C4.00098 13.553 4.44899 14.001 5.00098 14.001H11.001C11.553 14.001 12.001 13.553 12.001 13.001V6.00098H9.50098C8.67299 6.00096 8.00098 5.32897 8.00098 4.50098V2.00098C7.99198 1.97699 7.98265 1.9527 7.97266 1.92871C7.89674 1.74704 7.78717 1.5812 7.64746 1.44238L7.20605 1.00098H8.58594ZM9 4.5C9 4.776 9.224 5 9.5 5H11.793L9 2.20703V4.5Z M4.5 0C4.63299 0 4.75952 0.0534683 4.85352 0.147461L6.85352 2.14746C6.90042 2.19336 6.93789 2.24775 6.96289 2.30859C6.98789 2.36959 7.00097 2.43498 7.00098 2.50098C7.00098 2.56698 6.98789 2.63236 6.96289 2.69336C6.93789 2.75323 6.90043 2.80956 6.85352 2.85547L4.85352 4.85547C4.75956 4.94917 4.63278 5.00195 4.5 5.00195C4.36722 5.00195 4.24044 4.94917 4.14648 4.85547C4.05248 4.76147 3.99902 4.63398 3.99902 4.50098C3.99903 4.36799 4.05249 4.24146 4.14648 4.14746L5.29297 3.00098H2.5C2.10201 3.00098 1.72045 3.15944 1.43945 3.44043C1.15846 3.72242 1.00001 4.10298 1 4.50098V5.50098C1 5.63398 0.947516 5.76147 0.853516 5.85547C0.759563 5.94817 0.632774 6.00098 0.5 6.00098C0.367225 6.00098 0.240437 5.94917 0.146484 5.85547C0.0534844 5.76147 0 5.63398 0 5.50098V4.50098C6.17892e-06 3.83799 0.263427 3.20239 0.732422 2.7334C1.20142 2.26441 1.83701 2.00098 2.5 2.00098H5.29297L4.14648 0.855469C4.05248 0.761469 3.99902 0.633977 3.99902 0.500977C3.99903 0.367985 4.05249 0.241455 4.14648 0.147461C4.24048 0.0534683 4.36701 0 4.5 0Z" />
                                    </ToggleButton>
                                </StackPanel>

                                <!-- お気に入りのヘッダー操作。ペイン背景の右クリックメニューと同じ操作を
                                     アイコンから出せるようにしたもの（項目で埋まると背景を右クリックできなくなるため）。
                                     並べ替えはコマンドバーのソートボタンと同じ「アイコン＋ドロップダウン」形にする。 -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="8,2,8,0"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarBookmarks}">
                                    <Button Classes="treehdr" Click="BookmarkAddCurrent_Click"
                                            ToolTip.Tip="{DynamicResource Text.Bookmarks.AddCurrent}"
                                            AutomationProperties.Name="{DynamicResource Text.Bookmarks.AddCurrent}">
                                        <TextBlock Classes="fico" Text="&#xE710;" FontSize="14"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="treehdr" Width="34"
                                            ToolTip.Tip="{DynamicResource Text.Command.Sort}"
                                            AutomationProperties.Name="{DynamicResource Text.Command.Sort}">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Classes="fico" Text="&#xE8CB;" FontSize="14"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Classes="fico" Text="&#xE70D;" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="{DynamicResource Text.Bookmarks.SortByName}"
                                                          Click="BookmarkSortByName_Click" />
                                                <MenuItem Header="{DynamicResource Text.Bookmarks.SortByPath}"
                                                          Click="BookmarkSortByPath_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>

                                <!-- XP 風フォルダーツリー（デスクトップ > マイ ドキュメント / マイ コンピュータ） -->
                                <TreeView Grid.Row="2" Margin="4,2,0,0"
                                          DragDrop.AllowDrop="True"
                                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarTree}"
                                          ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SidebarTreeRoots}"
                                          SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SidebarTreeSelectedItem, Mode=TwoWay}"
                                          AutoScrollToSelectedItem="True"
                                          SelectionChanged="SidebarTree_SelectionChanged"
                                          PointerReleased="SidebarTree_PointerReleased">
                                    <TreeView.Resources>
                                        <!-- Fluent テーマは Level × TreeViewItemIndent (DynamicResource、既定 16) でインデントを
                                             計算するため、このツリーだけ半分の 8px に上書きする -->
                                        <x:Double x:Key="TreeViewItemIndent">8</x:Double>
                                    </TreeView.Resources>
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem" x:DataType="m:FolderTreeNode">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="MinHeight" Value="26" />
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.DataTemplates>
                                        <!-- インライン新規作成の入力行（VSCode と同じ方式）。
                                             サブクラス側のテンプレートを先に置く（先勝ちで解決されるため）。 -->
                                        <DataTemplate DataType="m:NewTreeItemNode">
                                            <StackPanel Margin="0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" />
                                                    <TextBox Text="{Binding EditText, Mode=TwoWay}"
                                                             MinWidth="130" MinHeight="0" Padding="4,2" FontSize="13"
                                                             Loaded="NewTreeItemBox_Loaded"
                                                             KeyDown="NewTreeItemBox_KeyDown"
                                                             LostFocus="NewTreeItemBox_LostFocus" />
                                                </StackPanel>
                                                <!-- VSCode と同じく、無効な名前や重複は入力欄の直下に出す -->
                                                <Border Margin="21,2,4,0" Padding="6,3" BorderThickness="1"
                                                        Background="{DynamicResource TreeInputErrorBg}"
                                                        BorderBrush="{DynamicResource TreeInputErrorBorder}"
                                                        IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <TextBlock Text="{Binding ValidationError}" FontSize="11.5"
                                                               Foreground="{DynamicResource TreeInputErrorText}"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                        <TreeDataTemplate DataType="m:FolderTreeNode" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
                                                <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </TreeDataTemplate>
                                    </TreeView.DataTemplates>
                                </TreeView>

                                <ListBox Grid.Row="2" Classes="sidebar"
                                         IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarQuickAccess}"
                                         DragDrop.AllowDrop="True"
                                         ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SidebarItems}"
                                         Loaded="Sidebar_Loaded"
                                         SelectionChanged="Sidebar_SelectionChanged"
                                         PointerReleased="Sidebar_PointerReleased">
                                    <ListBox.DataTemplates>
                                        <DataTemplate DataType="m:SidebarHeader">
                                            <TextBlock Text="{Binding Title}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}" FontWeight="SemiBold"
                                                       Margin="4,8,0,2" />
                                        </DataTemplate>
                                        <DataTemplate DataType="m:SidebarLink">
                                            <StackPanel Orientation="Horizontal" Spacing="10"
                                                        Background="Transparent"
                                                        ToolTip.Tip="{Binding Tooltip}">
                                                <Image Source="{Binding IconImage}" Width="16" Height="16"
                                                       IsVisible="{Binding HasIconImage}"
                                                       VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Icon}" FontSize="13"
                                                           IsVisible="{Binding !HasIconImage}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.DataTemplates>
                                </ListBox>

                                <!-- お気に入り（旧お気に入りバーの内容。フォルダーノードは入れ子で畳める）。
                                     ドロップ受け入れとその見た目は bookmarkpane クラスで拾うので、
                                     ここは Border ごと 1 つの領域として扱う。 -->
                                <Border Grid.Row="2" Classes="bookmarkpane" Margin="4,2,4,0"
                                        Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                        DragDrop.AllowDrop="True"
                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarBookmarks}"
                                        PointerReleased="BookmarkPane_PointerReleased">
                                    <Panel>
                                        <TextBlock Text="{DynamicResource Text.Bookmarks.Empty}"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="8,10" VerticalAlignment="Top"
                                                   IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasNoBookmarks}" />
                                        <!-- 下端に余白を開けて、項目でペインが埋まっても背景の右クリック
                                             （現在のフォルダーを追加 / 並べ替え）に届く場所を必ず残す。
                                             横スクロールバーは出さない（幅が足りない名前は末尾を省略する）。 -->
                                        <!-- Ctrl / Shift クリックで複数選べる（まとめて削除するため）。
                                             選んだだけで開く動きは単独選択のときだけに絞ってある
                                             （MainWindow.axaml.cs の BookmarkTree_SelectionChanged）。 -->
                                        <TreeView Margin="0,0,0,28" Padding="0"
                                                  SelectionMode="Multiple"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BookmarkItems}"
                                                  SelectionChanged="BookmarkTree_SelectionChanged"
                                                  KeyDown="BookmarkTree_KeyDown"
                                                  PointerReleased="BookmarkTree_PointerReleased">
                                            <TreeView.Resources>
                                                <!-- ツリー表示側と同じくインデントは半分にする -->
                                                <x:Double x:Key="TreeViewItemIndent">8</x:Double>
                                            </TreeView.Resources>
                                            <TreeView.Styles>
                                                <Style Selector="TreeViewItem">
                                                    <Setter Property="MinHeight" Value="26" />
                                                    <!-- クイックアクセスの行と同じ位置から文字が始まるようにする（実測合わせ） -->
                                                    <Setter Property="Padding" Value="12,0,0,0" />
                                                </Style>
                                                <!-- Fluent の TreeViewItem は開閉シェブロンの領域として
                                                     12px + 左右 12px マージン = 36dip を常に確保する（実測でも
                                                     クイックアクセスより 37dip 右にずれていた）。お気に入りは
                                                     ほぼすべてが子を持たない行なので、その場合は領域ごと畳んで
                                                     クイックアクセスと同じ位置から並べる。 -->
                                                <Style Selector="TreeViewItem:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </Style>
                                                <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
                                                    <Setter Property="Margin" Value="0,0,6,0" />
                                                </Style>
                                            </TreeView.Styles>
                                            <TreeView.ItemTemplate>
                                                <!-- アイコンはクイックアクセスと同じ扱い。リンク項目は実体（フォルダー /
                                                     ファイル）のアイコンを出し、お気に入り内のグループ分けフォルダーだけが
                                                     📁 のまま（実体を持たないノードのため）。 -->
                                                <TreeDataTemplate DataType="m:BookmarkNode" ItemsSource="{Binding Children}">
                                                    <!-- bookmarkrow クラスは、ドラッグ中に行の高さと位置を測るための目印でもある
                                                         （MainWindow.axaml.cs の UpdateBookmarkDropMark）。行の余白まで当たり判定に
                                                         入れたいので Background="Transparent" ＋ 横いっぱいに広げる。 -->
                                                    <Border Classes="bookmarkrow" Background="Transparent"
                                                            HorizontalAlignment="Stretch"
                                                            Classes.dropinto="{Binding IsDropInto}"
                                                            ToolTip.Tip="{Binding Path}">
                                                        <Panel>
                                                            <!-- 横スクロールバーを出さない代わりに、名前は残り幅で末尾を省略する。
                                                                 横並びの StackPanel では子が無限幅で測られて省略が効かないため Grid。 -->
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <Image Grid.Column="0" Source="{Binding IconImage}" Width="16" Height="16"
                                                                       IsVisible="{Binding HasIconImage}"
                                                                       VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13"
                                                                           IsVisible="{Binding !HasIconImage}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="8,0,0,0"
                                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <Border Classes="dropline" VerticalAlignment="Top"
                                                                    IsVisible="{Binding IsDropBefore}" />
                                                            <Border Classes="dropline" VerticalAlignment="Bottom"
                                                                    IsVisible="{Binding IsDropAfter}" />
                                                        </Panel>
                                                    </Border>
                                                </TreeDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Panel>
                                </Border>
                                </Grid>
                            </Border>

                            <!-- 左ペイン幅の変更 -->
                            <Thumb Grid.Column="1" Classes="colsplit panesplit"
                                   DragDelta="SidebarThumb_DragDelta">
                                <Thumb.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).ShowSidebar" />
                                        <Binding Path="!IsGalleryView" />
                                    </MultiBinding>
                                </Thumb.IsVisible>
                            </Thumb>

                            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                                <!-- 詳細表示のカラムヘッダー（クリックでソート / Thumb で幅変更） -->
                                <!-- 行と一緒に横スクロールさせるため、ヘッダーは一覧のスクロール量だけ
                                     RenderTransform でずらす（DetailsList_ScrollChanged）。ClipToBounds が
                                     無いと、ずらした分がペインの外側へはみ出して描かれる。 -->
                                <ItemsControl Grid.Row="0"
                                              ItemsSource="{Binding DetailColumns}"
                                              Margin="12,2,0,2" Background="Transparent"
                                              ClipToBounds="True"
                                              RenderTransform="{Binding DetailHeaderTransform}"
                                              PointerReleased="ColumnHeader_PointerReleased"
                                              IsVisible="{Binding IsDetailsView}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DetailColumnViewModel">
                                            <Border Classes="detailcolumn" Width="{Binding Width}"
                                                    Classes.dragging="{Binding IsDragging}"
                                                    Classes.droptarget="{Binding IsDropTarget}"
                                                    IsVisible="{Binding IsVisible}">
                                                <Grid ColumnDefinitions="*,6">
                                                    <Button Grid.Column="0" Classes="colhead"
                                                            Command="{Binding Owner.SortByColumnCommand}"
                                                            CommandParameter="{Binding Key}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" />
                                                            <TextBlock Classes="fico" Text="{Binding SortGlyph}" FontSize="9"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Thumb Grid.Column="1" Classes="colsplit" DragDelta="ColumnThumb_DragDelta" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Grid.Row="0" Height="1" Background="{DynamicResource Divider}" VerticalAlignment="Bottom"
                                        IsVisible="{Binding IsDetailsView}" />

                                <Panel Grid.Row="1" PointerPressed="FileListSurface_PointerPressed">
                                    <!-- 詳細表示 -->
                                    <ListBox Classes="files details"
                                             Margin="0,0,8,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.ScrollChanged="DetailsList_ScrollChanged"
                                             IsVisible="{Binding IsDetailsView}"
                                             ItemsSource="{Binding Entries}"
                                             SelectedItem="{Binding SelectedEntry}"
                                             SelectionMode="Multiple"
                                             Background="Transparent"
                                             DragDrop.AllowDrop="True"
                                             DoubleTapped="FileList_DoubleTapped"
                                             SelectionChanged="FileList_SelectionChanged"
                                             PointerReleased="FileList_PointerReleased"
                                             KeyDown="FileList_KeyDown"
                                             TextInput="FileList_TextInput">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:FileSystemEntry">
                                                <ItemsControl Margin="8,0,0,0"
                                                            ItemsSource="{Binding $parent[ListBox].((vm:TabViewModel)DataContext).DetailColumns}"
                                                            EffectiveViewportChanged="FileItem_EffectiveViewportChanged"
                                                            DataContextChanged="FileItem_DataContextChanged"
                                                            Height="{Binding $parent[ListBox].((vm:TabViewModel)DataContext).RowHeight}"
                                                            Opacity="{Binding RowOpacity}"
                                                            ToolTip.Tip="{Binding RowTooltip}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DetailColumnViewModel">
                                                            <Panel Width="{Binding Width}" IsVisible="{Binding IsVisible}">
                                                                <!-- 名前列だけを行の反応領域にする: 背景 Transparent で列幅全体をヒット対象にし、
                                                                     ホバー / 選択色もこの Border（namecell）にだけ乗せる -->
                                                                <Border Classes="namecell" IsVisible="{Binding IsName}"
                                                                        Background="Transparent" CornerRadius="4">
                                                                    <Panel>
                                                                        <!-- 選択ハイライト（一覧・アイコン表示の既定選択と同じアクセント青の塗り）。
                                                                             ListBoxItem 既定の全行ハイライトは無効化してあるため、名前列にだけこの層で描く -->
                                                                        <Border IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                                                                Background="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                                                                                CornerRadius="4" />
                                                                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="4,0">
                                                                            <CheckBox Grid.Column="0" MinWidth="0" Padding="0" Margin="0,0,6,0"
                                                                                      IsVisible="{Binding Owner.ShowCheckBoxes}"
                                                                                      IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=TwoWay}" />
                                                                            <c:FileIconPresenter Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                                                 Entry="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext)}"
                                                                                                 Owner="{Binding Owner}" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext).DisplayName}" FontSize="13"
                                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Panel>
                                                                </Border>
                                                                <Grid IsVisible="{Binding IsModified}" IsHitTestVisible="False" ClipToBounds="True">
                                                                    <TextBlock Text="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext).ModifiedText}" FontSize="12.5" Padding="6,0,0,0"
                                                                               IsVisible="{Binding !$parent[ItemsControl].((m:FileSystemEntry)DataContext).IsDrive}"
                                                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                                    <ProgressBar IsVisible="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext).IsDrive}"
                                                                                 Minimum="0" Maximum="100"
                                                                                 Value="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext).DriveUsedPercent}"
                                                                                 MinWidth="0" HorizontalAlignment="Stretch"
                                                                                 Height="10" Margin="6,0,12,0" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock IsVisible="{Binding IsCreated}" IsHitTestVisible="False"
                                                                           Text="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext).CreatedText}" FontSize="12.5" Padding="6,0,0,0"
                                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                                <TextBlock IsVisible="{Binding IsType}" IsHitTestVisible="False"
                                                                           Text="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext).TypeText}" FontSize="12.5" Padding="6,0,0,0"
                                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock IsVisible="{Binding IsSize}" IsHitTestVisible="False"
                                                                           Text="{Binding $parent[ItemsControl].((m:FileSystemEntry)DataContext).SizeText}" FontSize="12.5" Padding="6,0,6,0"
                                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                                           TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                            </Panel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Width="30" HorizontalAlignment="Right" Background="Transparent"
                                            IsVisible="{Binding IsDetailsView}"
                                            PointerPressed="FileListClearArea_PointerPressed"
                                            ToolTip.Tip="{DynamicResource Text.Status.ClearSelectionTip}" />

                                    <!-- 一覧 / 小アイコン表示 -->
                                    <ListBox Classes="files list"
                                             Classes.smallicons="{Binding IsViewSmall}"
                                             Classes.listview="{Binding IsViewList}"
                                             IsVisible="{Binding IsListView}"
                                             ItemsSource="{Binding Entries}"
                                             SelectedItem="{Binding SelectedEntry}"
                                             SelectionMode="Multiple"
                                             Background="Transparent"
                                             Padding="12,8,0,0"
                                             ScrollViewer.ScrollChanged="FileListScroll_ScrollChanged"
                                             DragDrop.AllowDrop="True"
                                             DoubleTapped="FileList_DoubleTapped"
                                             SelectionChanged="FileList_SelectionChanged"
                                             PointerReleased="FileList_PointerReleased"
                                             KeyDown="FileList_KeyDown"
                                             TextInput="FileList_TextInput">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:VirtualizingWrapPanel Orientation="{Binding ListOrientation}"
                                                                         ItemWidth="220"
                                                                         MaximumItemWidth="380"
                                                                         ItemHeight="{Binding ListRowHeight}"
                                                                         CacheRows="1" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:FileSystemEntry">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0"
                                                            Background="Transparent"
                                                            EffectiveViewportChanged="FileItem_EffectiveViewportChanged"
                                                            DataContextChanged="FileItem_DataContextChanged"
                                                            Height="{Binding $parent[ListBox].((vm:TabViewModel)DataContext).ListRowHeight}"
                                                            Opacity="{Binding RowOpacity}">
                                                    <CheckBox MinWidth="0" Padding="0" Margin="0,0,-4,0"
                                                              IsVisible="{Binding $parent[ListBox].((vm:TabViewModel)DataContext).ShowCheckBoxes}"
                                                              IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=TwoWay}" />
                                                    <c:FileIconPresenter VerticalAlignment="Center"
                                                                         Entry="{Binding}"
                                                                         Owner="{Binding $parent[ListBox].((vm:TabViewModel)DataContext)}" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 並べて表示（エクスプローラーの「並べて表示」）。
                                         実機を UI Automation とキャプチャで実測した値に合わせてある:
                                         タイル 250x55dip・左右の間隔 4・48px アイコン・行送り 16・
                                         左から右へ流して折り返す。アイコンサイズのスライダーには追従しない（本家も固定）。 -->
                                    <ListBox Classes="files tiles"
                                             IsVisible="{Binding IsTilesView}"
                                             ItemsSource="{Binding Entries}"
                                             SelectedItem="{Binding SelectedEntry}"
                                             SelectionMode="Multiple"
                                             Background="Transparent"
                                             Padding="8,6,0,0"
                                             DragDrop.AllowDrop="True"
                                             DoubleTapped="FileList_DoubleTapped"
                                             SelectionChanged="FileList_SelectionChanged"
                                             PointerReleased="FileList_PointerReleased"
                                             KeyDown="FileList_KeyDown"
                                             TextInput="FileList_TextInput">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:VirtualizingWrapPanel ItemWidth="254" ItemHeight="59" CacheRows="2" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:FileSystemEntry">
                                                <Grid ColumnDefinitions="Auto,*" Height="55"
                                                      Background="Transparent"
                                                      EffectiveViewportChanged="FileItem_EffectiveViewportChanged"
                                                      DataContextChanged="FileItem_DataContextChanged"
                                                      Opacity="{Binding RowOpacity}"
                                                      ToolTip.Tip="{Binding RowTooltip}">
                                                    <Panel Grid.Column="0" Width="48" Height="48"
                                                           Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <!-- 優先順位はアイコン表示と同じ: 実サムネイル > 選択中のアイコンセット -->
                                                        <Image Source="{Binding Thumbnail}"
                                                               IsVisible="{Binding HasThumbnail}"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                                               Stretch="Uniform" />
                                                        <Panel IsVisible="{Binding HasNoThumbnail}">
                                                            <c:FileIconPresenter Entry="{Binding}"
                                                                                 Owner="{Binding $parent[ListBox].((vm:TabViewModel)DataContext)}"
                                                                                 IconSize="48"
                                                                                 ScaleEmoji="True" />
                                                        </Panel>
                                                    </Panel>
                                                    <!-- 文字は 3 行ぶん（16x3=48）で頭打ち。名前が 2 行に折り返すと
                                                         サイズ行が枠外へ押し出されて消える = エクスプローラーと同じ挙動。
                                                         枠より短いとき（フォルダーの 1 行）は上下中央に来る。 -->
                                                    <Border Grid.Column="1" Height="48" Margin="2,0,0,0"
                                                            VerticalAlignment="Center" ClipToBounds="True">
                                                        <StackPanel MaxHeight="48" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12" LineHeight="16" MaxLines="2"
                                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}" />
                                                            <!-- 通常のフォルダーは名前だけ（実機で種類・サイズが出ないことを確認済み）。
                                                                 ドライブは 種類 の代わりに使用率ゲージが入り、
                                                                 サイズ行が「空き領域 180 GB/475 GB」になる。 -->
                                                            <TextBlock Text="{Binding TypeText}"
                                                                       FontSize="12" LineHeight="16"
                                                                       IsVisible="{Binding !IsDirectory}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                            <!-- ゲージは 1 行ぶん（16）の中央へ 13 の高さで置く。
                                                                 実測: バーは 12.8dip 高で、テキスト列の左端からタイル右端まで伸びる。 -->
                                                            <Panel Height="16" IsVisible="{Binding IsDrive}">
                                                                <ProgressBar Minimum="0" Maximum="100"
                                                                             Value="{Binding DriveUsedPercent}"
                                                                             MinWidth="0" Height="13"
                                                                             HorizontalAlignment="Stretch"
                                                                             VerticalAlignment="Center" />
                                                            </Panel>
                                                            <TextBlock Text="{Binding SizeText}"
                                                                       FontSize="12" LineHeight="16"
                                                                       IsVisible="{Binding HasSizeText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- アイコン表示（特大 / 大 / 中）。スライダー最大時はギャラリー表示に譲る -->
                                    <ListBox Classes="icons"
                                             ItemsSource="{Binding Entries}"
                                             SelectedItem="{Binding SelectedEntry}"
                                             SelectionMode="Multiple"
                                             Background="Transparent"
                                             DragDrop.AllowDrop="True"
                                             DoubleTapped="FileList_DoubleTapped"
                                             SelectionChanged="FileList_SelectionChanged"
                                             PointerReleased="FileList_PointerReleased"
                                             KeyDown="FileList_KeyDown"
                                             TextInput="FileList_TextInput">
                                        <!-- ギャラリーは独立した ViewMode になったので、IsIconsView だけで排他になる -->
                                        <ListBox.IsVisible>
                                            <Binding Path="IsIconsView" />
                                        </ListBox.IsVisible>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:VirtualizingWrapPanel ItemWidth="{Binding IconCellWidth}"
                                                                         ItemHeight="{Binding IconCellHeight}"
                                                                         AutoItemHeight="True" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:FileSystemEntry">
                                                <StackPanel Width="{Binding $parent[ListBox].((vm:TabViewModel)DataContext).IconItemWidth}"
                                                            EffectiveViewportChanged="FileItem_EffectiveViewportChanged"
                                                            DataContextChanged="FileItem_DataContextChanged"
                                                            Background="Transparent"
                                                            Opacity="{Binding RowOpacity}"
                                                            ToolTip.Tip="{Binding RowTooltip}">
                                                    <!-- 優先順位: 実サムネイル > 選択中のアイコンセット -->
                                                    <Image Source="{Binding Thumbnail}"
                                                           IsVisible="{Binding HasThumbnail}"
                                                           Height="{Binding $parent[ListBox].((vm:TabViewModel)DataContext).IconFontSize}"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                                           Stretch="Uniform" />
                                                    <Panel IsVisible="{Binding HasNoThumbnail}">
                                                        <c:FileIconPresenter Entry="{Binding}"
                                                                             Owner="{Binding $parent[ListBox].((vm:TabViewModel)DataContext)}"
                                                                             IconSize="{Binding $parent[ListBox].((vm:TabViewModel)DataContext).IconFontSize}"
                                                                             ScaleEmoji="True" />
                                                    </Panel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <!-- ギャラリー表示（ステータスバー / 表示メニューから選ぶ独立した表示モード）:
                                         1 枚を大きく表示し、下部フィルムストリップで送る。Esc / ✕ で直前の表示へ復帰。
                                         ストリップの高さは境界 Thumb で変更でき、全タブ共通で永続化する。 -->
                                    <Grid IsVisible="{Binding IsGalleryView}" RowDefinitions="*,Auto,Auto" Background="#FF121212">
                                        <!-- メイン画像。クリックでフォーカスを受け（Del / F2 等が効く）、
                                             右クリックで通常のファイルと同じ Windows シェルメニューを出す。 -->
                                        <!-- Background を敷かないと画像の外（レターボックス）がヒットテスト対象外になり、
                                             背景上ではホイール送り・クリック・右クリックが効かなくなる -->
                                        <Panel x:Name="GalleryImageArea" Grid.Row="0"
                                               Margin="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GalleryImageMargin}"
                                               Background="Transparent"
                                               Focusable="True"
                                               ClipToBounds="True"
                                               PointerPressed="GalleryImage_PointerPressed"
                                               PointerMoved="GalleryImage_PointerMoved"
                                               PointerReleased="GalleryImage_PointerReleased"
                                               PointerExited="GalleryImage_PointerExited"
                                               SizeChanged="GalleryImage_SizeChanged"
                                               KeyDown="GalleryImage_KeyDown">
                                            <!-- 拡大縮小は RenderTransform で掛ける。レイアウトを動かさないので
                                                 Stretch="Uniform" の「領域に収める」計算をそのまま活かせ、
                                                 拡大中も下のオーバーレイ（閉じるボタン）が動かない。
                                                 原点は左上に固定し、「領域の中心を動かさない」平行移動は
                                                 TabViewModel.ApplyGalleryTransform が計算して足す。 -->
                                            <Panel RenderTransform="{Binding GalleryImageTransform}"
                                                   RenderTransformOrigin="0,0">
                                                <!-- 鮮鋭化が有効なときは表示サイズちょうどのビットマップが来る。
                                                     そのときだけ描画先の論理サイズを明示し Stretch=Fill で 1:1 に描く
                                                     （TabViewModel.ApplyPreviewDisplaySize）。それ以外は Width/Height が
                                                     NaN＝自動になり、従来どおり Uniform で領域に収まる。 -->
                                                <Image Source="{Binding PreviewBitmap}"
                                                       Width="{Binding PreviewDisplayWidth}"
                                                       Height="{Binding PreviewDisplayHeight}"
                                                       Stretch="{Binding PreviewStretch}" StretchDirection="DownOnly"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                <!-- 動画のフレーム。VideoFrame は 2 枚のバッファを交互に差し替えて更新される。
                                                     鮮鋭化とガンマ補正は描画時の SkSL シェーダーが掛けるので、
                                                     Image ではなく専用コントロールで描く（CPU 負荷を GPU へ逃がす）。
                                                     静止画と違い拡大も許すので、領域いっぱいまで引き伸ばす。 -->
                                                <c:VideoFrameView Frame="{Binding VideoFrame}"
                                                                  Gamma="{Binding GalleryGamma}"
                                                                  Revision="{Binding VideoRenderRevision}"
                                                                  IsVisible="{Binding IsVideoPreview}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                            <!-- 画像プレビューも動画も無いファイルはアイコン + 名前で表示する -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                <StackPanel.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="!IsVideoPreview" />
                                                        <Binding Path="PreviewBitmap" Converter="{x:Static ObjectConverters.IsNull}" />
                                                    </MultiBinding>
                                                </StackPanel.IsVisible>
                                                <c:FileIconPresenter Entry="{Binding SelectedEntry}" Owner="{Binding}"
                                                                     IconSize="96" ScaleEmoji="True"
                                                                     HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SelectedEntry.DisplayName}" FontSize="14"
                                                           Foreground="#DDDDDD" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                            </StackPanel>
                                            <!-- 再生できなかった動画（コーデック未導入など）の案内 -->
                                            <Border IsVisible="{Binding IsVideoUnavailable}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="#99000000" CornerRadius="8" Padding="18,12">
                                                <TextBlock Text="{DynamicResource Text.Video.Unavailable}"
                                                           Foreground="#DDDDDD" FontSize="13"
                                                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                                            </Border>
                                            <!-- 前後の画像へ送る大きめのボタン。コントロールバーと同じく、
                                                 マウスを動かしている間だけ左右の端にフェード表示する
                                                 （ホイール・← → キー・フィルムストリップと同じ操作）。 -->
                                            <Button Classes="gallerynav"
                                                    Classes.shown="{Binding IsGalleryOverlayVisible}"
                                                    IsHitTestVisible="{Binding IsGalleryOverlayVisible}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Margin="14,0,0,0"
                                                    Click="GalleryPrev_Click"
                                                    AutomationProperties.Name="{DynamicResource Text.Gallery.Previous}"
                                                    ToolTip.Tip="{DynamicResource Text.Gallery.Previous}">
                                                <TextBlock Classes="fico" Text="&#xE76B;" FontSize="26" />
                                            </Button>
                                            <Button Classes="gallerynav"
                                                    Classes.shown="{Binding IsGalleryOverlayVisible}"
                                                    IsHitTestVisible="{Binding IsGalleryOverlayVisible}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,14,0"
                                                    Click="GalleryNext_Click"
                                                    AutomationProperties.Name="{DynamicResource Text.Gallery.Next}"
                                                    ToolTip.Tip="{DynamicResource Text.Gallery.Next}">
                                                <TextBlock Classes="fico" Text="&#xE76C;" FontSize="26" />
                                            </Button>
                                            <!-- ギャラリーの操作を 1 本に集約したコントロールバー。左に画像の操作
                                                 （回転・拡大縮小）、中央に動画の操作（再生・シーク・音量・速度）、
                                                 右端に全画面表示とギャラリー終了。メイン画像領域でマウスを動かして
                                                 いる間だけフェード表示するオーバーレイ（鑑賞中は画像だけが残る）。 -->
                                        <Border Classes="gallerybar"
                                                Classes.shown="{Binding IsGalleryOverlayVisible}"
                                                IsHitTestVisible="{Binding IsGalleryOverlayVisible}"
                                                VerticalAlignment="Bottom">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <!-- 回転。静止画は無劣化回転（Exif の向きだけを書き換えて即保存）、
                                                         動画は表示だけを回す（ファイルは書き換えない）。
                                                         アイコンは Material Icons の rotate_left / rotate_right
                                                         （Apache-2.0。Assets/MaterialIcons/NOTICE.md 参照）。 -->
                                                    <Button Classes="videobtn"
                                                            IsEnabled="{Binding CanRotateSelected}"
                                                            Command="{Binding RotateSelectedLeftCommand}"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.RotateLeft}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.RotateLeft}">
                                                        <Path Width="18" Height="18" Stretch="Uniform" Fill="#DDDDDD"
                                                              Data="M7.11 8.53L5.7 7.11C4.8 8.27 4.24 9.61 4.07 11h2.02c.14-.87.49-1.72 1.02-2.47zM6.09 13H4.07c.17 1.39.72 2.73 1.62 3.89l1.41-1.42c-.52-.75-.87-1.59-1.01-2.47zm1.01 5.32c1.16.9 2.51 1.44 3.9 1.61V17.9c-.87-.15-1.71-.49-2.46-1.03L7.1 18.32zM13 4.07V1L8.45 5.55 13 10V6.09c2.84.48 5 2.94 5 5.91s-2.16 5.43-5 5.91v2.02c3.95-.49 7-3.85 7-7.93s-3.05-7.44-7-7.93z" />
                                                    </Button>
                                                    <Button Classes="videobtn"
                                                            IsEnabled="{Binding CanRotateSelected}"
                                                            Command="{Binding RotateSelectedRightCommand}"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.RotateRight}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.RotateRight}">
                                                        <Path Width="18" Height="18" Stretch="Uniform" Fill="#DDDDDD"
                                                              Data="M15.55 5.55L11 1v3.07C7.06 4.56 4 7.92 4 12s3.05 7.44 7 7.93v-2.02c-2.84-.48-5-2.94-5-5.91s2.16-5.43 5-5.91V10l4.55-4.45zM19.93 11c-.17-1.39-.72-2.73-1.62-3.89l-1.42 1.42c.54.75.88 1.6 1.02 2.47h2.02zM13 17.9v2.02c1.39-.17 2.74-.71 3.9-1.61l-1.44-1.44c-.75.54-1.59.89-2.46 1.03zm3.89-2.42l1.42 1.41c.9-1.16 1.45-2.5 1.62-3.89h-2.02c-.14.87-.48 1.72-1.02 2.48z" />
                                                    </Button>

                                                    <Border Classes="gallerysep" />

                                                    <!-- 表示倍率。Ctrl+ホイールと同じ値を触る。 -->
                                                    <TextBlock Classes="fico videotime" Text="&#xE71F;" FontSize="13"
                                                               Margin="4,0,6,0" />
                                                    <Slider Classes="galleryzoom" Width="140" VerticalAlignment="Center"
                                                            Minimum="0.2" Maximum="8" SmallChange="0.1" LargeChange="0.5"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.Zoom}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.ZoomTip}"
                                                            Value="{Binding GalleryZoom, Mode=TwoWay}" />
                                                    <!-- 倍率の表示そのものを「押すと 100% に戻る」ボタンにする。
                                                         現在の倍率と 100% ボタンが並んでいると、どちらが現在値なのか
                                                         読み取れないため、1 つにまとめてある（等倍のときは押せない）。 -->
                                                    <Button Classes="videobtn" Width="58" Margin="4,0,0,0"
                                                            Command="{Binding ResetGalleryZoomCommand}"
                                                            IsEnabled="{Binding CanResetGalleryView}"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.ZoomReset}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.ZoomReset}">
                                                        <TextBlock Text="{Binding GalleryZoomText}" FontSize="12" />
                                                    </Button>

                                                    <Border Classes="gallerysep" />

                                                    <!-- ガンマ補正。暗い写真・動画の暗部を持ち上げる表示だけの調整で、
                                                         ファイルは書き換えない。静止画と動画のどちらにも効く。 -->
                                                    <TextBlock Classes="fico videotime" Text="&#xE706;" FontSize="13"
                                                               Margin="4,0,6,0" />
                                                    <Slider Classes="galleryzoom" Width="100" VerticalAlignment="Center"
                                                            Minimum="0.4" Maximum="2.5" SmallChange="0.05" LargeChange="0.2"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.Gamma}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.GammaTip}"
                                                            Value="{Binding GalleryGamma, Mode=TwoWay}" />
                                                    <!-- 倍率と同じく、現在値そのものを「押すと 1.00 に戻る」ボタンにする。 -->
                                                    <Button Classes="videobtn" Width="62" Margin="4,0,0,0"
                                                            Command="{Binding ResetGalleryGammaCommand}"
                                                            IsEnabled="{Binding CanResetGalleryGamma}"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.GammaReset}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.GammaReset}">
                                                        <TextBlock Text="{Binding GalleryGammaText}" FontSize="12" />
                                                    </Button>
                                                </StackPanel>

                                                <Grid Grid.Column="1" Margin="12,0,0,0"
                                                      IsVisible="{Binding IsVideoPreview}"
                                                      ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
                                                    <!-- 巻き戻し / 早送り。1 回あたりの秒数は設定 > 表示 で変えられる。 -->
                                                    <Button Grid.Column="0" Classes="videobtn"
                                                            Command="{Binding SeekVideoBackwardCommand}"
                                                            AutomationProperties.Name="{DynamicResource Text.Video.SeekBack}"
                                                            ToolTip.Tip="{DynamicResource Text.Video.SeekBack}">
                                                        <TextBlock Classes="fico" FontSize="14" Text="&#xE892;" />
                                                    </Button>
                                                    <Button Grid.Column="1" Classes="videobtn"
                                                            Command="{Binding ToggleVideoPlaybackCommand}"
                                                            ToolTip.Tip="{DynamicResource Text.Video.PlayPauseTip}">
                                                        <Panel>
                                                            <TextBlock Classes="fico" FontSize="15" Text="&#xE768;"
                                                                       IsVisible="{Binding !IsVideoPlaying}" />
                                                            <TextBlock Classes="fico" FontSize="15" Text="&#xE769;"
                                                                       IsVisible="{Binding IsVideoPlaying}" />
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="2" Classes="videobtn"
                                                            Command="{Binding SeekVideoForwardCommand}"
                                                            AutomationProperties.Name="{DynamicResource Text.Video.SeekForward}"
                                                            ToolTip.Tip="{DynamicResource Text.Video.SeekForward}">
                                                        <TextBlock Classes="fico" FontSize="14" Text="&#xE893;" />
                                                    </Button>
                                                    <TextBlock Grid.Column="3" Text="{Binding VideoPositionText}"
                                                               Classes="videotime" Margin="6,0,8,0" />
                                                    <Slider Grid.Column="4" Classes="videoseek" VerticalAlignment="Center"
                                                            Minimum="0" Maximum="{Binding VideoDurationSeconds}"
                                                            Value="{Binding VideoPositionSeconds, Mode=TwoWay}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding VideoDurationText}"
                                                               Classes="videotime" Margin="8,0,4,0" />
                                                    <Button Grid.Column="6" Classes="videobtn"
                                                            Command="{Binding ToggleVideoMuteCommand}"
                                                            ToolTip.Tip="{DynamicResource Text.Video.MuteTip}">
                                                        <Panel>
                                                            <TextBlock Classes="fico" FontSize="14" Text="&#xE767;"
                                                                       IsVisible="{Binding !IsVideoMuted}" />
                                                            <TextBlock Classes="fico" FontSize="14" Text="&#xE74F;"
                                                                       IsVisible="{Binding IsVideoMuted}" />
                                                        </Panel>
                                                    </Button>
                                                    <Slider Grid.Column="7" Classes="videovolume" VerticalAlignment="Center"
                                                            Width="82" Minimum="0" Maximum="1"
                                                            ToolTip.Tip="{DynamicResource Text.Video.VolumeTip}"
                                                            Value="{Binding VideoVolume, Mode=TwoWay}" />
                                                    <Button Grid.Column="8" Classes="videobtn"
                                                            Command="{Binding ToggleVideoLoopCommand}"
                                                            Classes.active="{Binding IsVideoLooping}"
                                                            ToolTip.Tip="{DynamicResource Text.Video.LoopTip}">
                                                        <TextBlock Classes="fico" FontSize="14" Text="&#xE8EE;" />
                                                    </Button>
                                                    <!-- 再生速度は候補から選ぶ（巡回ボタンだと目的の倍率まで押し続ける必要があった）。
                                                         選んだ倍率は音量・ミュートと同じく settings.json へ保存する。 -->
                                                    <ComboBox Grid.Column="9" Classes="videorate" Margin="8,0,0,0"
                                                              ItemsSource="{Binding VideoRateOptions}"
                                                              SelectedIndex="{Binding VideoRateIndex, Mode=TwoWay}"
                                                              AutomationProperties.Name="{DynamicResource Text.Video.RateTip}"
                                                              ToolTip.Tip="{DynamicResource Text.Video.RateTip}" />
                                                </Grid>

                                                <!-- 右端は表示そのものの操作（全画面・ギャラリー終了）。画像・動画を問わず出す。 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <!-- 全画面表示（Esc / F11 / もう一度押すで戻る） -->
                                                    <Button Classes="videobtn"
                                                            Click="GalleryFullScreen_Click"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.FullScreen}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.FullScreen}">
                                                        <Panel>
                                                            <TextBlock Classes="fico" FontSize="14" Text="&#xE740;"
                                                                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsGalleryChromeVisible}" />
                                                            <TextBlock Classes="fico" FontSize="14" Text="&#xE73F;"
                                                                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsGalleryFullScreen}" />
                                                        </Panel>
                                                    </Button>
                                                    <!-- ギャラリー終了（Esc / スライダーでも戻れる）。
                                                         画像へ重ねる独立ボタンは廃止し、他の操作と同じバーへ集約している。 -->
                                                    <Button Classes="videobtn galleryclose"
                                                            Click="GalleryClose_Click"
                                                            AutomationProperties.Name="{DynamicResource Text.Gallery.CloseTip}"
                                                            ToolTip.Tip="{DynamicResource Text.Gallery.CloseTip}">
                                                        <TextBlock Classes="fico" FontSize="13" Text="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        </Panel>

                                        <!-- ストリップとプレビューの境界。上下ドラッグでストリップの高さを変える。
                                             全画面表示中はストリップごと畳む（画像だけを見せる）。 -->
                                        <Thumb Grid.Row="1" Classes="rowsplit"
                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsGalleryChromeVisible}"
                                               DragDelta="GalleryStripThumb_DragDelta" />
                                        <ListBox Grid.Row="2" Classes="files gallerystrip"
                                                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsGalleryChromeVisible}"
                                                 Height="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GalleryStripHeight}"
                                                 ItemsSource="{Binding Entries}"
                                                 SelectedItem="{Binding SelectedEntry}"
                                                 SelectionMode="Multiple"
                                                 Background="Transparent"
                                                 DragDrop.AllowDrop="True"
                                                 DoubleTapped="FileList_DoubleTapped"
                                                 SelectionChanged="FileList_SelectionChanged"
                                                 PointerReleased="FileList_PointerReleased"
                                                 KeyDown="FileList_KeyDown"
                                             TextInput="FileList_TextInput"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="m:FileSystemEntry">
                                                    <Panel Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GalleryThumbSize}"
                                                           Height="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GalleryThumbSize}"
                                                           EffectiveViewportChanged="FileItem_EffectiveViewportChanged"
                                                           DataContextChanged="FileItem_DataContextChanged"
                                                           Background="Transparent"
                                                           Opacity="{Binding RowOpacity}"
                                                           ToolTip.Tip="{Binding RowTooltip}">
                                                        <!-- 角は丸めない（フィルムストリップは写真の縁をそのまま見せる） -->
                                                        <Border CornerRadius="0" ClipToBounds="True" IsVisible="{Binding HasThumbnail}">
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                        </Border>
                                                        <c:FileIconPresenter IsVisible="{Binding HasNoThumbnail}"
                                                                             Entry="{Binding}"
                                                                             Owner="{Binding $parent[ListBox].((vm:TabViewModel)DataContext)}"
                                                                             IconSize="42" ScaleEmoji="True"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Panel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <!-- 空フォルダー表示 -->
                                    <TextBlock Text="{DynamicResource Text.FileList.EmptyFolder}"
                                               IsVisible="{Binding HasNoEntries}"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="13"
                                               HorizontalAlignment="Center" Margin="0,60,0,0" />
                                </Panel>
                            </Grid>

                            <!-- プレビューペイン幅の変更 -->
                            <Thumb Grid.Column="3" Classes="colsplit" Width="4"
                                   DragDelta="PreviewThumb_DragDelta">
                                <Thumb.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).ShowPreviewPane" />
                                        <Binding Path="!IsGalleryView" />
                                    </MultiBinding>
                                </Thumb.IsVisible>
                            </Thumb>

                            <!-- プレビューペイン (Alt+P) -->
                            <!-- 左の仕切り線は隣の Thumb (colsplit) が描くため Border 側には引かない -->
                            <Border Grid.Column="4"
                                    Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PreviewWidth}"
                                    Background="{DynamicResource SidebarBg}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).ShowPreviewPane" />
                                        <Binding Path="!IsGalleryView" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <Grid RowDefinitions="*,Auto" Margin="10">
                                    <Panel Grid.Row="0">
                                        <Image Source="{Binding PreviewBitmap}"
                                               Stretch="Uniform" StretchDirection="DownOnly"
                                               VerticalAlignment="Top" />
                                        <ScrollViewer IsVisible="{Binding PreviewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                      Background="{DynamicResource ContentBg}">
                                            <TextBlock Text="{Binding PreviewText}" FontSize="11"
                                                       FontFamily="Cascadia Mono,Consolas,MS Gothic"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="NoWrap" Margin="8" />
                                        </ScrollViewer>
                                    </Panel>
                                    <TextBlock Grid.Row="1" Text="{Binding PreviewInfo}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ステータスバー（左: パンくず / 右: 項目数 | 選択情報 | 空き領域） -->
                        <Border Grid.Row="3" Height="28" Background="{DynamicResource StatusBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                            <!-- ギャラリーの全画面表示中は畳む（画像だけを見せる） -->
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).ShowStatusBar" />
                                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).IsGalleryChromeVisible" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <Grid ColumnDefinitions="*,Auto" Margin="14,0">
                                <!-- パンくずリスト（エクスプローラーのアドレスバー仕様）。
                                     幅が足りないときは BreadcrumbPanel が先頭側（浅い階層）から畳み、
                                     左端の「…」ボタンで畳んだぶんを開けるようにする。
                                     現在フォルダー（末尾）は常に押せる位置に残り、
                                     シェブロンでサブフォルダーのドロップダウンを開ける。 -->
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*"
                                      VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid.Styles>
                                        <!-- 高さ 28 のバーに収めるため、アドレスバー時代より一回り小さく -->
                                        <Style Selector="Button.crumb">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Padding" Value="5,1" />
                                        </Style>
                                    </Grid.Styles>
                                    <Button Grid.Column="0" Classes="crumb" Padding="4,1"
                                            IsVisible="{Binding #BreadcrumbItems.(c:BreadcrumbPanel.HasOverflow)}"
                                            Click="BreadcrumbOverflow_Click"
                                            ToolTip.Tip="{DynamicResource Text.Nav.CrumbOverflow}"
                                            AutomationProperties.Name="{DynamicResource Text.Nav.CrumbOverflow}">
                                        <TextBlock Classes="fico" Text="&#xE712;" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <ItemsControl x:Name="BreadcrumbItems" Grid.Column="1"
                                                  ItemsSource="{Binding Breadcrumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:BreadcrumbPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:BreadcrumbSegment">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- 1 つの名前が長すぎるフォルダーでも隣を押し出さないよう、
                                                         上限を決めて省略表示にする（全体はツールチップで読める）。 -->
                                                    <Button Classes="crumb"
                                                            Command="{Binding $parent[ItemsControl].((vm:TabViewModel)DataContext).NavigateToPathCommand}"
                                                            CommandParameter="{Binding Path}"
                                                            ToolTip.Tip="{Binding Path}"
                                                            PointerReleased="Crumb_PointerReleased">
                                                        <TextBlock Text="{Binding Name}" MaxWidth="220"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Button>
                                                    <!-- シェブロンクリックでサブフォルダーのドロップダウン（エクスプローラーと同じ） -->
                                                    <Button Classes="crumb" Padding="2,1" Click="CrumbChevron_Click"
                                                            AutomationProperties.Name="{DynamicResource Text.A11y.OpenSubfolders}">
                                                        <TextBlock Classes="fico" Text="&#xE76C;" FontSize="9"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <Border Width="1" Height="14" Background="{DynamicResource StatusDivider}" VerticalAlignment="Center"
                                            IsVisible="{Binding SelectionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding SelectionText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <!-- 選択が 1 件のときだけ更新日時（サイズは選択情報に含まれる） -->
                                    <Border Width="1" Height="14" Background="{DynamicResource StatusDivider}" VerticalAlignment="Center"
                                            IsVisible="{Binding SelectionModifiedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding SelectionModifiedText}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    <!-- Finder 風のアイコンサイズスライダー（アイコン表示時のみ） -->
                                    <!-- Focusable=False: フォーカスが入ると左右キーが IconSize を動かしてしまい、
                                         一覧の選択移動を奪うため。
                                         上下中央への配置は statuszoom クラス（MainWindowStyles.axaml）で行う。 -->
                                    <Slider Classes="statuszoom" Width="110" Minimum="24" Maximum="160"
                                            Value="{Binding IconSize}"
                                            IsVisible="{Binding IsIconsView}"
                                            Focusable="False"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{DynamicResource Text.Status.IconSizeTip}" />
                                    <!-- エクスプローラー右下と同じ表示切替ボタン -->
                                    <Button Classes="cmd cmdicon" Width="26" Height="22" FontSize="12"
                                            Content="&#xE8FD;" ToolTip.Tip="{DynamicResource Text.Status.DetailsViewTip}" AutomationProperties.Name="{DynamicResource Text.Status.DetailsViewTip}"
                                            Command="{Binding SetViewModeCommand}" CommandParameter="Details" />
                                    <Button Classes="cmd cmdicon" Width="26" Height="22" FontSize="12"
                                            Content="&#xE8A9;" ToolTip.Tip="{DynamicResource Text.Status.LargeIconsTip}" AutomationProperties.Name="{DynamicResource Text.Status.LargeIconsTip}"
                                            Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons" />
                                    <!-- ギャラリー表示。以前はサイズスライダー最大で入る隠し動作だったので、
                                         ここに出して「表示モードのひとつ」だと分かるようにする -->
                                    <Button Classes="cmd cmdicon" Width="26" Height="22" FontSize="12"
                                            Content="&#xE91B;" ToolTip.Tip="{DynamicResource Text.Status.GalleryViewTip}" AutomationProperties.Name="{DynamicResource Text.Status.GalleryViewTip}"
                                            IsEnabled="{Binding CanChangeViewMode}"
                                            Command="{Binding SetViewModeCommand}" CommandParameter="Gallery" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    </Panel>
                    </Border>

                    <!-- 枠線はクリップの外側（兄弟要素）で描く。上の Border に BorderThickness を
                         持たせると、同じ角丸ジオメトリのクリップが 1px の線をちょうど削り取ってしまい、
                         四隅の弧だけ線が消えて見える（直線部分は残るので「角だけ切れている」ように見える）。 -->
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            CornerRadius="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ContentIslandCornerRadius}"
                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsContentIslandOutlineVisible}"
                            IsHitTestVisible="False" />
                    </Panel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ファイル一覧の空白部分をドラッグしたときの範囲選択。実体の選択は表示中ListBoxへ反映する。 -->
        <Canvas x:Name="FileSelectionOverlay" Grid.Row="1" Grid.Column="1" Margin="6"
                IsHitTestVisible="False" ClipToBounds="True" ZIndex="800">
            <Border x:Name="FileSelectionRectangle" IsVisible="False"
                    Background="{DynamicResource AccentSelectionBrush}"
                    BorderBrush="{DynamicResource SystemAccentColor}"
                    BorderThickness="1" CornerRadius="2" />
        </Canvas>

    </Grid>

    <!-- 切り取り / コピー / パス・リンクのコピーの結果を知らせる一時通知トースト
         （ドラッグ中プレビューと同じ視覚言語で、アドレスバー直下に出す）。 -->
    <Border x:Name="ActionToast" IsVisible="False" Opacity="0" ZIndex="900"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0"
            Padding="11,8" CornerRadius="13"
            Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="2"
            BoxShadow="0 9 24 0 #62000000" IsHitTestVisible="False">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Border.Transitions>
        <StackPanel Orientation="Horizontal" Spacing="9">
            <Border MinWidth="52" Padding="8,4" CornerRadius="9"
                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="ActionToastLabel" Text="{DynamicResource Text.Common.Copy}"
                           FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" />
            </Border>
            <TextBlock x:Name="ActionToastText" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                       MaxWidth="520" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>

    <!-- 試用期間終了ロック: 認証が完了するまで半透明の暗幕で操作をブロックするモーダル（買い切り一律の建付け）。 -->
    <Border ZIndex="1000" IsVisible="{Binding IsLicenseLocked}"
            Background="#A6000000">
        <!-- カード背景は不透明の DialogWindowBrush を使う。TabStripBg はアクリル有効時に
             ThemeService が Colors.Transparent へ上書きするため、カードが透けてしまう。 -->
        <Border MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="32,28" CornerRadius="16"
                Background="{DynamicResource DialogWindowBrush}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                BoxShadow="0 12 40 0 #55000000">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Image Width="44" Height="44" Source="avares://Kiriha/icon/app_icon.png"
                           RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LicenseLockTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding LicenseLockDescription}"
                                   Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource Text.License.RecoverNote}" />
                <!-- 設定タブと同じ導線（メールアドレス + 6 桁コード）。片方だけ直すと
                     ロック中の利用者がキーを持っていないと詰むので、両方を揃えて保つ。 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="280" PlaceholderText="{DynamicResource Text.License.EmailPlaceholder}"
                             Text="{Binding LicenseEmailInput}" />
                    <Button Classes="cmd" Content="{DynamicResource Text.License.SendCode}"
                            Command="{Binding SendLicenseCodeCommand}"
                            IsEnabled="{Binding !IsLicenseBusy}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLicenseCodeSent}">
                    <TextBox Width="150" MaxLength="6"
                             PlaceholderText="{DynamicResource Text.License.CodePlaceholder}"
                             Text="{Binding LicenseCodeInput}" />
                    <Button Classes="cmd" Content="{DynamicResource Text.License.Activate}"
                            Command="{Binding RedeemLicenseCodeCommand}"
                            IsEnabled="{Binding !IsLicenseBusy}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                    <Button Classes="cmd" Content="{DynamicResource Text.License.ResendCode}"
                            Command="{Binding SendLicenseCodeCommand}"
                            IsEnabled="{Binding !IsLicenseBusy}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                </StackPanel>
                <Button Classes="cmd" Content="{DynamicResource Text.License.KeyFallback}"
                        Command="{Binding ToggleLicenseKeyEntryCommand}"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding IsLicenseKeyEntryVisible}">
                    <TextBox Width="330" PlaceholderText="{DynamicResource Text.License.KeyPlaceholder}"
                             Text="{Binding LicenseKeyInput}" />
                    <Button Classes="cmd" Content="{DynamicResource Text.License.Activate}"
                            Command="{Binding ActivateLicenseCommand}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                </StackPanel>
                <Button Classes="cmd" Content="{DynamicResource Text.License.Recheck}"
                        IsVisible="{Binding IsOnlineCheckRequired}"
                        Command="{Binding RecheckLicenseCommand}"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"
                           IsVisible="{Binding LicenseMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding LicenseMessage}" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="cmd" Content="{DynamicResource Text.License.OpenPurchase}"
                            Command="{Binding OpenLicensePurchasePageCommand}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                    <Button Grid.Column="2" Classes="cmd" Content="{DynamicResource Text.License.Exit}" Click="Close_Click"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</Window>

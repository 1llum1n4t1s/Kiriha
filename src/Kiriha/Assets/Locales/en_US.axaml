  <x:String x:Key="Text.Settings.About" xml:space="preserve">About Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha brings the file operations of Windows Explorer together with Chrome's tabs, address bar and bookmarks in a single window. Settings are saved for the current user.</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">Use the acrylic effect (translucent blur) for the window</x:String>
  <x:String x:Key="Text.Settings.ContextMenu" xml:space="preserve">Context menu</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Modern" xml:space="preserve">Kiriha's own (Windows 11 style)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Note" xml:space="preserve">The Windows 11 style menu lists only curated entries and shell extensions; submenus such as Send to stay under "Show more options". Switch to another mode if an extension does not appear correctly.</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Shell" xml:space="preserve">Kiriha's own (shell items as-is)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.System" xml:space="preserve">Windows default</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">Make Kiriha the default app for opening folders and drives</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">When enabled, Kiriha starts whenever a folder or drive is opened from File Explorer.</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">Folders and drives currently open in Kiriha. Turning this off restores the previous behavior.</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">Default folder view</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">View</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">Folders with no saved view open with these settings. Changing the view or sorting inside a folder saves it for that folder only.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">Reset per-folder view settings</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">Per-folder view settings were deleted.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">Deletes the view, sorting and column widths remembered for every folder and returns them to the defaults above.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">Sort by</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">Appearance</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">Adjust how the file list looks and how Kiriha is styled</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">File list</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">Add "Open with Kiriha" to the File Explorer context menu</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">Lets you open a folder in Kiriha by right-clicking the folder or the background inside it.</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">Folder tree</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">Gallery</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">The Material Icon Theme uses material-icon-theme (MIT License, © Material Extensions). The Windows set shows the same shell icons as File Explorer.</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Kiriha original icons</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Windows shell icons</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">Icons</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Display language</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">By default the language is detected from your Windows display language.</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">License</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">Maintenance</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">Data and cache</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">Open log folder</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">Reload Quick access</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">Reset settings</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">Manage the cache, logs and settings data</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Minimize to the notification area</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">When minimized, Kiriha disappears from the taskbar and can be restored from its notification area icon.</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">Mouse</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">When double-clicking the folder background</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">When middle-clicking the folder background</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">Close the tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">Do nothing</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">Pin the tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">Refresh</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">When double-clicking a tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">When middle-clicking a tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">Go up one level</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Run Kiriha when Windows starts</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">Kiriha starts automatically when you sign in.</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">Open images in Kiriha itself</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">Applies only to double-clicks inside Kiriha, which open the file full screen in gallery view (camera RAW files count as images). Windows file associations are left alone.</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">Open videos in Kiriha itself</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">Reduce blur when scaled up (sharpening)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">Strong</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">Light</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">Maximum (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">Standard</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">Gently firms up edges when an image or video is scaled up to fit the screen (equivalent to AMD FidelityFX RCAS). Video is processed on the GPU while drawing, so playback costs almost no extra CPU.</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">Shortcuts</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">File operations</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　Cut, copy, paste　　Delete / Shift+Delete　Delete, delete permanently&#10;F2　Rename　　Alt+Enter　Properties　　Ctrl+Shift+N　New folder　　Alt+P　Preview</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">Navigation and view</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　Edit address&#10;Ctrl+F / F3　Search&#10;Alt+← / →　Back and forward&#10;Alt+↑　Up one level&#10;F5　Refresh / F11　Full screen</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">Keyboard shortcuts for working faster</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">Tabs</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　New tab&#10;Ctrl+W　Close tab&#10;Ctrl+Shift+T　Reopen closed tab&#10;Ctrl+Tab　Switch tabs&#10;Ctrl+1..9　Select a specific tab</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">Show item check boxes</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">Show file name extensions</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">Show hidden files</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">Start minimized to the notification area</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha starts without showing its window, minimized to the notification area.</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">Startup</x:String>
  <x:String x:Key="Text.Settings.Startup.Behavior" xml:space="preserve">Startup behavior</x:String>
  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">Folder to open in new tabs (leave blank for your user folder)</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">Restore the tabs that were open when Kiriha was closed</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">Manage startup, Windows integration and the notification area</x:String>

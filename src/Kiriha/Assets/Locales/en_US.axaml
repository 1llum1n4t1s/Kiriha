  <x:String x:Key="Text.License.KeyPlaceholder" xml:space="preserve">License key starting with KIRIHA-</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckBody" xml:space="preserve">The license has not been verified online for more than 30 days. Connect to the internet and press "Verify again".</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckTitle" xml:space="preserve">The license needs to be verified online</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredBody" xml:space="preserve">Using Kiriha requires an activated license (¥1,980, one-time purchase).</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredTitle" xml:space="preserve">Your trial period has ended</x:String>
  <x:String x:Key="Text.License.Msg.Activated" xml:space="preserve">Your license has been activated 🎉 Thank you!</x:String>
  <x:String x:Key="Text.License.Msg.CheckOk" xml:space="preserve">Verification complete. Thank you for using Kiriha!</x:String>
  <x:String x:Key="Text.License.Msg.Checking" xml:space="preserve">Verifying online…</x:String>
  <x:String x:Key="Text.License.Msg.CodeSent" xml:space="preserve">We sent a confirmation code by email. Enter the 6 digits you received.</x:String>
  <x:String x:Key="Text.License.Msg.CodeTooSoon" xml:space="preserve">Too many requests. Please wait about 30 seconds and try again.</x:String>
  <x:String x:Key="Text.License.Msg.Deactivated" xml:space="preserve">This computer has been deactivated. You can activate again anytime with the same email address.</x:String>
  <x:String x:Key="Text.License.Msg.EnterCode" xml:space="preserve">Enter the 6-digit code from the email.</x:String>
  <x:String x:Key="Text.License.Msg.EnterEmail" xml:space="preserve">Enter the email address you used at purchase.</x:String>
  <x:String x:Key="Text.License.Msg.EnterKey" xml:space="preserve">Enter the license key issued when you purchased.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidCode" xml:space="preserve">That code is incorrect or has expired. Please send a new code.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidKey" xml:space="preserve">That license key is not valid. Check that nothing was cut off or that no extra spaces were copied.</x:String>
  <x:String x:Key="Text.License.Msg.NoPurchase" xml:space="preserve">No purchase was found for this email address. Please check the address you used at purchase.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseFailed" xml:space="preserve">Could not open the purchase page. Please try again later.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseOpened" xml:space="preserve">The purchase page is open in your browser. Once you're done, activate using the email field above.</x:String>
  <x:String x:Key="Text.License.Msg.Revoked" xml:space="preserve">This license is no longer valid (for example, it was refunded). Please purchase again.</x:String>

  <x:String x:Key="Text.License.Activate" xml:space="preserve">Activate</x:String>
  <x:String x:Key="Text.License.CodePlaceholder" xml:space="preserve">6-digit code</x:String>
  <x:String x:Key="Text.License.Deactivate" xml:space="preserve">Deactivate this computer</x:String>
  <x:String x:Key="Text.License.DeactivateNote" xml:space="preserve">Deactivates only this computer. Your purchase stays valid, so you can activate again anytime with the same email address. The trial period is not extended.</x:String>

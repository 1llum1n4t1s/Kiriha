  <x:String x:Key="Text.RecycleBin.Empty" xml:space="preserve">清空回收站</x:String>
  <x:String x:Key="Text.Rename.AlreadyExists" xml:space="preserve">已存在同名的文件或文件夹: {0}</x:String>
  <x:String x:Key="Text.Rename.InvalidChars" xml:space="preserve">文件名包含无效字符: \ / : * ? " &lt; &gt; |</x:String>
  <x:String x:Key="Text.Rename.RevertedToOriginal" xml:space="preserve">重命名失败，已恢复原名称</x:String>
  <x:String x:Key="Text.Rename.StuckAsTemporary" xml:space="preserve">重命名失败，仍保留临时名称: {0}</x:String>
  <x:String x:Key="Text.Search.ClearTip" xml:space="preserve">清除搜索</x:String>
  <x:String x:Key="Text.Search.Failed" xml:space="preserve">搜索失败: {0}</x:String>
  <x:String x:Key="Text.Search.Found" xml:space="preserve">找到 {0} 项结果（含子文件夹）</x:String>
  <x:String x:Key="Text.Search.Placeholder" xml:space="preserve">搜索 {0}</x:String>
  <x:String x:Key="Text.Search.Searching" xml:space="preserve">正在搜索...（含子文件夹）</x:String>
  <x:String x:Key="Text.Search.Truncated" xml:space="preserve">已在 {0} 项处停止（达到 1000 项上限，部分子文件夹未扫描；缩小搜索范围可查看更多）</x:String>
  <x:String x:Key="Text.Select.All" xml:space="preserve">全选</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">仅选择文件</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">仅选择文件夹</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">反向选择</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">取消选择</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">关于 Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha 将 Windows 资源管理器的文件操作与 Chrome 的标签页、地址栏和书签整合到一个窗口中。设置保存在当前用户下。</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">窗口使用亚克力效果（半透明模糊）</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">将 Kiriha 设为打开文件夹和驱动器的默认应用</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">启用后，从资源管理器打开文件夹或驱动器时会启动 Kiriha。</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">当前文件夹和驱动器会在 Kiriha 中打开。关闭后将恢复之前的行为。</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">文件夹默认视图</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">查看方式</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">尚未保存视图的文件夹将使用此设置打开。在某个文件夹中更改查看方式或排序时，仅会为该文件夹单独记住。</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">重置每个文件夹的视图设置</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">已删除每个文件夹的视图设置。</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">删除各文件夹记住的查看方式、排序和列宽，并恢复为上面的默认设置。</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">排序方式</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">外观</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">调整文件列表的外观和 Kiriha 的样式</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">文件列表</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">在资源管理器右键菜单中添加“用 Kiriha 打开”</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">右键点击文件夹或其内容的空白处，即可用 Kiriha 打开该文件夹。</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">文件夹树</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">画廊</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Material Icon Theme 使用 material-icon-theme（MIT 许可证，© Material Extensions）。Windows 图标集显示与资源管理器相同的 Shell 图标。</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Kiriha 原创图标</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Windows Shell 图标</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">图标</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">显示语言</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">默认情况下会根据 Windows 的显示语言自动选择。</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">许可证</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">维护</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">数据与缓存</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">打开日志文件夹</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">重新加载快速访问</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">重置设置</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">管理缓存、日志和设置数据</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">最小化到通知区域</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">最小化后 Kiriha 会从任务栏消失，可通过通知区域的图标恢复。</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">鼠标</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">双击文件夹空白处时</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">在文件夹空白处点击滚轮时</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">关闭标签页</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">不执行任何操作</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">固定标签页</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">刷新</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">双击标签页时</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">在标签页上点击滚轮时</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">向上一级</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">开机时启动 Kiriha</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">登录时会自动启动 Kiriha。</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">在 Kiriha 内用 Kiriha 打开图片</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">仅对在 Kiriha 内双击时生效，会以画廊模式全屏打开（各厂商的 RAW 也按图片处理）。不会修改 Windows 的文件关联。</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">在 Kiriha 内用 Kiriha 打开视频</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">减少放大时的模糊（锐化）</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">强</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">弱</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">最强 (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">标准</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">把图片和视频放大到屏幕大小时，只对轮廓做适度锐化（相当于 AMD FidelityFX RCAS）。视频在绘制时交给 GPU 处理，播放几乎不会增加 CPU 负担。</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">快捷键</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">文件操作</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　剪切、复制、粘贴　　Delete / Shift+Delete　删除、永久删除&#10;F2　重命名　　Alt+Enter　属性　　Ctrl+Shift+N　新建文件夹　　Alt+P　预览</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">导航与视图</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　编辑地址&#10;Ctrl+F / F3　搜索&#10;Alt+← / →　后退与前进&#10;Alt+↑　向上一级&#10;F5　刷新 / F11　全屏</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">帮助你更快操作的键盘快捷键一览</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">标签页</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　新建标签页&#10;Ctrl+W　关闭标签页&#10;Ctrl+Shift+T　重新打开已关闭的标签页&#10;Ctrl+Tab　切换标签页&#10;Ctrl+1..9　选择指定标签页</x:String>
  <x:String x:Key="Text.Settings.ShowBookmarksBar" xml:space="preserve">显示书签栏 (Ctrl+Shift+B)</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">显示项目复选框</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">显示文件扩展名</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">显示隐藏文件</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">启动时最小化到通知区域</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha 启动时不显示窗口，直接最小化到通知区域。</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">启动</x:String>
  <x:String x:Key="Text.Settings.Startup.Behavior" xml:space="preserve">启动行为</x:String>
  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">新标签页打开的文件夹（留空则为用户文件夹）</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">下次启动时恢复上次关闭时打开的标签页</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">管理启动方式、Windows 集成和通知区域</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">主题</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">深色</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">浅色</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">跟随系统</x:String>
  <x:String x:Key="Text.Settings.Tray" xml:space="preserve">通知区域</x:String>
  <x:String x:Key="Text.Settings.TreeDragDisabled" xml:space="preserve">禁止从文件夹树拖动</x:String>
  <x:String x:Key="Text.Settings.TreeDropDisabled" xml:space="preserve">禁止拖放到文件夹树</x:String>
  <x:String x:Key="Text.Settings.Updates" xml:space="preserve">更新与信息</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckNow" xml:space="preserve">立即检查更新</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckOnStartup" xml:space="preserve">启动时检查更新</x:String>
  <x:String x:Key="Text.Settings.Updates.Subtitle" xml:space="preserve">查看 Kiriha 的版本并管理更新</x:String>
  <x:String x:Key="Text.Settings.Updates.VersionCard" xml:space="preserve">版本与更新</x:String>
  <x:String x:Key="Text.Settings.Window" xml:space="preserve">窗口</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBounds" xml:space="preserve">记住窗口大小和位置</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBoundsNote" xml:space="preserve">关闭后，下次将以默认大小和位置启动。</x:String>
  <x:String x:Key="Text.Settings.WindowsIntegration" xml:space="preserve">Windows 集成</x:String>
  <x:String x:Key="Text.Settings.VideoSeekSeconds" xml:space="preserve">视频快进快退的秒数</x:String>
  <x:String x:Key="Text.Share.FileCount" xml:space="preserve">{0} 个文件</x:String>
  <x:String x:Key="Text.Share.FoldersNotSupported" xml:space="preserve">无法共享文件夹（请选择文件）</x:String>
  <x:String x:Key="Text.Share.NoItems" xml:space="preserve">没有可共享的项目</x:String>
  <x:String x:Key="Text.Share.OpenFailed" xml:space="preserve">无法打开共享面板</x:String>
  <x:String x:Key="Text.Share.PrepareFailed" xml:space="preserve">无法准备要共享的数据</x:String>
  <x:String x:Key="Text.Share.SelectFiles" xml:space="preserve">请选择要共享的文件</x:String>
  <x:String x:Key="Text.Sidebar.Drives" xml:space="preserve">驱动器</x:String>
  <x:String x:Key="Text.Sidebar.QuickAccess" xml:space="preserve">快速访问</x:String>
  <x:String x:Key="Text.Sidebar.RecentFiles" xml:space="preserve">最近使用的文件</x:String>
  <x:String x:Key="Text.Sidebar.RecycleBin" xml:space="preserve">回收站</x:String>
  <x:String x:Key="Text.Sidebar.RecycleBinTip" xml:space="preserve">在文件资源管理器中打开回收站</x:String>
  <x:String x:Key="Text.Sidebar.ToggleTip" xml:space="preserve">在快速访问和文件夹树之间切换</x:String>
  <x:String x:Key="Text.Sidebar.TreeView" xml:space="preserve">树状视图</x:String>
  <x:String x:Key="Text.Sort.Ascending" xml:space="preserve">升序</x:String>
  <x:String x:Key="Text.Sort.Descending" xml:space="preserve">降序</x:String>

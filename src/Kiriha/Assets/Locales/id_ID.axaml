  <x:String x:Key="Text.Settings.TreeDropDisabled" xml:space="preserve">Larang jatuhkan ke pohon folder</x:String>
  <x:String x:Key="Text.Settings.Updates" xml:space="preserve">Pembaruan dan info</x:String>

  <x:String x:Key="Text.Preview.OrMore" xml:space="preserve"> atau lebih</x:String>
  <x:String x:Key="Text.RecycleBin.Empty" xml:space="preserve">Kosongkan Recycle Bin</x:String>
  <x:String x:Key="Text.Rename.AlreadyExists" xml:space="preserve">Berkas atau folder dengan nama itu sudah ada: {0}</x:String>
  <x:String x:Key="Text.Rename.InvalidChars" xml:space="preserve">Nama berkas mengandung karakter yang tidak valid: \ / : * ? " &lt; &gt; |</x:String>
  <x:String x:Key="Text.Rename.RevertedToOriginal" xml:space="preserve">Penggantian nama gagal, jadi nama asli dipulihkan</x:String>
  <x:String x:Key="Text.Rename.StuckAsTemporary" xml:space="preserve">Penggantian nama gagal dan nama sementara masih tersisa: {0}</x:String>
  <x:String x:Key="Text.Search.ClearTip" xml:space="preserve">Bersihkan pencarian</x:String>
  <x:String x:Key="Text.Search.Failed" xml:space="preserve">Pencarian gagal: {0}</x:String>
  <x:String x:Key="Text.Search.Found" xml:space="preserve">{0} hasil ditemukan (termasuk subfolder)</x:String>
  <x:String x:Key="Text.Search.Placeholder" xml:space="preserve">Cari di {0}</x:String>
  <x:String x:Key="Text.Search.Searching" xml:space="preserve">Mencari... (termasuk subfolder)</x:String>
  <x:String x:Key="Text.Search.Truncated" xml:space="preserve">Dihentikan pada {0} hasil (batas 1000 tercapai dan sebagian subfolder belum ditelusuri; persempit pencarian untuk melihat lebih banyak)</x:String>
  <x:String x:Key="Text.Select.All" xml:space="preserve">Pilih semua</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">Pilih berkas saja</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">Pilih folder saja</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">Balik pilihan</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">Batalkan pilihan</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">Tentang Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha menyatukan pengelolaan berkas ala Windows Explorer dengan tab, bilah alamat, dan markah ala Chrome dalam satu jendela. Pengaturan disimpan untuk pengguna saat ini.</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">Gunakan efek akrilik (buram tembus pandang) pada jendela</x:String>
  <x:String x:Key="Text.Settings.ContextMenu" xml:space="preserve">Menu konteks</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Modern" xml:space="preserve">Milik Kiriha (gaya Windows 11)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Note" xml:space="preserve">Menu bergaya Windows 11 hanya menampilkan item pilihan dan ekstensi shell; submenu seperti "Kirim ke" tetap berada di "Tampilkan opsi lainnya". Ganti mode jika ada ekstensi yang tidak muncul dengan benar.</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Shell" xml:space="preserve">Milik Kiriha (item shell apa adanya)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.System" xml:space="preserve">Bawaan Windows</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">Jadikan Kiriha aplikasi bawaan untuk membuka folder dan drive</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">Jika diaktifkan, Kiriha berjalan setiap kali folder atau drive dibuka dari File Explorer.</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">Saat ini folder dan drive dibuka di Kiriha. Menonaktifkannya akan memulihkan perilaku sebelumnya.</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">Tampilan folder bawaan</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">Tampilan</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">Folder yang belum menyimpan tampilan akan dibuka dengan pengaturan ini. Mengubah tampilan atau urutan di dalam folder hanya disimpan untuk folder itu.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">Setel ulang tampilan tiap folder</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">Pengaturan tampilan tiap folder telah dihapus.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">Menghapus tampilan, urutan, dan lebar kolom yang diingat pada setiap folder, lalu kembali ke pengaturan bawaan di atas.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">Urutkan menurut</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">Tampilan</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">Atur tampilan daftar berkas dan gaya Kiriha</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">Daftar berkas</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">Tambahkan “Buka dengan Kiriha” ke menu konteks File Explorer</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">Memungkinkan membuka folder di Kiriha dengan klik kanan pada folder atau pada latar isinya.</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">Pohon folder</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">Galeri</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Material Icon Theme memakai material-icon-theme (Lisensi MIT, © Material Extensions). Set Windows menampilkan ikon shell yang sama dengan File Explorer.</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Ikon asli Kiriha</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Ikon shell Windows</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">Ikon</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Bahasa tampilan</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">Secara bawaan, bahasa dideteksi dari bahasa tampilan Windows.</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">Lisensi</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">Pemeliharaan</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">Data dan singgahan</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">Buka folder log</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">Muat ulang Akses cepat</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">Setel ulang pengaturan</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">Kelola singgahan, log, dan data pengaturan</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Minimalkan ke area notifikasi</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">Saat diminimalkan, Kiriha hilang dari bilah tugas dan dapat dipulihkan dari ikon di area notifikasi.</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">Tetikus</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">Saat klik ganda pada latar folder</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">Saat klik roda pada latar folder</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">Tutup tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">Tidak melakukan apa pun</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">Sematkan tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">Segarkan</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">Saat klik ganda pada tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">Saat klik roda pada tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">Naik satu tingkat</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Jalankan Kiriha saat Windows dimulai</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">Kiriha berjalan otomatis saat Anda masuk.</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">Buka gambar di Kiriha sendiri</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">Hanya berlaku untuk klik ganda di dalam Kiriha; berkas dibuka layar penuh pada tampilan galeri (RAW ikut dianggap gambar). Asosiasi berkas Windows tidak diubah.</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">Buka video di Kiriha sendiri</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">Kurangi buram saat diperbesar (penajaman)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">Kuat</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">Ringan</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">Maksimum (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">Standar</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">Menegaskan tepi secukupnya saat gambar atau video diperbesar ke ukuran layar (setara AMD FidelityFX RCAS). Video diproses di GPU saat digambar, jadi pemutaran hampir tidak menambah beban CPU.</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">Pintasan</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">Operasi berkas</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　Potong, salin, tempel　　Delete / Shift+Delete　Hapus, hapus permanen&#10;F2　Ganti nama　　Alt+Enter　Properti　　Ctrl+Shift+N　Folder baru　　Alt+P　Pratinjau</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">Navigasi dan tampilan</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　Edit alamat&#10;Ctrl+F / F3　Cari&#10;Alt+← / →　Kembali dan maju&#10;Alt+↑　Naik satu tingkat&#10;F5　Segarkan / F11　Layar penuh</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">Pintasan papan ketik agar bekerja lebih cepat</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">Tab</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　Tab baru&#10;Ctrl+W　Tutup tab&#10;Ctrl+Shift+T　Buka lagi tab yang ditutup&#10;Ctrl+Tab　Berpindah tab&#10;Ctrl+1..9　Pilih tab tertentu</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">Tampilkan kotak centang item</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">Tampilkan ekstensi nama berkas</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">Tampilkan berkas tersembunyi</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">Mulai dalam keadaan diminimalkan ke area notifikasi</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha dimulai tanpa menampilkan jendela, diminimalkan ke area notifikasi.</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">Pemulaian</x:String>
  <x:String x:Key="Text.Settings.Startup.Behavior" xml:space="preserve">Perilaku saat mulai</x:String>
  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">Folder yang dibuka di tab baru (kosongkan untuk folder pengguna Anda)</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">Pulihkan tab yang terbuka saat aplikasi ditutup</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">Kelola pemulaian, integrasi Windows, dan area notifikasi</x:String>

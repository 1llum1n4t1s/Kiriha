  <x:String x:Key="Text.License.Activate" xml:space="preserve">Attiva</x:String>
  <x:String x:Key="Text.License.CodePlaceholder" xml:space="preserve">Codice a 6 cifre</x:String>
  <x:String x:Key="Text.License.Deactivate" xml:space="preserve">Disattiva questo computer</x:String>
  <x:String x:Key="Text.License.DeactivateNote" xml:space="preserve">Disattiva solo questo computer. L'acquisto resta valido, quindi puoi riattivarlo quando vuoi con la stessa e-mail. Il periodo di prova non viene prolungato.</x:String>
  <x:String x:Key="Text.License.EmailPlaceholder" xml:space="preserve">E-mail usata per l'acquisto</x:String>
  <x:String x:Key="Text.License.Exit" xml:space="preserve">Esci</x:String>
  <x:String x:Key="Text.License.KeyFallback" xml:space="preserve">Inserisci invece una chiave di licenza</x:String>
  <x:String x:Key="Text.License.KeyPlaceholder" xml:space="preserve">Chiave di licenza che inizia con KIRIHA-</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckBody" xml:space="preserve">La licenza non viene verificata online da più di 30 giorni. Collegati a Internet e premi «Verifica di nuovo online».</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckTitle" xml:space="preserve">È necessario verificare la licenza online</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredBody" xml:space="preserve">Per usare Kiriha è necessaria una licenza attivata (¥1,980, acquisto unico).</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredTitle" xml:space="preserve">Il periodo di prova è terminato</x:String>
  <x:String x:Key="Text.License.Msg.Activated" xml:space="preserve">La licenza è stata attivata 🎉 Grazie mille!</x:String>
  <x:String x:Key="Text.License.Msg.CheckOk" xml:space="preserve">Verifica completata. Grazie per usare Kiriha!</x:String>
  <x:String x:Key="Text.License.Msg.Checking" xml:space="preserve">Verifica online in corso…</x:String>
  <x:String x:Key="Text.License.Msg.CodeSent" xml:space="preserve">Abbiamo inviato un codice di conferma via e-mail. Inserisci le 6 cifre ricevute.</x:String>
  <x:String x:Key="Text.License.Msg.CodeTooSoon" xml:space="preserve">Troppe richieste. Attendi circa 30 secondi e riprova.</x:String>
  <x:String x:Key="Text.License.Msg.Deactivated" xml:space="preserve">Questo computer è stato disattivato. Puoi riattivarlo quando vuoi con la stessa e-mail.</x:String>
  <x:String x:Key="Text.License.Msg.EnterCode" xml:space="preserve">Inserisci il codice a 6 cifre ricevuto via e-mail.</x:String>
  <x:String x:Key="Text.License.Msg.EnterEmail" xml:space="preserve">Inserisci l'indirizzo e-mail usato per l'acquisto.</x:String>
  <x:String x:Key="Text.License.Msg.EnterKey" xml:space="preserve">Inserisci la chiave di licenza rilasciata al momento dell'acquisto.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidCode" xml:space="preserve">Il codice non è corretto o è scaduto. Richiedi un nuovo codice.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidKey" xml:space="preserve">Questa chiave di licenza non è valida. Verifica che non manchino caratteri e che non siano stati copiati spazi in più.</x:String>
  <x:String x:Key="Text.License.Msg.NoPurchase" xml:space="preserve">Nessun acquisto trovato per questo indirizzo e-mail. Controlla l'indirizzo usato per l'acquisto.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseFailed" xml:space="preserve">Impossibile aprire la pagina di acquisto. Riprova più tardi.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseOpened" xml:space="preserve">La pagina di acquisto è aperta nel browser. Al termine, attiva dal campo e-mail qui sopra.</x:String>
  <x:String x:Key="Text.License.Msg.Revoked" xml:space="preserve">Questa licenza non è più valida (ad esempio dopo un rimborso). Effettua di nuovo l'acquisto.</x:String>
  <x:String x:Key="Text.License.Msg.Sending" xml:space="preserve">Invio del codice di conferma…</x:String>
  <x:String x:Key="Text.License.Msg.ServerUnreachable" xml:space="preserve">Impossibile contattare il server. Controlla la connessione di rete e riprova.</x:String>
  <x:String x:Key="Text.License.Msg.Verifying" xml:space="preserve">Verifica in corso…</x:String>
  <x:String x:Key="Text.License.OpenPurchase" xml:space="preserve">Apri la pagina di acquisto (¥1,980, acquisto unico)</x:String>
  <x:String x:Key="Text.License.PurchaseNote" xml:space="preserve">Non servono account né password. Acquisto una tantum a ¥1,980, senza limiti di computer.</x:String>
  <x:String x:Key="Text.License.Recheck" xml:space="preserve">Verifica di nuovo online</x:String>
  <x:String x:Key="Text.License.RecoverNote" xml:space="preserve">Invieremo un codice di conferma all'indirizzo usato per l'acquisto. Non serve la chiave di licenza.</x:String>

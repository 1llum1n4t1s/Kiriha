  <x:String x:Key="Text.Rename.AlreadyExists" xml:space="preserve">Esiste già un file o una cartella con questo nome: {0}</x:String>
  <x:String x:Key="Text.Rename.InvalidChars" xml:space="preserve">Il nome del file contiene caratteri non validi: \ / : * ? " &lt; &gt; |</x:String>
  <x:String x:Key="Text.Rename.RevertedToOriginal" xml:space="preserve">La ridenominazione non è riuscita, quindi è stato ripristinato il nome originale</x:String>
  <x:String x:Key="Text.Rename.StuckAsTemporary" xml:space="preserve">La ridenominazione non è riuscita e resta il nome temporaneo: {0}</x:String>
  <x:String x:Key="Text.Search.ClearTip" xml:space="preserve">Cancella la ricerca</x:String>
  <x:String x:Key="Text.Search.Failed" xml:space="preserve">Ricerca non riuscita: {0}</x:String>
  <x:String x:Key="Text.Search.Found" xml:space="preserve">{0} risultato/i trovato/i (sottocartelle incluse)</x:String>
  <x:String x:Key="Text.Search.Placeholder" xml:space="preserve">Cerca in {0}</x:String>
  <x:String x:Key="Text.Search.Searching" xml:space="preserve">Ricerca in corso... (sottocartelle incluse)</x:String>
  <x:String x:Key="Text.Search.Truncated" xml:space="preserve">Interrotta a {0} risultati (raggiunto il limite di 1000 e alcune sottocartelle non sono state esaminate; restringi la ricerca per vedere altro)</x:String>
  <x:String x:Key="Text.Select.All" xml:space="preserve">Seleziona tutto</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">Seleziona solo i file</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">Seleziona solo le cartelle</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">Inverti la selezione</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">Deseleziona tutto</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">Informazioni su Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha unisce in un'unica finestra la gestione dei file di Esplora risorse e le schede, la barra degli indirizzi e i preferiti di Chrome. Le impostazioni vengono salvate per l'utente corrente.</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">Usa l'effetto acrilico (sfocatura traslucida) per la finestra</x:String>
  <x:String x:Key="Text.Settings.ContextMenu" xml:space="preserve">Menu di scelta rapida</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Modern" xml:space="preserve">Nativo di Kiriha (stile Windows 11)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Note" xml:space="preserve">Il menu in stile Windows 11 mostra solo voci selezionate ed estensioni della shell; i sottomenu come «Invia a» restano in «Mostra altre opzioni». Cambia modalità se un'estensione non compare correttamente.</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Shell" xml:space="preserve">Nativo di Kiriha (voci della shell invariate)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.System" xml:space="preserve">Predefinito di Windows</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">Imposta Kiriha come app predefinita per aprire cartelle e unità</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">Se attivo, Kiriha si avvia ogni volta che apri una cartella o un'unità da Esplora file.</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">Al momento cartelle e unità si aprono in Kiriha. Disattivando l'opzione viene ripristinato il comportamento precedente.</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">Visualizzazione predefinita delle cartelle</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">Visualizzazione</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">Le cartelle senza una visualizzazione salvata si aprono con queste impostazioni. Cambiando visualizzazione o ordinamento in una cartella, la scelta viene salvata solo per quella cartella.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">Reimposta le visualizzazioni per cartella</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">Le visualizzazioni salvate per cartella sono state eliminate.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">Elimina visualizzazione, ordinamento e larghezza delle colonne memorizzati per ogni cartella e ripristina i valori predefiniti qui sopra.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">Ordina per</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">Aspetto</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">Regola l'aspetto dell'elenco file e di Kiriha</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">Elenco file</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">Aggiungi «Apri con Kiriha» al menu contestuale di Esplora file</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">Consente di aprire una cartella in Kiriha facendo clic destro sulla cartella o sullo sfondo del suo contenuto.</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">Albero delle cartelle</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">Galleria</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Il tema Material Icon Theme usa material-icon-theme (licenza MIT, © Material Extensions). Il set Windows mostra le stesse icone della shell di Esplora file.</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Icone originali di Kiriha</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Icone della shell di Windows</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">Icone</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Lingua dell'interfaccia</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">Per impostazione predefinita la lingua viene rilevata dalla lingua di visualizzazione di Windows.</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">Licenza</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">Manutenzione</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">Dati e cache</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">Apri la cartella dei log</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">Ricarica Accesso rapido</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">Reimposta le impostazioni</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">Gestisci cache, log e dati delle impostazioni</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Riduci nell'area di notifica</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">Quando è ridotto, Kiriha scompare dalla barra delle applicazioni e può essere ripristinato dall'icona nell'area di notifica.</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">Mouse</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">Con doppio clic sullo sfondo della cartella</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">Con clic della rotellina sullo sfondo della cartella</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">Chiudi la scheda</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">Non fare nulla</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">Aggiungi la scheda</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">Aggiorna</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">Con doppio clic su una scheda</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">Con clic della rotellina su una scheda</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">Vai al livello superiore</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Avvia Kiriha all'avvio di Windows</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">Kiriha si avvia automaticamente all'accesso.</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">Apri le immagini in Kiriha</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">Vale solo per il doppio clic dentro Kiriha: il file si apre a schermo intero nella galleria (i RAW contano come immagini). Le associazioni di Windows non vengono toccate.</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">Apri i video in Kiriha</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">Riduci la sfocatura in ingrandimento (nitidezza)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">Forte</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">Leggera</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">Massima (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">Standard</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">Rinforza leggermente i soli contorni quando un'immagine o un video viene ingrandito a schermo (equivale ad AMD FidelityFX RCAS). Il video viene elaborato sulla GPU durante il disegno, quindi la riproduzione non aggiunge quasi nulla alla CPU.</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">Scorciatoie</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">Operazioni sui file</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　Taglia, copia, incolla　　Canc / Maiusc+Canc　Elimina, elimina definitivamente&#10;F2　Rinomina　　Alt+Invio　Proprietà　　Ctrl+Maiusc+N　Nuova cartella　　Alt+P　Anteprima</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">Navigazione e visualizzazione</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　Modifica l'indirizzo&#10;Ctrl+F / F3　Cerca&#10;Alt+← / →　Indietro e avanti&#10;Alt+↑　Livello superiore&#10;F5　Aggiorna / F11　Schermo intero</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">Scorciatoie da tastiera per lavorare più velocemente</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">Schede</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　Nuova scheda&#10;Ctrl+W　Chiudi la scheda&#10;Ctrl+Maiusc+T　Riapri la scheda chiusa&#10;Ctrl+Tab　Cambia scheda&#10;Ctrl+1..9　Seleziona una scheda specifica</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">Mostra le caselle di controllo degli elementi</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">Mostra le estensioni dei file</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">Mostra i file nascosti</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">Avvia ridotto nell'area di notifica</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha si avvia senza mostrare la finestra, ridotto nell'area di notifica.</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">Avvio</x:String>
  <x:String x:Key="Text.Settings.Startup.Behavior" xml:space="preserve">Comportamento all'avvio</x:String>
  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">Cartella da aprire nelle nuove schede (lascia vuoto per la cartella utente)</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">Ripristina le schede aperte alla chiusura</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">Gestisci avvio, integrazione con Windows e area di notifica</x:String>

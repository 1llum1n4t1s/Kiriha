  <x:String x:Key="Text.Settings.About" xml:space="preserve">De Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha operationes fasciculorum Exploratoris Windows cum schedis, tabula inscriptionis et notis Chrome in una fenestra coniungit. Optiones pro usuario praesenti servantur.</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">Effectum acrylicum (nebulam pellucidam) in fenestra adhibere</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">Kiriha applicationem praedefinitam ad plicas et discos aperiendos facere</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">Si activatum est, Kiriha incipit quotiens plica vel discus ex Exploratore aperitur.</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">Nunc plicae et disci in Kiriha aperiuntur. Si deactivatur, mos pristinus restituitur.</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">Species</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">Speciem indicis fasciculorum et formam Kiriha aptare</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">Index fasciculorum</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">«Cum Kiriha aperire» ad menu contextuale Exploratoris addere</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">Permittit plicam in Kiriha aperire dextro clicu in plicam vel in fundum contenti eius.</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">Arbor plicarum</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Material Icon Theme utitur material-icon-theme (licentia MIT, © Material Extensions). Copia Windows easdem imagunculas Shell quas Explorator ostendit.</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Imagunculae propriae Kiriha</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Imagunculae Shell Windows</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">Imagunculae</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Lingua interfaciei</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">Praedefinite lingua ex lingua Windows deprehenditur.</x:String>

  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">Compendia</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">Operationes fasciculorum</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　Exsecare, exscribere, agglutinare　　Delete / Shift+Delete　Delere, penitus delere&#10;F2　Nomen mutare　　Alt+Enter　Proprietates　　Ctrl+Shift+N　Plica nova　　Alt+P　Praevisio</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">Navigatio et aspectus</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　Inscriptionem recensere&#10;Ctrl+F / F3　Quaerere&#10;Alt+← / →　Retro et prorsum&#10;Alt+↑　Gradum sursum&#10;F5　Renovare / F11　Tota tabula</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">Compendia claviaturae ad celerius operandum</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">Schedae</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　Scheda nova&#10;Ctrl+W　Schedam claudere&#10;Ctrl+Shift+T　Schedam clausam iterum aperire&#10;Ctrl+Tab　Schedas permutare&#10;Ctrl+1..9　Schedam certam eligere</x:String>

  <x:String x:Key="Text.License.KeyPlaceholder" xml:space="preserve">Clavis licentiae a KIRIHA- incipiens</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckBody" xml:space="preserve">Licentia plus quam XXX dies in linea non verificata est. Ad interrete te coniunge et «Iterum in linea verificare» preme.</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckTitle" xml:space="preserve">Licentia in linea verificanda est</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredBody" xml:space="preserve">Ad Kiriha utendum licentia activata requiritur (¥980, emptio unica).</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredTitle" xml:space="preserve">Tempus probationis finitum est</x:String>
  <x:String x:Key="Text.License.Msg.Activated" xml:space="preserve">Licentia activata est 🎉 Gratias plurimas!</x:String>
  <x:String x:Key="Text.License.Msg.CheckOk" xml:space="preserve">Verificatio perfecta est. Gratias quod Kiriha uteris!</x:String>
  <x:String x:Key="Text.License.Msg.Checking" xml:space="preserve">In linea verificatur…</x:String>
  <x:String x:Key="Text.License.Msg.EnterKey" xml:space="preserve">Clavem licentiae in emptione datam insere.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidKey" xml:space="preserve">Haec clavis licentiae non valet. Vide num litterae desint aut spatia superflua exscripta sint.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseFailed" xml:space="preserve">Pagina emptionis aperiri non potuit. Postea itera.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseOpened" xml:space="preserve">Pagina emptionis in navigatro aperta est. Clavem licentiae in pagina confirmationis ostensam supra agglutina.</x:String>
  <x:String x:Key="Text.License.Msg.Revoked" xml:space="preserve">Haec licentia non iam valet (exempli gratia post pecuniam redditam). Iterum eme.</x:String>
  <x:String x:Key="Text.License.Msg.ServerUnreachable" xml:space="preserve">Servitor attingi non potuit. Coniunctionem retis inspice et itera.</x:String>
  <x:String x:Key="Text.License.OpenPurchase" xml:space="preserve">Paginam emptionis aperire (¥980, semel)</x:String>
  <x:String x:Key="Text.License.PurchaseNote" xml:space="preserve">Post emptionem clavis licentiae in pagina confirmationis solutionis ostenditur. Nec ratio nec tessera opus est.</x:String>

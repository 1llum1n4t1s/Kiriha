  <x:String x:Key="Text.Gallery.Gamma" xml:space="preserve">Гамма</x:String>
  <x:String x:Key="Text.Gallery.GammaReset" xml:space="preserve">Повернути гаму до 1,00</x:String>
  <x:String x:Key="Text.Gallery.GammaTip" xml:space="preserve">Регулює яскравість темних ділянок (лише відображення, файл не змінюється)</x:String>
  <x:String x:Key="Text.Gallery.ImageInfo" xml:space="preserve">Відомості про зображення</x:String>
  <x:String x:Key="Text.Gallery.Next" xml:space="preserve">Наступне зображення (стрілка вправо)</x:String>
  <x:String x:Key="Text.Gallery.NoImageInfo" xml:space="preserve">Для цього зображення немає відомостей.</x:String>
  <x:String x:Key="Text.Gallery.Previous" xml:space="preserve">Попереднє зображення (стрілка вліво)</x:String>
  <x:String x:Key="Text.Gallery.RotateFailed" xml:space="preserve">Це зображення не можна повернути без втрат.</x:String>
  <x:String x:Key="Text.Gallery.RotateLeft" xml:space="preserve">Повернути ліворуч (зберігається без втрат)</x:String>
  <x:String x:Key="Text.Gallery.RotateRight" xml:space="preserve">Повернути праворуч (зберігається без втрат)</x:String>
  <x:String x:Key="Text.Gallery.Zoom" xml:space="preserve">Масштаб</x:String>

  <x:String x:Key="Text.Nav.CrumbOverflow" xml:space="preserve">Теки, які не вмістилися (натисніть, щоб показати)</x:String>
  <x:String x:Key="Text.Nav.EditPathTip" xml:space="preserve">Клацніть, щоб змінити шлях</x:String>
  <x:String x:Key="Text.Nav.Forward" xml:space="preserve">Вперед</x:String>
  <x:String x:Key="Text.Nav.ForwardTip" xml:space="preserve">Вперед (правий клік — журнал)</x:String>
  <x:String x:Key="Text.Nav.Home" xml:space="preserve">Домівка</x:String>
  <x:String x:Key="Text.Nav.HomeTip" xml:space="preserve">Домівка (Alt+Home / правий клік — часті папки)</x:String>
  <x:String x:Key="Text.Nav.OpenFailed" xml:space="preserve">Не вдалося відкрити: {0}</x:String>
  <x:String x:Key="Text.Nav.OpenSettings" xml:space="preserve">Відкрити параметри</x:String>
  <x:String x:Key="Text.Nav.Refresh" xml:space="preserve">Оновити</x:String>
  <x:String x:Key="Text.Nav.Settings" xml:space="preserve">Параметри</x:String>
  <x:String x:Key="Text.Nav.UpFolder" xml:space="preserve">На рівень вище</x:String>
  <x:String x:Key="Text.Nav.UpTip" xml:space="preserve">На рівень вище (правий клік — батьківські папки)</x:String>
  <x:String x:Key="Text.New.CreateFailed" xml:space="preserve">Не вдалося створити: {0}</x:String>
  <x:String x:Key="Text.New.FolderName" xml:space="preserve">Нова папка</x:String>
  <x:String x:Key="Text.New.ItemName" xml:space="preserve">Новий {0}</x:String>
  <x:String x:Key="Text.New.UndoFailed" xml:space="preserve">Не вдалося скасувати створення нової папки: {0}</x:String>
  <x:String x:Key="Text.Op.Copied" xml:space="preserve">Скопійовано об'єктів: {0}</x:String>
  <x:String x:Key="Text.Op.DeleteFailed" xml:space="preserve">Не вдалося видалити ({0})</x:String>
  <x:String x:Key="Text.Op.Failed" xml:space="preserve">Не вдалося виконати файлову операцію ({0})</x:String>
  <x:String x:Key="Text.Op.Moved" xml:space="preserve">Переміщено об'єктів: {0}</x:String>
  <x:String x:Key="Text.Op.PasteFailed" xml:space="preserve">Не вдалося вставити ({0})</x:String>
  <x:String x:Key="Text.Op.RenameFailed" xml:space="preserve">Не вдалося перейменувати ({0})</x:String>
  <x:String x:Key="Text.Op.ShortcutsCreated" xml:space="preserve">Створено ярликів: {0}</x:String>
  <x:String x:Key="Text.Preview.FolderSummary" xml:space="preserve">файлів: {0}  {1}</x:String>
  <x:String x:Key="Text.Preview.OrMore" xml:space="preserve"> або більше</x:String>
  <x:String x:Key="Text.RecycleBin.Empty" xml:space="preserve">Очистити Кошик</x:String>
  <x:String x:Key="Text.Rename.AlreadyExists" xml:space="preserve">Файл або папка з такою назвою вже існує: {0}</x:String>
  <x:String x:Key="Text.Rename.InvalidChars" xml:space="preserve">Ім'я файлу містить неприпустимі символи: \ / : * ? " &lt; &gt; |</x:String>
  <x:String x:Key="Text.Rename.RevertedToOriginal" xml:space="preserve">Перейменування не вдалося, тому повернуто початкову назву</x:String>
  <x:String x:Key="Text.Rename.StuckAsTemporary" xml:space="preserve">Перейменування не вдалося, залишилася тимчасова назва: {0}</x:String>
  <x:String x:Key="Text.Search.ClearTip" xml:space="preserve">Очистити пошук</x:String>
  <x:String x:Key="Text.Search.Failed" xml:space="preserve">Помилка пошуку: {0}</x:String>
  <x:String x:Key="Text.Search.Found" xml:space="preserve">Знайдено результатів: {0} (разом із підпапками)</x:String>
  <x:String x:Key="Text.Search.Placeholder" xml:space="preserve">Пошук у {0}</x:String>
  <x:String x:Key="Text.Search.Searching" xml:space="preserve">Пошук... (разом із підпапками)</x:String>
  <x:String x:Key="Text.Search.Truncated" xml:space="preserve">Зупинено на {0} результатах (досягнуто межу 1000, деякі підпапки не переглянуто; звузьте запит, щоб побачити більше)</x:String>
  <x:String x:Key="Text.Select.All" xml:space="preserve">Виділити все</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">Виділити лише файли</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">Виділити лише папки</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">Інвертувати виділення</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">Зняти виділення</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">Про Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha поєднує в одному вікні роботу з файлами як у Провіднику Windows та вкладки, адресний рядок і закладки як у Chrome. Параметри зберігаються для поточного користувача.</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">Використовувати ефект акрилу (напівпрозоре розмиття) для вікна</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">Зробити Kiriha програмою за замовчуванням для відкриття папок і дисків</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">Якщо ввімкнено, Kiriha запускається щоразу, коли папку або диск відкривають із Провідника.</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">Зараз папки та диски відкриваються в Kiriha. Якщо вимкнути, повернеться попередня поведінка.</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">Типовий вигляд папок</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">Вигляд</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">Папки без збереженого вигляду відкриваються з цими налаштуваннями. Якщо змінити вигляд або сортування в папці, це збережеться лише для неї.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">Скинути налаштування вигляду для папок</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">Налаштування вигляду для папок видалено.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">Видаляє вигляд, сортування та ширину стовпців, запам'ятовані для кожної папки, і повертає типові значення вище.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">Сортування</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">Вигляд</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">Налаштуйте вигляд списку файлів і оформлення Kiriha</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">Список файлів</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">Додати «Відкрити за допомогою Kiriha» до контекстного меню Провідника</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">Дозволяє відкрити папку в Kiriha, клацнувши правою кнопкою на папці або на фоні її вмісту.</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">Дерево папок</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">Галерея</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Тема Material Icon Theme використовує material-icon-theme (ліцензія MIT, © Material Extensions). Набір Windows показує ті самі значки оболонки, що й Провідник.</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Оригінальні значки Kiriha</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Значки оболонки Windows</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">Значки</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Мова інтерфейсу</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">За замовчуванням мова визначається за мовою інтерфейсу Windows.</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">Ліцензія</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">Обслуговування</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">Дані та кеш</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">Відкрити папку журналів</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">Перезавантажити Швидкий доступ</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">Скинути параметри</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">Керуйте кешем, журналами та даними параметрів</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Згортати в область сповіщень</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">Після згортання Kiriha зникає з панелі завдань і відновлюється зі значка в області сповіщень.</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">Миша</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">Подвійний клік на фоні папки</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">Клік колесом на фоні папки</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">Закрити вкладку</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">Нічого не робити</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">Закріпити вкладку</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">Оновити</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">Подвійний клік на вкладці</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">Клік колесом на вкладці</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">Перейти на рівень вище</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Запускати Kiriha разом із Windows</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">Kiriha запускається автоматично після входу в систему.</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">Відкривати зображення в самому Kiriha</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">Діє лише для подвійного клацання всередині Kiriha: файл відкривається в галереї на весь екран (RAW теж вважається зображенням). Асоціації файлів Windows не змінюються.</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">Відкривати відео в самому Kiriha</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">Зменшувати розмитість при збільшенні (різкість)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">Сильно</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">Слабко</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">Максимально (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">Стандартно</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">Легко підтягує лише контури, коли зображення або відео розтягується під екран (аналог AMD FidelityFX RCAS). Відео обробляється на GPU під час малювання, тож відтворення майже не навантажує процесор.</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">Комбінації клавіш</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">Операції з файлами</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　Вирізати, копіювати, вставити　　Delete / Shift+Delete　Видалити, видалити остаточно&#10;F2　Перейменувати　　Alt+Enter　Властивості　　Ctrl+Shift+N　Нова папка　　Alt+P　Перегляд</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">Навігація та вигляд</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　Змінити адресу&#10;Ctrl+F / F3　Пошук&#10;Alt+← / →　Назад і вперед&#10;Alt+↑　На рівень вище&#10;F5　Оновити / F11　На весь екран</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">Комбінації клавіш для швидшої роботи</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">Вкладки</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　Нова вкладка&#10;Ctrl+W　Закрити вкладку&#10;Ctrl+Shift+T　Відновити закриту вкладку&#10;Ctrl+Tab　Перемикання вкладок&#10;Ctrl+1..9　Вибрати певну вкладку</x:String>
  <x:String x:Key="Text.Settings.ShowBookmarksBar" xml:space="preserve">Показувати панель закладок (Ctrl+Shift+B)</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">Показувати прапорці елементів</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">Показувати розширення файлів</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">Показувати приховані файли</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">Запускатися згорнутим в область сповіщень</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha запускається без показу вікна, згорнутим в область сповіщень.</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">Запуск</x:String>
  <x:String x:Key="Text.Settings.Startup.Behavior" xml:space="preserve">Поведінка під час запуску</x:String>
  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">Папка, що відкривається в нових вкладках (залиште порожнім для папки користувача)</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">Відновлювати вкладки, відкриті під час закриття</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">Керуйте запуском, інтеграцією з Windows та областю сповіщень</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">Тема</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Темна</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">Світла</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">Системна</x:String>
  <x:String x:Key="Text.Settings.Tray" xml:space="preserve">Область сповіщень</x:String>
  <x:String x:Key="Text.Settings.TreeDragDisabled" xml:space="preserve">Заборонити перетягування з дерева</x:String>
  <x:String x:Key="Text.Settings.TreeDropDisabled" xml:space="preserve">Заборонити перетягування в дерево</x:String>
  <x:String x:Key="Text.Settings.Updates" xml:space="preserve">Оновлення та відомості</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckNow" xml:space="preserve">Перевірити оновлення зараз</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckOnStartup" xml:space="preserve">Перевіряти оновлення під час запуску</x:String>
  <x:String x:Key="Text.Settings.Updates.Subtitle" xml:space="preserve">Перевіряйте версію Kiriha та керуйте оновленнями</x:String>
  <x:String x:Key="Text.Settings.Updates.VersionCard" xml:space="preserve">Версія та оновлення</x:String>
  <x:String x:Key="Text.Settings.Window" xml:space="preserve">Вікно</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBounds" xml:space="preserve">Запам'ятовувати розмір і положення вікна</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBoundsNote" xml:space="preserve">Якщо вимкнено, наступного разу Kiriha відкриється з типовим розміром і положенням.</x:String>
  <x:String x:Key="Text.Settings.WindowsIntegration" xml:space="preserve">Інтеграція з Windows</x:String>
  <x:String x:Key="Text.Settings.VideoSeekSeconds" xml:space="preserve">Секунд на один крок перемотування відео</x:String>
  <x:String x:Key="Text.Share.FileCount" xml:space="preserve">файлів: {0}</x:String>
  <x:String x:Key="Text.Share.FoldersNotSupported" xml:space="preserve">Папками не можна поділитися (виберіть файли)</x:String>
  <x:String x:Key="Text.Share.NoItems" xml:space="preserve">Немає чим поділитися</x:String>
  <x:String x:Key="Text.Share.OpenFailed" xml:space="preserve">Не вдалося відкрити панель спільного доступу</x:String>
  <x:String x:Key="Text.Share.PrepareFailed" xml:space="preserve">Не вдалося підготувати дані для надсилання</x:String>
  <x:String x:Key="Text.Share.SelectFiles" xml:space="preserve">Виберіть файли, якими хочете поділитися</x:String>
  <x:String x:Key="Text.Sidebar.Drives" xml:space="preserve">Диски</x:String>
  <x:String x:Key="Text.Sidebar.QuickAccess" xml:space="preserve">Швидкий доступ</x:String>
  <x:String x:Key="Text.Sidebar.RecentFiles" xml:space="preserve">Останні файли</x:String>
  <x:String x:Key="Text.Sidebar.RecycleBin" xml:space="preserve">Кошик</x:String>
  <x:String x:Key="Text.Sidebar.RecycleBinTip" xml:space="preserve">Відкрити Кошик у Провіднику</x:String>
  <x:String x:Key="Text.Sidebar.ToggleTip" xml:space="preserve">Перемикання між Швидким доступом і деревом папок</x:String>
  <x:String x:Key="Text.Sidebar.TreeView" xml:space="preserve">Дерево папок</x:String>
  <x:String x:Key="Text.Sort.Ascending" xml:space="preserve">За зростанням</x:String>
  <x:String x:Key="Text.Sort.Descending" xml:space="preserve">За спаданням</x:String>
  <x:String x:Key="Text.Status.Breakdown" xml:space="preserve">(папок: {0}, файлів: {1})</x:String>
  <x:String x:Key="Text.Status.ClearSelectionTip" xml:space="preserve">Клацніть, щоб зняти виділення</x:String>
  <x:String x:Key="Text.Status.DetailsViewTip" xml:space="preserve">Таблиця</x:String>
  <x:String x:Key="Text.Status.FreeSpace" xml:space="preserve">Вільне місце: {0}</x:String>
  <x:String x:Key="Text.Status.IconSizeTip" xml:space="preserve">Розмір значків</x:String>
  <x:String x:Key="Text.Status.ItemCount" xml:space="preserve">об'єктів: {0}</x:String>
  <x:String x:Key="Text.Status.ItemCountFiltered" xml:space="preserve">об'єктів: {0} (пошук: {1})</x:String>
  <x:String x:Key="Text.Status.ItemsSelected" xml:space="preserve">Виділено об'єктів: {0}</x:String>
  <x:String x:Key="Text.Status.LargeIconsTip" xml:space="preserve">Великі значки</x:String>
  <x:String x:Key="Text.Tab.Category" xml:space="preserve">Вкладки</x:String>

  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Lancer Kiriha au démarrage de Windows</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">Kiriha démarre automatiquement à l'ouverture de session.</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">Raccourcis</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">Opérations sur les fichiers</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　Couper, copier, coller　　Suppr / Maj+Suppr　Supprimer, supprimer définitivement&#10;F2　Renommer　　Alt+Entrée　Propriétés　　Ctrl+Maj+N　Nouveau dossier　　Alt+P　Aperçu</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">Navigation et affichage</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　Modifier l'adresse&#10;Ctrl+F / F3　Rechercher&#10;Alt+← / →　Précédent et suivant&#10;Alt+↑　Remonter d'un niveau&#10;F5　Actualiser / F11　Plein écran</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">Raccourcis clavier pour travailler plus vite</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">Onglets</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　Nouvel onglet&#10;Ctrl+W　Fermer l'onglet&#10;Ctrl+Maj+T　Rouvrir l'onglet fermé&#10;Ctrl+Tab　Changer d'onglet&#10;Ctrl+1..9　Sélectionner un onglet précis</x:String>
  <x:String x:Key="Text.Settings.ShowBookmarksBar" xml:space="preserve">Afficher la barre de favoris (Ctrl+Maj+B)</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">Afficher les cases à cocher des éléments</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">Afficher les extensions de fichier</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">Afficher les fichiers masqués</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">Démarrer réduit dans la zone de notification</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha démarre sans afficher sa fenêtre, réduit dans la zone de notification.</x:String>

  <x:String x:Key="Text.License.Activate" xml:space="preserve">செயல்படுத்து</x:String>
  <x:String x:Key="Text.License.CodePlaceholder" xml:space="preserve">6 இலக்க குறியீடு</x:String>
  <x:String x:Key="Text.License.Deactivate" xml:space="preserve">இந்தக் கணினியின் உரிமத்தை நீக்கு</x:String>
  <x:String x:Key="Text.License.DeactivateNote" xml:space="preserve">இந்தக் கணினியின் உரிமத்தை மட்டும் நீக்குகிறது. உங்கள் கொள்முதல் செல்லுபடியாகவே இருக்கும், எனவே அதே மின்னஞ்சல் முகவரியுடன் எப்போது வேண்டுமானாலும் மீண்டும் செயல்படுத்தலாம். சோதனைக் காலம் நீட்டிக்கப்படாது.</x:String>
  <x:String x:Key="Text.License.EmailPlaceholder" xml:space="preserve">வாங்கும்போது பயன்படுத்திய மின்னஞ்சல்</x:String>
  <x:String x:Key="Text.License.Exit" xml:space="preserve">வெளியேறு</x:String>
  <x:String x:Key="Text.License.KeyFallback" xml:space="preserve">உரிம விசையை நேரடியாக உள்ளிடவும்</x:String>
  <x:String x:Key="Text.License.KeyPlaceholder" xml:space="preserve">KIRIHA- என்று தொடங்கும் உரிமக் குறியீடு</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckBody" xml:space="preserve">உரிமம் 30 நாட்களுக்கு மேலாக ஆன்லைனில் சரிபார்க்கப்படவில்லை. இணையத்துடன் இணைத்து “மீண்டும் ஆன்லைனில் சரிபார்” என்பதை அழுத்தவும்.</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckTitle" xml:space="preserve">உரிமத்தை ஆன்லைனில் சரிபார்க்க வேண்டும்</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredBody" xml:space="preserve">Kiriha ஐப் பயன்படுத்த செயல்படுத்தப்பட்ட உரிமம் தேவை (¥980, ஒரு முறை கொள்முதல்).</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredTitle" xml:space="preserve">சோதனைக் காலம் முடிந்தது</x:String>
  <x:String x:Key="Text.License.Msg.Activated" xml:space="preserve">உரிமம் செயல்படுத்தப்பட்டது 🎉 மிக்க நன்றி!</x:String>
  <x:String x:Key="Text.License.Msg.CheckOk" xml:space="preserve">சரிபார்ப்பு முடிந்தது. Kiriha ஐப் பயன்படுத்தியதற்கு நன்றி!</x:String>
  <x:String x:Key="Text.License.Msg.Checking" xml:space="preserve">ஆன்லைனில் சரிபார்க்கிறது…</x:String>
  <x:String x:Key="Text.License.Msg.CodeSent" xml:space="preserve">உறுதிப்படுத்தல் குறியீட்டை மின்னஞ்சலில் அனுப்பியுள்ளோம். பெற்ற 6 இலக்கங்களை உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.License.Msg.CodeTooSoon" xml:space="preserve">அதிக முறை கோரப்பட்டது. சுமார் 30 வினாடிகள் காத்திருந்து மீண்டும் முயற்சிக்கவும்.</x:String>
  <x:String x:Key="Text.License.Msg.Deactivated" xml:space="preserve">இந்தக் கணினியின் உரிமம் நீக்கப்பட்டது. அதே மின்னஞ்சல் முகவரியுடன் எப்போது வேண்டுமானாலும் மீண்டும் செயல்படுத்தலாம்.</x:String>
  <x:String x:Key="Text.License.Msg.EnterCode" xml:space="preserve">மின்னஞ்சலில் வந்த 6 இலக்க குறியீட்டை உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.License.Msg.EnterEmail" xml:space="preserve">வாங்கும்போது பயன்படுத்திய மின்னஞ்சல் முகவரியை உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.License.Msg.EnterKey" xml:space="preserve">கொள்முதலின்போது வழங்கப்பட்ட உரிமக் குறியீட்டை உள்ளிடவும்.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidCode" xml:space="preserve">குறியீடு தவறானது அல்லது காலாவதியானது. புதிய குறியீட்டை அனுப்பவும்.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidKey" xml:space="preserve">இந்த உரிமக் குறியீடு சரியில்லை. நகலெடுக்கும்போது எழுத்துகள் விடுபட்டதா அல்லது கூடுதல் இடைவெளி வந்ததா எனப் பாருங்கள்.</x:String>
  <x:String x:Key="Text.License.Msg.NoPurchase" xml:space="preserve">இந்த மின்னஞ்சல் முகவரிக்கான கொள்முதல் காணப்படவில்லை. வாங்கும்போது பயன்படுத்திய முகவரியைச் சரிபார்க்கவும்.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseFailed" xml:space="preserve">கொள்முதல் பக்கத்தைத் திறக்க முடியவில்லை. சிறிது நேரம் கழித்து மீண்டும் முயலவும்.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseOpened" xml:space="preserve">உலாவியில் கொள்முதல் பக்கம் திறக்கப்பட்டது. முடிந்ததும், மேலே உள்ள மின்னஞ்சல் புலத்தில் இருந்து செயல்படுத்தலாம்.</x:String>
  <x:String x:Key="Text.License.Msg.Revoked" xml:space="preserve">இந்த உரிமம் இனி செல்லாது (எடுத்துக்காட்டாக, பணம் திரும்பப்பெறப்பட்டது). மீண்டும் வாங்கவும்.</x:String>
  <x:String x:Key="Text.License.Msg.Sending" xml:space="preserve">உறுதிப்படுத்தல் குறியீடு அனுப்பப்படுகிறது…</x:String>
  <x:String x:Key="Text.License.Msg.ServerUnreachable" xml:space="preserve">சேவையகத்தை அணுக முடியவில்லை. உங்கள் இணைய இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்.</x:String>
  <x:String x:Key="Text.License.Msg.Verifying" xml:space="preserve">சரிபார்க்கிறது…</x:String>
  <x:String x:Key="Text.License.OpenPurchase" xml:space="preserve">கொள்முதல் பக்கத்தைத் திற (¥980, ஒரு முறை)</x:String>
  <x:String x:Key="Text.License.PurchaseNote" xml:space="preserve">கணக்கு பதிவு அல்லது கடவுச்சொல் தேவையில்லை. ¥980 ஒரே முறை கொள்முதல், கணினிகளின் எண்ணிக்கையில் வரம்பு இல்லை.</x:String>
  <x:String x:Key="Text.License.Recheck" xml:space="preserve">மீண்டும் ஆன்லைனில் சரிபார்</x:String>
  <x:String x:Key="Text.License.RecoverNote" xml:space="preserve">வாங்கும்போது பயன்படுத்திய மின்னஞ்சலுக்கு உறுதிப்படுத்தல் குறியீட்டை அனுப்புவோம். உரிம விசை தேவையில்லை.</x:String>
  <x:String x:Key="Text.License.ResendCode" xml:space="preserve">குறியீட்டை மீண்டும் அனுப்பு</x:String>
  <x:String x:Key="Text.License.SendCode" xml:space="preserve">குறியீட்டை அனுப்பு</x:String>
  <x:String x:Key="Text.License.Status.Licensed" xml:space="preserve">உரிமம் செயல்படுத்தப்பட்டது: {0}</x:String>
  <x:String x:Key="Text.License.Status.OnlineCheck" xml:space="preserve">உரிமத்தை ஆன்லைனில் சரிபார்க்க வேண்டும் (இணையத்துடன் இணைக்கவும்)</x:String>
  <x:String x:Key="Text.License.Status.Trial" xml:space="preserve">சோதனைக் காலம் ({0} நாட்கள் மீதம்)</x:String>
  <x:String x:Key="Text.License.Status.TrialExpired" xml:space="preserve">சோதனை முடிந்தது (உரிமம் தேவை)</x:String>
  <x:String x:Key="Text.Menu.About" xml:space="preserve">Kiriha பற்றி</x:String>
  <x:String x:Key="Text.Menu.AccessDenied" xml:space="preserve">(அணுக முடியவில்லை)</x:String>
  <x:String x:Key="Text.Menu.BookmarksBar" xml:space="preserve">புத்தகக்குறிப் பட்டி</x:String>
  <x:String x:Key="Text.Menu.CheckUpdate" xml:space="preserve">புதுப்பிப்புகளைச் சரிபார்</x:String>
  <x:String x:Key="Text.Menu.Empty" xml:space="preserve">(காலி)</x:String>
  <x:String x:Key="Text.Menu.NewWindow" xml:space="preserve">புதிய சாளரம்</x:String>
  <x:String x:Key="Text.Menu.NoSubfolders" xml:space="preserve">(துணைக் கோப்புறைகள் இல்லை)</x:String>
  <x:String x:Key="Text.Menu.NoneItem" xml:space="preserve">(எதுவும் இல்லை)</x:String>
  <x:String x:Key="Text.Nav.Back" xml:space="preserve">பின்</x:String>
  <x:String x:Key="Text.Nav.BackTip" xml:space="preserve">பின் (வரலாற்றுக்கு வலது கிளிக்)</x:String>
  <x:String x:Key="Text.Nav.CrumbOverflow" xml:space="preserve">இடம் போதாத கோப்புறைகள் (சொடுக்கினால் பட்டியல்)</x:String>
  <x:String x:Key="Text.Nav.EditPathTip" xml:space="preserve">பாதையைத் திருத்த கிளிக் செய்யவும்</x:String>
  <x:String x:Key="Text.Nav.Forward" xml:space="preserve">முன்</x:String>
  <x:String x:Key="Text.Nav.ForwardTip" xml:space="preserve">முன் (வரலாற்றுக்கு வலது கிளிக்)</x:String>
  <x:String x:Key="Text.Nav.Home" xml:space="preserve">முகப்பு</x:String>
  <x:String x:Key="Text.Nav.HomeTip" xml:space="preserve">முகப்பு (Alt+Home / அடிக்கடி பயன்படுத்தும் கோப்புறைகளுக்கு வலது கிளிக்)</x:String>
  <x:String x:Key="Text.Nav.OpenFailed" xml:space="preserve">திறக்க முடியவில்லை: {0}</x:String>
  <x:String x:Key="Text.Nav.OpenSettings" xml:space="preserve">அமைப்புகளைத் திற</x:String>
  <x:String x:Key="Text.Nav.Refresh" xml:space="preserve">புதுப்பி</x:String>
  <x:String x:Key="Text.Nav.Settings" xml:space="preserve">அமைப்புகள்</x:String>
  <x:String x:Key="Text.Nav.UpFolder" xml:space="preserve">ஒரு நிலை மேலே</x:String>
  <x:String x:Key="Text.Nav.UpTip" xml:space="preserve">ஒரு நிலை மேலே (மேல் கோப்புறைகளுக்கு வலது கிளிக்)</x:String>
  <x:String x:Key="Text.New.CreateFailed" xml:space="preserve">உருவாக்க முடியவில்லை: {0}</x:String>
  <x:String x:Key="Text.New.FolderName" xml:space="preserve">புதிய கோப்புறை</x:String>
  <x:String x:Key="Text.New.ItemName" xml:space="preserve">புதிய {0}</x:String>
  <x:String x:Key="Text.New.UndoFailed" xml:space="preserve">புதிய கோப்புறை உருவாக்கத்தை மீளமைக்க முடியவில்லை: {0}</x:String>
  <x:String x:Key="Text.Op.Copied" xml:space="preserve">{0} உருப்படிகள் நகலெடுக்கப்பட்டன</x:String>
  <x:String x:Key="Text.Op.DeleteFailed" xml:space="preserve">நீக்குதல் தோல்வியடைந்தது ({0})</x:String>
  <x:String x:Key="Text.Op.Failed" xml:space="preserve">கோப்புச் செயல்பாடு தோல்வியடைந்தது ({0})</x:String>
  <x:String x:Key="Text.Op.Moved" xml:space="preserve">{0} உருப்படிகள் நகர்த்தப்பட்டன</x:String>
  <x:String x:Key="Text.Op.PasteFailed" xml:space="preserve">ஒட்டுதல் தோல்வியடைந்தது ({0})</x:String>
  <x:String x:Key="Text.Op.RenameFailed" xml:space="preserve">பெயர் மாற்றம் தோல்வியடைந்தது ({0})</x:String>
  <x:String x:Key="Text.Op.ShortcutsCreated" xml:space="preserve">{0} குறுக்குவழிகள் உருவாக்கப்பட்டன</x:String>
  <x:String x:Key="Text.Preview.FolderSummary" xml:space="preserve">{0} கோப்புகள்  {1}</x:String>
  <x:String x:Key="Text.Preview.OrMore" xml:space="preserve"> அல்லது அதற்கு மேல்</x:String>
  <x:String x:Key="Text.RecycleBin.Empty" xml:space="preserve">மறுசுழற்சிக் கூடையைக் காலி செய்</x:String>
  <x:String x:Key="Text.Rename.AlreadyExists" xml:space="preserve">இதே பெயரில் ஒரு கோப்பு அல்லது கோப்புறை ஏற்கெனவே உள்ளது: {0}</x:String>
  <x:String x:Key="Text.Rename.InvalidChars" xml:space="preserve">கோப்புப் பெயரில் செல்லாத எழுத்துகள் உள்ளன: \ / : * ? " &lt; &gt; |</x:String>
  <x:String x:Key="Text.Rename.RevertedToOriginal" xml:space="preserve">பெயர் மாற்றம் தோல்வியடைந்ததால் அசல் பெயர் மீட்கப்பட்டது</x:String>
  <x:String x:Key="Text.Rename.StuckAsTemporary" xml:space="preserve">பெயர் மாற்றம் தோல்வியடைந்தது, தற்காலிகப் பெயரே உள்ளது: {0}</x:String>
  <x:String x:Key="Text.Search.ClearTip" xml:space="preserve">தேடலை அழி</x:String>
  <x:String x:Key="Text.Search.Failed" xml:space="preserve">தேடல் தோல்வியடைந்தது: {0}</x:String>
  <x:String x:Key="Text.Search.Found" xml:space="preserve">{0} முடிவுகள் கிடைத்தன (துணைக் கோப்புறைகள் உட்பட)</x:String>
  <x:String x:Key="Text.Search.Placeholder" xml:space="preserve">{0} இல் தேடு</x:String>
  <x:String x:Key="Text.Search.Searching" xml:space="preserve">தேடுகிறது... (துணைக் கோப்புறைகள் உட்பட)</x:String>
  <x:String x:Key="Text.Search.Truncated" xml:space="preserve">{0} முடிவுகளில் நிறுத்தப்பட்டது (1000 என்ற வரம்பை எட்டியது, சில துணைக் கோப்புறைகள் பார்க்கப்படவில்லை; மேலும் காண தேடலைக் குறுக்குங்கள்)</x:String>
  <x:String x:Key="Text.Select.All" xml:space="preserve">அனைத்தையும் தேர்ந்தெடு</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">கோப்புகளை மட்டும் தேர்ந்தெடு</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">கோப்புறைகளை மட்டும் தேர்ந்தெடு</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">தேர்வை மாற்று</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">தேர்வை நீக்கு</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">Kiriha பற்றி</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Windows எக்ஸ்ப்ளோரரின் கோப்புச் செயல்பாடுகளையும், Chrome இன் தாவல்கள், முகவரிப் பட்டி, புத்தகக்குறிகளையும் Kiriha ஒரே திரையில் இணைக்கிறது. அமைப்புகள் தற்போதைய பயனருக்குச் சேமிக்கப்படும்.</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">சாளரத்திற்கு அக்ரிலிக் விளைவை (ஒளிபுகும் மங்கல்) பயன்படுத்து</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">கோப்புறைகளையும் இயக்ககங்களையும் திறக்க Kiriha ஐ இயல்புநிலை பயன்பாடாக அமை</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">இயக்கினால், எக்ஸ்ப்ளோரரில் கோப்புறை அல்லது இயக்ககத்தைத் திறக்கும்போது Kiriha தொடங்கும்.</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">தற்போது கோப்புறைகளும் இயக்ககங்களும் Kiriha இல் திறக்கின்றன. முடக்கினால் முந்தைய நடத்தை மீட்கப்படும்.</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">கோப்புறையின் இயல்புநிலைக் காட்சி</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">காட்சி முறை</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">காட்சி முறையைச் சேமிக்காத கோப்புறைகள் இந்த அமைப்புடன் திறக்கும். ஒரு கோப்புறையில் காட்சி முறையையோ வரிசையையோ மாற்றினால், அது அந்தக் கோப்புறைக்கு மட்டும் நினைவில் வைக்கப்படும்.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">ஒவ்வொரு கோப்புறையின் காட்சி அமைப்புகளை மீட்டமை</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">ஒவ்வொரு கோப்புறையின் காட்சி அமைப்புகள் நீக்கப்பட்டன.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">ஒவ்வொரு கோப்புறையிலும் நினைவில் வைத்த காட்சி முறை, வரிசை, நெடுவரிசை அகலம் அனைத்தையும் நீக்கி, மேலே உள்ள இயல்புநிலைக்குத் திரும்பும்.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">வரிசைப்படுத்தல்</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">தோற்றம்</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">கோப்புப் பட்டியலின் தோற்றத்தையும் Kiriha இன் வடிவமைப்பையும் சரிசெய்யுங்கள்</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">கோப்புப் பட்டியல்</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">எக்ஸ்ப்ளோரரின் வலது கிளிக் மெனுவில் “Kiriha மூலம் திற” ஐச் சேர்</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">கோப்புறையின் மீதோ அதன் உள்ளடக்கத்தின் வெற்றிடத்திலோ வலது கிளிக் செய்து அந்தக் கோப்புறையை Kiriha இல் திறக்கலாம்.</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">கோப்புறை மரம்</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">தொகுப்பு</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Material Icon Theme ஆனது material-icon-theme (MIT உரிமம், © Material Extensions) ஐப் பயன்படுத்துகிறது. Windows தொகுப்பு எக்ஸ்ப்ளோரரின் அதே Shell சின்னங்களைக் காட்டும்.</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Kiriha இன் அசல் சின்னங்கள்</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Windows Shell சின்னங்கள்</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">சின்னங்கள்</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">காட்சி மொழி</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">இயல்பாக, Windows இன் காட்சி மொழியிலிருந்து தானாகத் தேர்ந்தெடுக்கப்படும்.</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">உரிமம்</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">பராமரிப்பு</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">தரவும் தற்காலிகச் சேமிப்பும்</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">பதிவுக் கோப்புறையைத் திற</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">விரைவு அணுகலை மீண்டும் ஏற்று</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">அமைப்புகளை மீட்டமை</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">தற்காலிகச் சேமிப்பு, பதிவுகள், அமைப்புத் தரவை நிர்வகிக்கவும்</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">சிறிதாக்கும்போது அறிவிப்புப் பகுதிக்குச் செல்</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">சிறிதாக்கினால் Kiriha பணிப்பட்டியிலிருந்து மறையும்; அறிவிப்புப் பகுதியின் சின்னத்திலிருந்து மீட்கலாம்.</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">சுட்டி</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">கோப்புறையின் வெற்றிடத்தில் இரட்டைக் கிளிக் செய்யும்போது</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">கோப்புறையின் வெற்றிடத்தில் சக்கரக் கிளிக் செய்யும்போது</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">தாவலை மூடு</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">எதுவும் செய்யாதே</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">தாவலைப் பொருத்து</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">புதுப்பி</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">தாவலில் இரட்டைக் கிளிக் செய்யும்போது</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">தாவலில் சக்கரக் கிளிக் செய்யும்போது</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">ஒரு நிலை மேலே செல்</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Windows தொடங்கும்போது Kiriha ஐ இயக்கு</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">உள்நுழையும்போது Kiriha தானாகத் தொடங்கும்.</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">Kiriha உள்ளே படங்களை Kiriha-விலேயே திற</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">Kiriha உள்ளே இரட்டைச் சொடுக்கு செய்யும்போது மட்டுமே பொருந்தும்; கோப்பு காட்சியகத்தில் முழுத்திரையில் திறக்கும் (RAW கோப்புகளும் படங்களாகவே கருதப்படும்). Windows இணைப்புகள் மாற்றப்படுவதில்லை.</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">Kiriha உள்ளே காணொளிகளை Kiriha-விலேயே திற</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">பெரிதாக்கும்போது மங்கலைக் குறை (கூர்மையாக்கம்)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">அதிகம்</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">குறைவு</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">அதிகபட்சம் (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">இயல்பு</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">படத்தையோ காணொளியையோ திரைக்கு ஏற்ப பெரிதாக்கும்போது விளிம்புகளை மட்டும் மெதுவாக இறுக்கும் (AMD FidelityFX RCAS நிகர்). காணொளி வரையும்போது GPU-வில் செயலாக்கப்படுவதால், இயக்கத்தில் CPU சுமை கிட்டத்தட்ட கூடாது.</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">குறுக்குவழிகள்</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">கோப்புச் செயல்பாடுகள்</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　வெட்டு, நகலெடு, ஒட்டு　　Delete / Shift+Delete　நீக்கு, நிரந்தரமாக நீக்கு&#10;F2　பெயர் மாற்று　　Alt+Enter　பண்புகள்　　Ctrl+Shift+N　புதிய கோப்புறை　　Alt+P　முன்னோட்டம்</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">வழிசெலுத்தலும் காட்சியும்</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　முகவரியைத் திருத்து&#10;Ctrl+F / F3　தேடு&#10;Alt+← / →　பின்னும் முன்னும்&#10;Alt+↑　ஒரு நிலை மேலே&#10;F5　புதுப்பி / F11　முழுத் திரை</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">வேகமாக வேலை செய்யும் விசைப்பலகைக் குறுக்குவழிகள்</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">தாவல்கள்</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　புதிய தாவல்&#10;Ctrl+W　தாவலை மூடு&#10;Ctrl+Shift+T　மூடிய தாவலை மீண்டும் திற&#10;Ctrl+Tab　தாவல்களை மாற்று&#10;Ctrl+1..9　குறிப்பிட்ட தாவலைத் தேர்ந்தெடு</x:String>
  <x:String x:Key="Text.Settings.ShowBookmarksBar" xml:space="preserve">புத்தகக்குறிப் பட்டியைக் காட்டு (Ctrl+Shift+B)</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">உருப்படித் தேர்வுப்பெட்டிகளைக் காட்டு</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">கோப்பு நீட்டிப்புகளைக் காட்டு</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">மறைந்த கோப்புகளைக் காட்டு</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">தொடங்கும்போது அறிவிப்புப் பகுதியில் வை</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">தொடங்கியவுடன் சாளரத்தைக் காட்டாமல், அறிவிப்புப் பகுதியில் வைத்தபடி இயங்கும்.</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">தொடக்கம்</x:String>
  <x:String x:Key="Text.Settings.Startup.Behavior" xml:space="preserve">தொடக்கத்தின் நடத்தை</x:String>
  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">புதிய தாவல்களில் திறக்கும் கோப்புறை (காலியாக விட்டால் பயனர் கோப்புறை)</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">மூடும்போது திறந்திருந்த தாவல்களை அடுத்த முறை மீட்டமை</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">தொடக்க முறை, Windows ஒருங்கிணைப்பு, அறிவிப்புப் பகுதியை நிர்வகிக்கவும்</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">தீம்</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">அடர்</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">ஒளி</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">அமைப்பு</x:String>
  <x:String x:Key="Text.Settings.Tray" xml:space="preserve">அறிவிப்புப் பகுதி</x:String>
  <x:String x:Key="Text.Settings.TreeDragDisabled" xml:space="preserve">மரத்திலிருந்து இழுப்பதைத் தடு</x:String>
  <x:String x:Key="Text.Settings.TreeDropDisabled" xml:space="preserve">மரத்தில் விடுவதைத் தடு</x:String>
  <x:String x:Key="Text.Settings.Updates" xml:space="preserve">புதுப்பிப்புகளும் தகவலும்</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckNow" xml:space="preserve">இப்போது புதுப்பிப்புகளைச் சரிபார்</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckOnStartup" xml:space="preserve">தொடங்கும்போது புதுப்பிப்புகளைச் சரிபார்</x:String>
  <x:String x:Key="Text.Settings.Updates.Subtitle" xml:space="preserve">Kiriha இன் பதிப்பைப் பார்த்து புதுப்பிப்புகளை நிர்வகிக்கவும்</x:String>
  <x:String x:Key="Text.Settings.Updates.VersionCard" xml:space="preserve">பதிப்பும் புதுப்பிப்பும்</x:String>
  <x:String x:Key="Text.Settings.Window" xml:space="preserve">சாளரம்</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBounds" xml:space="preserve">சாளரத்தின் அளவையும் இடத்தையும் நினைவில் வை</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBoundsNote" xml:space="preserve">முடக்கினால், அடுத்த முறை இயல்பு அளவிலும் இடத்திலும் தொடங்கும்.</x:String>
  <x:String x:Key="Text.Settings.WindowsIntegration" xml:space="preserve">Windows ஒருங்கிணைப்பு</x:String>
  <x:String x:Key="Text.Settings.VideoSeekSeconds" xml:space="preserve">காணொளியை முன்/பின் நகர்த்தும் விநாடிகள்</x:String>
  <x:String x:Key="Text.Share.FileCount" xml:space="preserve">{0} கோப்புகள்</x:String>
  <x:String x:Key="Text.Share.FoldersNotSupported" xml:space="preserve">கோப்புறைகளைப் பகிர முடியாது (கோப்புகளைத் தேர்ந்தெடுக்கவும்)</x:String>
  <x:String x:Key="Text.Share.NoItems" xml:space="preserve">பகிர எதுவும் இல்லை</x:String>
  <x:String x:Key="Text.Share.OpenFailed" xml:space="preserve">பகிர்வுப் பலகத்தைத் திறக்க முடியவில்லை</x:String>

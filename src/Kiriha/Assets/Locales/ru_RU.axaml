  <x:String x:Key="Text.Gallery.GammaReset" xml:space="preserve">Вернуть гамму к 1,00</x:String>
  <x:String x:Key="Text.Gallery.GammaTip" xml:space="preserve">Регулирует яркость тёмных участков (только отображение, файл не меняется)</x:String>
  <x:String x:Key="Text.Gallery.ImageInfo" xml:space="preserve">Сведения об изображении</x:String>
  <x:String x:Key="Text.Gallery.Next" xml:space="preserve">Следующее изображение (стрелка вправо)</x:String>
  <x:String x:Key="Text.Gallery.NoImageInfo" xml:space="preserve">Для этого изображения нет сведений.</x:String>
  <x:String x:Key="Text.Gallery.Previous" xml:space="preserve">Предыдущее изображение (стрелка влево)</x:String>
  <x:String x:Key="Text.Gallery.RotateFailed" xml:space="preserve">Это изображение нельзя повернуть без потерь.</x:String>
  <x:String x:Key="Text.Gallery.RotateLeft" xml:space="preserve">Повернуть влево (сохраняется без потерь)</x:String>
  <x:String x:Key="Text.Gallery.RotateRight" xml:space="preserve">Повернуть вправо (сохраняется без потерь)</x:String>
  <x:String x:Key="Text.Gallery.Zoom" xml:space="preserve">Масштаб</x:String>

  <x:String x:Key="Text.Gallery.ZoomTip" xml:space="preserve">Масштабировать можно также с помощью Ctrl + колесо мыши</x:String>
  <x:String x:Key="Text.Integration.OpenWithKiriha" xml:space="preserve">Открыть с помощью Kiriha</x:String>
  <x:String x:Key="Text.Launch.ExplorerFailed" xml:space="preserve">Не удалось запустить Проводник: {0}</x:String>
  <x:String x:Key="Text.Launch.Failed" xml:space="preserve">Не удалось запустить: {0}</x:String>
  <x:String x:Key="Text.Launch.TerminalFailed" xml:space="preserve">Не удалось запустить Терминал: {0}</x:String>
  <x:String x:Key="Text.License.Activate" xml:space="preserve">Активировать</x:String>
  <x:String x:Key="Text.License.CodePlaceholder" xml:space="preserve">6-значный код</x:String>
  <x:String x:Key="Text.License.Deactivate" xml:space="preserve">Отвязать этот компьютер</x:String>
  <x:String x:Key="Text.License.DeactivateNote" xml:space="preserve">Отвязывает только этот компьютер. Покупка остаётся действительной, поэтому вы можете активировать снова в любой момент с тем же адресом эл. почты. Пробный период не продлевается.</x:String>
  <x:String x:Key="Text.License.EmailPlaceholder" xml:space="preserve">Эл. почта, указанная при покупке</x:String>
  <x:String x:Key="Text.License.Exit" xml:space="preserve">Выйти</x:String>
  <x:String x:Key="Text.License.KeyFallback" xml:space="preserve">Ввести лицензионный ключ</x:String>
  <x:String x:Key="Text.License.KeyPlaceholder" xml:space="preserve">Лицензионный ключ, начинающийся с KIRIHA-</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckBody" xml:space="preserve">Лицензия не проверялась онлайн более 30 дней. Подключитесь к интернету и нажмите «Проверить онлайн ещё раз».</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckTitle" xml:space="preserve">Лицензию нужно проверить онлайн</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredBody" xml:space="preserve">Для работы с Kiriha нужна активированная лицензия (¥1,980, разовая покупка).</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredTitle" xml:space="preserve">Пробный период закончился</x:String>
  <x:String x:Key="Text.License.Msg.Activated" xml:space="preserve">Лицензия активирована 🎉 Большое спасибо!</x:String>
  <x:String x:Key="Text.License.Msg.CheckOk" xml:space="preserve">Проверка завершена. Спасибо, что пользуетесь Kiriha!</x:String>
  <x:String x:Key="Text.License.Msg.Checking" xml:space="preserve">Проверяем онлайн…</x:String>
  <x:String x:Key="Text.License.Msg.CodeSent" xml:space="preserve">Код подтверждения отправлен на почту. Введите полученные 6 цифр.</x:String>
  <x:String x:Key="Text.License.Msg.CodeTooSoon" xml:space="preserve">Слишком часто. Подождите около 30 секунд и попробуйте снова.</x:String>
  <x:String x:Key="Text.License.Msg.Deactivated" xml:space="preserve">Этот компьютер отвязан. Вы можете активировать снова в любой момент с тем же адресом эл. почты.</x:String>
  <x:String x:Key="Text.License.Msg.EnterCode" xml:space="preserve">Введите 6-значный код из письма.</x:String>
  <x:String x:Key="Text.License.Msg.EnterEmail" xml:space="preserve">Введите адрес эл. почты, указанный при покупке.</x:String>
  <x:String x:Key="Text.License.Msg.EnterKey" xml:space="preserve">Введите лицензионный ключ, выданный при покупке.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidCode" xml:space="preserve">Код неверен или истёк. Отправьте код заново.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidKey" xml:space="preserve">Этот лицензионный ключ недействителен. Проверьте, не потерялись ли символы и не скопировались ли лишние пробелы.</x:String>
  <x:String x:Key="Text.License.Msg.NoPurchase" xml:space="preserve">Покупка с этим адресом эл. почты не найдена. Проверьте адрес, указанный при покупке.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseFailed" xml:space="preserve">Не удалось открыть страницу покупки. Повторите попытку позже.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseOpened" xml:space="preserve">Страница покупки открыта в браузере. После покупки активируйте через поле эл. почты выше.</x:String>
  <x:String x:Key="Text.License.Msg.Revoked" xml:space="preserve">Эта лицензия больше недействительна (например, после возврата средств). Пожалуйста, купите её снова.</x:String>
  <x:String x:Key="Text.License.Msg.Sending" xml:space="preserve">Отправка кода подтверждения…</x:String>
  <x:String x:Key="Text.License.Msg.ServerUnreachable" xml:space="preserve">Не удалось связаться с сервером. Проверьте подключение к сети и повторите попытку.</x:String>
  <x:String x:Key="Text.License.Msg.Verifying" xml:space="preserve">Проверка…</x:String>
  <x:String x:Key="Text.License.OpenPurchase" xml:space="preserve">Открыть страницу покупки (¥1,980, разово)</x:String>
  <x:String x:Key="Text.License.PurchaseNote" xml:space="preserve">Учётная запись и пароль не нужны. Разовая покупка за ¥1,980, без ограничения по числу компьютеров.</x:String>
  <x:String x:Key="Text.License.Recheck" xml:space="preserve">Проверить онлайн ещё раз</x:String>
  <x:String x:Key="Text.License.RecoverNote" xml:space="preserve">Мы отправим код подтверждения на адрес, указанный при покупке. Лицензионный ключ не нужен.</x:String>
  <x:String x:Key="Text.License.ResendCode" xml:space="preserve">Отправить код снова</x:String>
  <x:String x:Key="Text.License.SendCode" xml:space="preserve">Отправить код</x:String>
  <x:String x:Key="Text.License.Status.Licensed" xml:space="preserve">Лицензия активирована: {0}</x:String>
  <x:String x:Key="Text.License.Status.OnlineCheck" xml:space="preserve">Лицензию нужно проверить онлайн (подключитесь к интернету)</x:String>
  <x:String x:Key="Text.License.Status.Trial" xml:space="preserve">Пробный период (осталось дней: {0})</x:String>
  <x:String x:Key="Text.License.Status.TrialExpired" xml:space="preserve">Пробный период закончился (нужна лицензия)</x:String>

  <x:String x:Key="Text.Select.All" xml:space="preserve">Alles auswählen</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">Nur Dateien auswählen</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">Nur Ordner auswählen</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">Auswahl umkehren</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">Auswahl aufheben</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">Über Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha vereint die Dateiverwaltung des Windows-Explorers mit den Tabs, der Adressleiste und den Lesezeichen von Chrome in einem Fenster. Die Einstellungen werden für den aktuellen Benutzer gespeichert.</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">Acryleffekt (durchscheinende Unschärfe) für das Fenster verwenden</x:String>
  <x:String x:Key="Text.Settings.ContextMenu" xml:space="preserve">Kontextmenü</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Modern" xml:space="preserve">Kiriha-eigen (Windows-11-Stil)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Note" xml:space="preserve">Das Menü im Windows-11-Stil zeigt nur ausgewählte Einträge und Shell-Erweiterungen; Untermenüs wie „Senden an“ bleiben unter „Weitere Optionen anzeigen“. Wechseln Sie den Modus, wenn eine Erweiterung nicht korrekt erscheint.</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Shell" xml:space="preserve">Kiriha-eigen (Shell-Einträge unverändert)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.System" xml:space="preserve">Windows-Standard</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">Kiriha als Standard-App zum Öffnen von Ordnern und Laufwerken festlegen</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">Wenn aktiviert, startet Kiriha, sobald im Explorer ein Ordner oder Laufwerk geöffnet wird.</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">Ordner und Laufwerke werden derzeit in Kiriha geöffnet. Beim Deaktivieren wird das vorherige Verhalten wiederhergestellt.</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">Standardansicht für Ordner</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">Ansicht</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">Ordner ohne gespeicherte Ansicht werden mit diesen Einstellungen geöffnet. Wenn Sie Ansicht oder Sortierung in einem Ordner ändern, wird das nur für diesen Ordner gespeichert.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">Ordneransichten zurücksetzen</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">Die ordnerspezifischen Ansichtseinstellungen wurden gelöscht.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">Löscht die für jeden Ordner gespeicherte Ansicht, Sortierung und Spaltenbreite und stellt die obigen Standardwerte wieder her.</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">Sortieren nach</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">Darstellung</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">Passen Sie die Dateiliste und das Erscheinungsbild von Kiriha an</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">Dateiliste</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">„Mit Kiriha öffnen“ zum Kontextmenü des Explorers hinzufügen</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">So können Sie einen Ordner per Rechtsklick auf den Ordner oder auf den Hintergrund darin in Kiriha öffnen.</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">Ordnerbaum</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">Galerie</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Das Material Icon Theme verwendet material-icon-theme (MIT-Lizenz, © Material Extensions). Der Windows-Satz zeigt dieselben Shell-Symbole wie der Explorer.</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Original-Symbole von Kiriha</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Windows-Shell-Symbole</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">Symbole</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Anzeigesprache</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">Standardmäßig wird die Sprache aus der Windows-Anzeigesprache ermittelt.</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">Lizenz</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">Wartung</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">Daten und Cache</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">Protokollordner öffnen</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">Schnellzugriff neu laden</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">Einstellungen zurücksetzen</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">Cache, Protokolle und Einstellungsdaten verwalten</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Beim Minimieren in den Infobereich ablegen</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">Beim Minimieren verschwindet Kiriha aus der Taskleiste und kann über das Symbol im Infobereich wiederhergestellt werden.</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">Maus</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">Beim Doppelklick auf den Ordnerhintergrund</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">Beim Klick mit dem Mausrad auf den Ordnerhintergrund</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">Tab schließen</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">Nichts tun</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">Tab anheften</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">Aktualisieren</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">Beim Doppelklick auf einen Tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">Beim Klick mit dem Mausrad auf einen Tab</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">Eine Ebene nach oben</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Kiriha beim Start von Windows ausführen</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">Kiriha startet automatisch bei der Anmeldung.</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">Bilder in Kiriha selbst öffnen</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">Gilt nur für Doppelklicks innerhalb von Kiriha; die Datei wird im Vollbild der Galerie geöffnet (RAW-Dateien gelten als Bilder). Windows-Dateizuordnungen bleiben unverändert.</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">Videos in Kiriha selbst öffnen</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">Unschärfe beim Vergrößern reduzieren (Schärfen)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">Stark</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">Leicht</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">Maximal (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">Standard</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">Schärft beim Hochskalieren auf die Bildschirmgröße nur die Kanten behutsam nach (entspricht AMD FidelityFX RCAS). Video wird beim Zeichnen auf der GPU verarbeitet, die Wiedergabe kostet also kaum zusätzliche CPU-Last.</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">Tastenkürzel</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">Dateivorgänge</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Strg+X / C / V　Ausschneiden, kopieren, einfügen　　Entf / Umschalt+Entf　Löschen, endgültig löschen&#10;F2　Umbenennen　　Alt+Eingabe　Eigenschaften　　Strg+Umschalt+N　Neuer Ordner　　Alt+P　Vorschau</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">Navigation und Ansicht</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Strg+L / F4　Adresse bearbeiten&#10;Strg+F / F3　Suchen&#10;Alt+← / →　Zurück und vorwärts&#10;Alt+↑　Eine Ebene nach oben&#10;F5　Aktualisieren / F11　Vollbild</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">Tastenkürzel für schnelleres Arbeiten</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">Tabs</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Strg+T　Neuer Tab&#10;Strg+W　Tab schließen&#10;Strg+Umschalt+T　Geschlossenen Tab öffnen&#10;Strg+Tab　Tabs wechseln&#10;Strg+1..9　Bestimmten Tab auswählen</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">Kontrollkästchen für Elemente anzeigen</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">Dateinamenerweiterungen anzeigen</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">Versteckte Dateien anzeigen</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">Beim Start in den Infobereich ablegen</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha startet ohne Fenster und liegt im Infobereich.</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">Start</x:String>

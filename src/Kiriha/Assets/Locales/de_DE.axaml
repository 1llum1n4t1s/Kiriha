  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">Beim Beenden geöffnete Tabs wiederherstellen</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">Start, Windows-Integration und Infobereich verwalten</x:String>

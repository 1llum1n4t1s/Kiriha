  <x:String x:Key="Text.License.Activate" xml:space="preserve">Aktivieren</x:String>
  <x:String x:Key="Text.License.Exit" xml:space="preserve">Beenden</x:String>
  <x:String x:Key="Text.License.KeyPlaceholder" xml:space="preserve">Lizenzschlüssel, der mit KIRIHA- beginnt</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckBody" xml:space="preserve">Die Lizenz wurde seit mehr als 30 Tagen nicht online überprüft. Stellen Sie eine Internetverbindung her und drücken Sie „Erneut online prüfen“.</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckTitle" xml:space="preserve">Die Lizenz muss online überprüft werden</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredBody" xml:space="preserve">Für die Nutzung von Kiriha ist eine aktivierte Lizenz erforderlich (¥980, einmaliger Kauf).</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredTitle" xml:space="preserve">Der Testzeitraum ist abgelaufen</x:String>
  <x:String x:Key="Text.License.Msg.Activated" xml:space="preserve">Die Lizenz wurde aktiviert 🎉 Vielen Dank!</x:String>
  <x:String x:Key="Text.License.Msg.CheckOk" xml:space="preserve">Überprüfung abgeschlossen. Danke, dass Sie Kiriha nutzen!</x:String>
  <x:String x:Key="Text.License.Msg.Checking" xml:space="preserve">Wird online überprüft …</x:String>
  <x:String x:Key="Text.License.Msg.EnterKey" xml:space="preserve">Geben Sie den beim Kauf ausgestellten Lizenzschlüssel ein.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidKey" xml:space="preserve">Dieser Lizenzschlüssel ist ungültig. Prüfen Sie, ob beim Kopieren Zeichen fehlen oder Leerzeichen hinzugekommen sind.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseFailed" xml:space="preserve">Die Kaufseite konnte nicht geöffnet werden. Bitte versuchen Sie es später erneut.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseOpened" xml:space="preserve">Die Kaufseite wurde im Browser geöffnet. Fügen Sie den auf der Bestätigungsseite angezeigten Lizenzschlüssel oben ein.</x:String>
  <x:String x:Key="Text.License.Msg.Revoked" xml:space="preserve">Diese Lizenz ist nicht mehr gültig (z. B. nach einer Rückerstattung). Bitte kaufen Sie erneut.</x:String>
  <x:String x:Key="Text.License.Msg.ServerUnreachable" xml:space="preserve">Der Server war nicht erreichbar. Prüfen Sie Ihre Netzwerkverbindung und versuchen Sie es erneut.</x:String>
  <x:String x:Key="Text.License.OpenPurchase" xml:space="preserve">Kaufseite öffnen (¥980, einmalig)</x:String>
  <x:String x:Key="Text.License.PurchaseNote" xml:space="preserve">Nach dem Kauf wird der Lizenzschlüssel auf der Zahlungsbestätigung angezeigt. Es ist kein Konto und kein Passwort nötig.</x:String>
  <x:String x:Key="Text.License.Recheck" xml:space="preserve">Erneut online prüfen</x:String>

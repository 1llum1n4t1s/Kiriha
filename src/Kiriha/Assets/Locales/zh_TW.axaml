  <x:String x:Key="Text.New.UndoFailed" xml:space="preserve">無法復原新增資料夾: {0}</x:String>
  <x:String x:Key="Text.Op.Copied" xml:space="preserve">已複製 {0} 個項目</x:String>
  <x:String x:Key="Text.Op.DeleteFailed" xml:space="preserve">刪除失敗（{0}）</x:String>
  <x:String x:Key="Text.Op.Failed" xml:space="preserve">檔案操作失敗（{0}）</x:String>
  <x:String x:Key="Text.Op.Moved" xml:space="preserve">已移動 {0} 個項目</x:String>
  <x:String x:Key="Text.Op.PasteFailed" xml:space="preserve">貼上失敗（{0}）</x:String>
  <x:String x:Key="Text.Op.RenameFailed" xml:space="preserve">重新命名失敗（{0}）</x:String>
  <x:String x:Key="Text.Op.ShortcutsCreated" xml:space="preserve">已建立 {0} 個捷徑</x:String>
  <x:String x:Key="Text.Op.UndoFailed" xml:space="preserve">無法復原 ({0})</x:String>
  <x:String x:Key="Text.Op.Undone" xml:space="preserve">已還原 {0} 個項目</x:String>
  <x:String x:Key="Text.Preview.FolderSummary" xml:space="preserve">{0} 個檔案  {1}</x:String>
  <x:String x:Key="Text.Preview.OrMore" xml:space="preserve"> 以上</x:String>
  <x:String x:Key="Text.RecycleBin.Empty" xml:space="preserve">清空資源回收筒</x:String>
  <x:String x:Key="Text.Rename.AlreadyExists" xml:space="preserve">已有同名的檔案或資料夾: {0}</x:String>
  <x:String x:Key="Text.Rename.InvalidChars" xml:space="preserve">檔名包含無效字元: \ / : * ? " &lt; &gt; |</x:String>
  <x:String x:Key="Text.Rename.RevertedToOriginal" xml:space="preserve">重新命名失敗，已還原成原本的名稱</x:String>
  <x:String x:Key="Text.Rename.StuckAsTemporary" xml:space="preserve">重新命名失敗，仍保留暫時名稱: {0}</x:String>
  <x:String x:Key="Text.Search.ClearTip" xml:space="preserve">清除搜尋</x:String>
  <x:String x:Key="Text.Search.Failed" xml:space="preserve">搜尋失敗: {0}</x:String>
  <x:String x:Key="Text.Search.Found" xml:space="preserve">找到 {0} 筆結果（含子資料夾）</x:String>
  <x:String x:Key="Text.Search.Placeholder" xml:space="preserve">搜尋 {0}</x:String>
  <x:String x:Key="Text.Search.Searching" xml:space="preserve">搜尋中...（含子資料夾）</x:String>
  <x:String x:Key="Text.Search.Truncated" xml:space="preserve">已在 {0} 筆處停止（達到 1000 筆上限，仍有子資料夾未掃描；縮小搜尋範圍即可看到更多）</x:String>
  <x:String x:Key="Text.Select.All" xml:space="preserve">全選</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">只選取檔案</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">只選取資料夾</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">反向選取</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">取消選取</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">關於 Kiriha</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha 把 Windows 檔案總管的檔案操作，與 Chrome 的分頁、網址列和書籤整合在同一個視窗中。設定會儲存在目前的使用者帳戶下。</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">視窗使用壓克力效果（半透明模糊）</x:String>
  <x:String x:Key="Text.Settings.ContextMenu" xml:space="preserve">右鍵選單</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Modern" xml:space="preserve">Kiriha 自繪（Windows 11 風格）</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Note" xml:space="preserve">Windows 11 風格的選單只列出精選項目與 Shell 擴充功能；「傳送到」等子選單保留在「顯示其他選項」中。若某個擴充功能顯示不正常，請切換其他方式。</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Shell" xml:space="preserve">Kiriha 自繪（原樣顯示 Shell 項目）</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.System" xml:space="preserve">Windows 標準</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">將 Kiriha 設為開啟資料夾和磁碟機的預設應用程式</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">啟用後，從檔案總管開啟資料夾或磁碟機時會啟動 Kiriha。</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">目前資料夾和磁碟機會在 Kiriha 中開啟。關閉後會恢復先前的行為。</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">資料夾預設檢視</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">檢視方式</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">尚未儲存檢視方式的資料夾會以此設定開啟。在資料夾中變更檢視方式或排序時，只會為該資料夾單獨記住。</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">重設每個資料夾的檢視設定</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">已刪除每個資料夾的檢視設定。</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">刪除各資料夾記住的檢視方式、排序與欄寬，並回復為上方的預設值。</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">排序方式</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">外觀</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">調整檔案清單的外觀與 Kiriha 的樣式</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">檔案清單</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">在檔案總管的右鍵選單中加入「以 Kiriha 開啟」</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">在資料夾或其內容的空白處按右鍵，即可用 Kiriha 開啟該資料夾。</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">資料夾樹狀圖</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">圖庫</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Material Icon Theme 使用 material-icon-theme（MIT 授權，© Material Extensions）。Windows 圖示組會顯示與檔案總管相同的 Shell 圖示。</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Kiriha 原創圖示</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Windows Shell 圖示</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">圖示</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">顯示語言</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">預設會依 Windows 的顯示語言自動選擇。</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">授權</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">維護</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">資料與快取</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">開啟記錄檔資料夾</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">重新載入快速存取</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">重設設定</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">管理快取、記錄檔與設定資料</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">最小化到通知區域</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">最小化後 Kiriha 會從工作列消失，可從通知區域的圖示還原。</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">滑鼠</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">按兩下資料夾空白處時</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">在資料夾空白處按下滾輪時</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">關閉分頁</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">不執行任何動作</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">釘選分頁</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">重新整理</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">按兩下分頁時</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">在分頁上按下滾輪時</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">移到上一層</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">開機時啟動 Kiriha</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">登入時會自動啟動 Kiriha。</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">在 Kiriha 內用 Kiriha 開啟圖片</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">僅在 Kiriha 內雙擊時生效，會以藝廊模式全螢幕開啟（各廠商的 RAW 也視為圖片）。不會變更 Windows 的檔案關聯。</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">在 Kiriha 內用 Kiriha 開啟影片</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">減少放大時的模糊（銳化）</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">強</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">弱</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">最強 (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">標準</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">將圖片與影片放大到螢幕大小時，只對輪廓做適度銳化（相當於 AMD FidelityFX RCAS）。影片在繪製時交給 GPU 處理，播放幾乎不會增加 CPU 負擔。</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">快速鍵</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">檔案操作</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　剪下、複製、貼上　　Delete / Shift+Delete　刪除、永久刪除&#10;F2　重新命名　　Alt+Enter　內容　　Ctrl+Shift+N　新增資料夾　　Alt+P　預覽</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">導覽與檢視</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　編輯位址&#10;Ctrl+F / F3　搜尋&#10;Alt+← / →　上一頁與下一頁&#10;Alt+↑　上一層&#10;F5　重新整理 / F11　全螢幕</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">讓操作更快速的鍵盤快速鍵一覽</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">分頁</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　開新分頁&#10;Ctrl+W　關閉分頁&#10;Ctrl+Shift+T　重新開啟已關閉的分頁&#10;Ctrl+Tab　切換分頁&#10;Ctrl+1..9　選擇指定分頁</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">顯示項目核取方塊</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">顯示副檔名</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">顯示隱藏檔案</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">啟動時最小化到通知區域</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">Kiriha 啟動時不顯示視窗，直接最小化到通知區域。</x:String>
  <x:String x:Key="Text.Settings.Startup" xml:space="preserve">啟動</x:String>
  <x:String x:Key="Text.Settings.Startup.Behavior" xml:space="preserve">啟動時的行為</x:String>
  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">新分頁要開啟的資料夾（留白則使用您的使用者資料夾）</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">下次啟動時還原關閉前開啟的分頁</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">管理啟動方式、Windows 整合與通知區域</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">佈景主題</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">深色</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">淺色</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">跟隨系統</x:String>
  <x:String x:Key="Text.Settings.Tray" xml:space="preserve">通知區域</x:String>
  <x:String x:Key="Text.Settings.TreeDragDisabled" xml:space="preserve">禁止從樹狀圖拖曳</x:String>
  <x:String x:Key="Text.Settings.TreeDropDisabled" xml:space="preserve">禁止拖放到樹狀圖</x:String>
  <x:String x:Key="Text.Settings.Updates" xml:space="preserve">更新與資訊</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckNow" xml:space="preserve">立即檢查更新</x:String>
  <x:String x:Key="Text.Settings.Updates.CheckOnStartup" xml:space="preserve">啟動時檢查更新</x:String>
  <x:String x:Key="Text.Settings.Updates.Subtitle" xml:space="preserve">查看 Kiriha 的版本並管理更新</x:String>
  <x:String x:Key="Text.Settings.Updates.VersionCard" xml:space="preserve">版本與更新</x:String>
  <x:String x:Key="Text.Settings.Window" xml:space="preserve">視窗</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBounds" xml:space="preserve">記住視窗的大小和位置</x:String>
  <x:String x:Key="Text.Settings.Window.RememberBoundsNote" xml:space="preserve">關閉後，下次會以預設的大小和位置啟動。</x:String>
  <x:String x:Key="Text.Settings.WindowsIntegration" xml:space="preserve">Windows 整合</x:String>
  <x:String x:Key="Text.Settings.VideoSeekSeconds" xml:space="preserve">影片快進快退的秒數</x:String>
  <x:String x:Key="Text.Share.FileCount" xml:space="preserve">{0} 個檔案</x:String>
  <x:String x:Key="Text.Share.FoldersNotSupported" xml:space="preserve">無法共用資料夾（請選取檔案）</x:String>
  <x:String x:Key="Text.Share.NoItems" xml:space="preserve">沒有可共用的項目</x:String>
  <x:String x:Key="Text.Share.OpenFailed" xml:space="preserve">無法開啟共用面板</x:String>
  <x:String x:Key="Text.Share.PrepareFailed" xml:space="preserve">無法準備要共用的資料</x:String>
  <x:String x:Key="Text.Share.SelectFiles" xml:space="preserve">請選取要共用的檔案</x:String>
  <x:String x:Key="Text.Sidebar.Bookmarks" xml:space="preserve">書籤</x:String>
  <x:String x:Key="Text.Sidebar.Drives" xml:space="preserve">磁碟機</x:String>
  <x:String x:Key="Text.Sidebar.QuickAccess" xml:space="preserve">快速存取</x:String>
  <x:String x:Key="Text.Sidebar.RecentFiles" xml:space="preserve">最近使用的檔案</x:String>
  <x:String x:Key="Text.Sidebar.RecycleBin" xml:space="preserve">資源回收筒</x:String>
  <x:String x:Key="Text.Sidebar.RecycleBinTip" xml:space="preserve">在檔案總管中開啟資源回收筒</x:String>
  <x:String x:Key="Text.Sidebar.TreeView" xml:space="preserve">樹狀檢視</x:String>
  <x:String x:Key="Text.Sort.Ascending" xml:space="preserve">遞增</x:String>
  <x:String x:Key="Text.Sort.Descending" xml:space="preserve">遞減</x:String>
  <x:String x:Key="Text.Status.Breakdown" xml:space="preserve">（資料夾 {0} 個，檔案 {1} 個）</x:String>
  <x:String x:Key="Text.Status.ClearSelectionTip" xml:space="preserve">按一下以取消選取</x:String>
  <x:String x:Key="Text.Status.DetailsViewTip" xml:space="preserve">詳細資料檢視</x:String>
  <x:String x:Key="Text.Status.Modified" xml:space="preserve">修改日期: {0}</x:String>
  <x:String x:Key="Text.Status.GalleryViewTip" xml:space="preserve">圖庫檢視</x:String>
  <x:String x:Key="Text.Status.IconSizeTip" xml:space="preserve">圖示大小</x:String>
  <x:String x:Key="Text.Status.ItemCount" xml:space="preserve">{0} 個項目</x:String>
  <x:String x:Key="Text.Status.ItemCountFiltered" xml:space="preserve">{0} 個項目（搜尋: {1}）</x:String>
  <x:String x:Key="Text.Status.ItemsSelected" xml:space="preserve">已選取 {0} 個項目</x:String>
  <x:String x:Key="Text.Status.LargeIconsTip" xml:space="preserve">大圖示檢視</x:String>
  <x:String x:Key="Text.Tab.Category" xml:space="preserve">分頁</x:String>
  <x:String x:Key="Text.Tab.Close" xml:space="preserve">關閉分頁</x:String>
  <x:String x:Key="Text.Tab.CloseBelow" xml:space="preserve">關閉下方的分頁</x:String>
  <x:String x:Key="Text.Tab.CloseOthers" xml:space="preserve">關閉其他分頁</x:String>
  <x:String x:Key="Text.Tab.Duplicate" xml:space="preserve">複製分頁</x:String>
  <x:String x:Key="Text.Tab.MoreActions" xml:space="preserve">更多分頁操作</x:String>
  <x:String x:Key="Text.Tab.New" xml:space="preserve">開新分頁</x:String>
  <x:String x:Key="Text.Tab.NewBelow" xml:space="preserve">在下方開新分頁</x:String>
  <x:String x:Key="Text.Tab.NewTip" xml:space="preserve">開新分頁 (Ctrl+T)</x:String>
  <x:String x:Key="Text.Tab.OpenInTabs" xml:space="preserve">在新分頁中開啟（{0} 個）</x:String>
  <x:String x:Key="Text.Tab.Pin" xml:space="preserve">釘選分頁</x:String>
  <x:String x:Key="Text.Tab.PinInTabs" xml:space="preserve">釘選為新分頁（{0} 個）</x:String>
  <x:String x:Key="Text.Tab.Pinned" xml:space="preserve">已釘選的分頁</x:String>
  <x:String x:Key="Text.Tab.RecentlyClosed" xml:space="preserve">最近關閉的分頁</x:String>
  <x:String x:Key="Text.Tab.Reopen" xml:space="preserve">重新開啟已關閉的分頁</x:String>
  <x:String x:Key="Text.Tab.SortTip" xml:space="preserve">排序分頁</x:String>
  <x:String x:Key="Text.Tab.Unpin" xml:space="preserve">取消釘選分頁</x:String>
  <x:String x:Key="Text.TabAction.CloseDuplicates" xml:space="preserve">關閉相同位置的重複分頁</x:String>
  <x:String x:Key="Text.TabAction.CloseLeft" xml:space="preserve">關閉上方的分頁</x:String>
  <x:String x:Key="Text.TabAction.CloseUnpinned" xml:space="preserve">關閉所有未釘選的分頁</x:String>

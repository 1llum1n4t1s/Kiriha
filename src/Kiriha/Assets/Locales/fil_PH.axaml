  <x:String x:Key="Text.Settings.Startup.PathCaption" xml:space="preserve">Folder na bubuksan sa mga bagong tab (iwanang blangko para sa iyong user folder)</x:String>
  <x:String x:Key="Text.Settings.Startup.RestoreTabs" xml:space="preserve">Ibalik ang mga tab na nakabukas noong isinara ang app</x:String>
  <x:String x:Key="Text.Settings.Startup.Subtitle" xml:space="preserve">Pamahalaan ang pagsisimula, integrasyon sa Windows at notification area</x:String>

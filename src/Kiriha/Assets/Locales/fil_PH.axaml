  <x:String x:Key="Text.License.KeyFallback" xml:space="preserve">Maglagay na lang ng license key</x:String>
  <x:String x:Key="Text.License.KeyPlaceholder" xml:space="preserve">License key na nagsisimula sa KIRIHA-</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckBody" xml:space="preserve">Mahigit 30 araw nang hindi na-verify online ang lisensya. Kumonekta sa internet at pindutin ang “I-verify ulit online”.</x:String>
  <x:String x:Key="Text.License.Lock.OnlineCheckTitle" xml:space="preserve">Kailangang i-verify online ang lisensya</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredBody" xml:space="preserve">Kailangan ng aktibong lisensya para gamitin ang Kiriha (¥980, isahang bayad).</x:String>
  <x:String x:Key="Text.License.Lock.TrialExpiredTitle" xml:space="preserve">Tapos na ang iyong panahon ng pagsubok</x:String>
  <x:String x:Key="Text.License.Msg.Activated" xml:space="preserve">Na-activate na ang iyong lisensya 🎉 Maraming salamat!</x:String>
  <x:String x:Key="Text.License.Msg.CheckOk" xml:space="preserve">Tapos na ang pag-verify. Salamat sa paggamit ng Kiriha!</x:String>
  <x:String x:Key="Text.License.Msg.Checking" xml:space="preserve">Nagve-verify online…</x:String>
  <x:String x:Key="Text.License.Msg.CodeSent" xml:space="preserve">Nagpadala kami ng confirmation code sa email. Ilagay ang 6 na numerong natanggap mo.</x:String>
  <x:String x:Key="Text.License.Msg.CodeTooSoon" xml:space="preserve">Masyadong madalas. Maghintay ng mga 30 segundo at subukan ulit.</x:String>
  <x:String x:Key="Text.License.Msg.EnterCode" xml:space="preserve">Ilagay ang 6-digit na code mula sa email.</x:String>
  <x:String x:Key="Text.License.Msg.EnterEmail" xml:space="preserve">Ilagay ang email address na ginamit mo sa pagbili.</x:String>
  <x:String x:Key="Text.License.Msg.EnterKey" xml:space="preserve">Ilagay ang license key na ibinigay noong bumili ka.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidCode" xml:space="preserve">Mali o expired na ang code. Magpadala ulit ng bagong code.</x:String>
  <x:String x:Key="Text.License.Msg.InvalidKey" xml:space="preserve">Hindi wasto ang license key na iyan. Tingnan kung may nawalang karakter o sobrang espasyong nakopya.</x:String>
  <x:String x:Key="Text.License.Msg.NoPurchase" xml:space="preserve">Walang nahanap na pagbili para sa email na ito. Pakisuri ang address na ginamit sa pagbili.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseFailed" xml:space="preserve">Hindi mabuksan ang pahina ng pagbili. Subukan ulit mamaya.</x:String>
  <x:String x:Key="Text.License.Msg.PurchaseOpened" xml:space="preserve">Nabuksan ang pahina ng pagbili sa browser. Kapag tapos na, i-activate gamit ang email field sa itaas.</x:String>
  <x:String x:Key="Text.License.Msg.Revoked" xml:space="preserve">Hindi na wasto ang lisensyang ito (halimbawa, na-refund). Mangyaring bumili ulit.</x:String>
  <x:String x:Key="Text.License.Msg.Sending" xml:space="preserve">Ipinapadala ang confirmation code…</x:String>
  <x:String x:Key="Text.License.Msg.ServerUnreachable" xml:space="preserve">Hindi maabot ang server. Tingnan ang iyong koneksyon sa network at subukan ulit.</x:String>
  <x:String x:Key="Text.License.Msg.Verifying" xml:space="preserve">Bineberipika…</x:String>
  <x:String x:Key="Text.License.OpenPurchase" xml:space="preserve">Buksan ang pahina ng pagbili (¥980, isahang bayad)</x:String>
  <x:String x:Key="Text.License.PurchaseNote" xml:space="preserve">Walang kailangang account o password. Isang beses na bayad na ¥980, walang limitasyon sa bilang ng computer.</x:String>
  <x:String x:Key="Text.License.Recheck" xml:space="preserve">I-verify ulit online</x:String>
  <x:String x:Key="Text.License.RecoverNote" xml:space="preserve">Magpapadala kami ng confirmation code sa email na ginamit mo sa pagbili. Hindi na kailangan ng license key.</x:String>
  <x:String x:Key="Text.License.ResendCode" xml:space="preserve">Ipadala ulit ang code</x:String>
  <x:String x:Key="Text.License.SendCode" xml:space="preserve">Ipadala ang code</x:String>

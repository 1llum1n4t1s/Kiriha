  <x:String x:Key="Text.Select.All" xml:space="preserve">सर्वं चिनु</x:String>
  <x:String x:Key="Text.Select.FilesOnly" xml:space="preserve">केवलं सञ्चिकाः चिनु</x:String>
  <x:String x:Key="Text.Select.FoldersOnly" xml:space="preserve">केवलं कोष्ठानि चिनु</x:String>
  <x:String x:Key="Text.Select.Invert" xml:space="preserve">चयनं विपर्यस्य</x:String>
  <x:String x:Key="Text.Select.None" xml:space="preserve">चयनं मुञ्च</x:String>
  <x:String x:Key="Text.Settings.About" xml:space="preserve">Kiriha विषये</x:String>
  <x:String x:Key="Text.Settings.About.Body" xml:space="preserve">Kiriha इत्येतत् Windows सञ्चिकादर्शकस्य सञ्चिकाकर्म, Chrome इत्यस्य पत्राणि, पदवीपट्टिका, चिह्नानि च एकस्मिन् गवाक्षे संयोजयति। विन्यासाः वर्तमानप्रयोक्तुः कृते रक्ष्यन्ते।</x:String>
  <x:String x:Key="Text.Settings.Acrylic" xml:space="preserve">गवाक्षे आक्रिलिकप्रभावं (अर्धपारदर्शकं मन्दीकरणम्) प्रयुङ्क्ष्व</x:String>
  <x:String x:Key="Text.Settings.ContextMenu" xml:space="preserve">सन्दर्भसूची</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Modern" xml:space="preserve">किरिहस्वकीयम् (Windows 11 शैली)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Note" xml:space="preserve">Windows 11-शैल्याः सूची चितान् विषयान् शेल-विस्तारांश्च एव दर्शयति; "प्रेषय" इत्यादीनि उपसूचीनि "अधिकविकल्पान् दर्शय" इत्यत्र तिष्ठन्ति। यदि कश्चित् विस्तारः सम्यक् न दृश्यते तर्हि अन्यं प्रकारं चिनोतु।</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.Shell" xml:space="preserve">किरिहस्वकीयम् (शेल-विषयाः यथावत्)</x:String>
  <x:String x:Key="Text.Settings.ContextMenu.System" xml:space="preserve">Windows-मानकम्</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp" xml:space="preserve">कोष्ठानां चालकानां च उद्घाटनाय Kiriha इत्येतत् प्रामाणिकम् अनुप्रयोगं कुरु</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.Off" xml:space="preserve">सक्रिये सति, सञ्चिकादर्शकात् कोष्ठं वा चालकं उद्घाटयति चेत् Kiriha आरभते।</x:String>
  <x:String x:Key="Text.Settings.DefaultFolderApp.On" xml:space="preserve">सम्प्रति कोष्ठानि चालकाश्च Kiriha इत्यत्र उद्घाट्यन्ते। निष्क्रिये सति पूर्वव्यवहारः पुनरागच्छति।</x:String>
  <x:String x:Key="Text.Settings.DefaultView" xml:space="preserve">पुटिकायाः पूर्वनिर्धारितं दर्शनम्</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Mode" xml:space="preserve">दर्शनप्रकारः</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Note" xml:space="preserve">यासु पुटिकासु दर्शनप्रकारः न सञ्चितः, ताः एतैः विकल्पैः उद्घाट्यन्ते। पुटिकायां दर्शनप्रकारः क्रमः वा परिवर्त्यते चेत् तत् तस्यै एव पुटिकायै स्मर्यते।</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Reset" xml:space="preserve">प्रतिपुटिकादर्शनविकल्पान् पुनःस्थापयतु</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetDone" xml:space="preserve">प्रतिपुटिकादर्शनविकल्पाः अपाकृताः।</x:String>
  <x:String x:Key="Text.Settings.DefaultView.ResetNote" xml:space="preserve">प्रतिपुटिकं स्मृतान् दर्शनप्रकारान् क्रमान् स्तम्भविस्तारांश्च सर्वान् अपाकरोति, उपरिस्थं पूर्वनिर्धारितं च प्रत्यानयति।</x:String>
  <x:String x:Key="Text.Settings.DefaultView.Sort" xml:space="preserve">क्रमीकरणम्</x:String>
  <x:String x:Key="Text.Settings.Display" xml:space="preserve">दर्शनम्</x:String>
  <x:String x:Key="Text.Settings.Display.Subtitle" xml:space="preserve">सञ्चिकासूच्याः दर्शनं Kiriha इत्यस्य रूपं च समायोजय</x:String>
  <x:String x:Key="Text.Settings.Explorer" xml:space="preserve">सञ्चिकासूची</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenu" xml:space="preserve">सञ्चिकादर्शकस्य दक्षिणनुदनसूच्यां “Kiriha द्वारा उद्घाटय” इति योजय</x:String>
  <x:String x:Key="Text.Settings.ExplorerContextMenuNote" xml:space="preserve">कोष्ठे तस्य अन्तः रिक्तस्थाने वा दक्षिणनुदनेन तत् कोष्ठं Kiriha इत्यत्र उद्घाटयितुं शक्यते।</x:String>
  <x:String x:Key="Text.Settings.FolderTree" xml:space="preserve">कोष्ठवृक्षः</x:String>
  <x:String x:Key="Text.Settings.Gallery" xml:space="preserve">चित्रशाला</x:String>
  <x:String x:Key="Text.Settings.IconSet.Material" xml:space="preserve">Material Icon Theme</x:String>
  <x:String x:Key="Text.Settings.IconSet.Note" xml:space="preserve">Material Icon Theme इत्येतत् material-icon-theme (MIT अनुज्ञा, © Material Extensions) प्रयुङ्क्ते। Windows समूहः सञ्चिकादर्शकस्य एव Shell प्रतीकानि दर्शयति।</x:String>
  <x:String x:Key="Text.Settings.IconSet.Original" xml:space="preserve">Kiriha इत्यस्य मूलप्रतीकानि</x:String>
  <x:String x:Key="Text.Settings.IconSet.Windows" xml:space="preserve">Windows Shell प्रतीकानि</x:String>
  <x:String x:Key="Text.Settings.Icons" xml:space="preserve">प्रतीकानि</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">दर्शनभाषा</x:String>
  <x:String x:Key="Text.Settings.Language.Note" xml:space="preserve">प्रामाणिकरूपेण Windows इत्यस्य दर्शनभाषातः स्वयं चीयते।</x:String>
  <x:String x:Key="Text.Settings.License" xml:space="preserve">अनुज्ञापत्रम्</x:String>
  <x:String x:Key="Text.Settings.Maintenance" xml:space="preserve">परिपालनम्</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Data" xml:space="preserve">दत्तांशः संग्रहश्च</x:String>
  <x:String x:Key="Text.Settings.Maintenance.OpenLogFolder" xml:space="preserve">अभिलेखकोष्ठम् उद्घाटय</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ReloadQuickAccess" xml:space="preserve">शीघ्रप्रवेशं पुनः आरोपय</x:String>
  <x:String x:Key="Text.Settings.Maintenance.ResetSettings" xml:space="preserve">विन्यासान् पुनःस्थापय</x:String>
  <x:String x:Key="Text.Settings.Maintenance.Subtitle" xml:space="preserve">संग्रहम्, अभिलेखान्, विन्यासदत्तांशं च परिपालय</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">संकोचनकाले सूचनाक्षेत्रे स्थापय</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTrayNote" xml:space="preserve">संकोचिते सति Kiriha कार्यपट्टिकातः अन्तर्धीयते, सूचनाक्षेत्रस्य प्रतीकात् पुनःस्थापयितुं शक्यते।</x:String>
  <x:String x:Key="Text.Settings.Mouse" xml:space="preserve">मूषकः</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundDoubleClick" xml:space="preserve">कोष्ठस्य रिक्तस्थाने द्विनुदने सति</x:String>
  <x:String x:Key="Text.Settings.Mouse.BackgroundMiddleClick" xml:space="preserve">कोष्ठस्य रिक्तस्थाने चक्रनुदने सति</x:String>
  <x:String x:Key="Text.Settings.Mouse.CloseTab" xml:space="preserve">पत्रं पिधेहि</x:String>
  <x:String x:Key="Text.Settings.Mouse.None" xml:space="preserve">किमपि न कुरु</x:String>
  <x:String x:Key="Text.Settings.Mouse.Pin" xml:space="preserve">पत्रं स्थापय</x:String>
  <x:String x:Key="Text.Settings.Mouse.Refresh" xml:space="preserve">नवीकुरु</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabDoubleClick" xml:space="preserve">पत्रे द्विनुदने सति</x:String>
  <x:String x:Key="Text.Settings.Mouse.TabMiddleClick" xml:space="preserve">पत्रे चक्रनुदने सति</x:String>
  <x:String x:Key="Text.Settings.Mouse.Up" xml:space="preserve">एकं स्तरम् ऊर्ध्वं गच्छ</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Windows आरम्भे Kiriha चालय</x:String>
  <x:String x:Key="Text.Settings.RunAtStartupNote" xml:space="preserve">प्रवेशकाले Kiriha स्वयम् आरभते।</x:String>
  <x:String x:Key="Text.Settings.OpenImagesInGallery" xml:space="preserve">Kiriha इत्यस्य अन्तः चित्राणि Kiriha द्वारा उद्घाटयतु</x:String>
  <x:String x:Key="Text.Settings.OpenInGallery.Note" xml:space="preserve">एतत् Kiriha इत्यस्य अन्तः द्विवारक्लिक्-समये एव प्रवर्तते; सञ्चिका पूर्णपटले चित्रशालायां उद्घाट्यते (RAW-सञ्चिकाः अपि चित्राणि इति गण्यन्ते)। Windows इत्यस्य सम्बन्धाः न परिवर्त्यन्ते।</x:String>
  <x:String x:Key="Text.Settings.OpenVideosInGallery" xml:space="preserve">Kiriha इत्यस्य अन्तः चलच्चित्राणि Kiriha द्वारा उद्घाटयतु</x:String>
  <x:String x:Key="Text.Settings.Sharpen" xml:space="preserve">आवर्धने अस्पष्टतां न्यूनीकरोतु (तैक्ष्ण्यम्)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.High" xml:space="preserve">प्रबलम्</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Low" xml:space="preserve">मृदु</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Max" xml:space="preserve">परमम् (CAS)</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Normal" xml:space="preserve">सामान्यम्</x:String>
  <x:String x:Key="Text.Settings.Sharpen.Note" xml:space="preserve">चित्रं चलच्चित्रं वा पटलानुसारं वर्धयति सति केवलं रेखाः मृदुतया दृढीक्रियन्ते (AMD FidelityFX RCAS सदृशम्)। चलच्चित्रं लेखनकाले GPU द्वारा संसाध्यते, अतः दर्शनसमये CPU-भारः प्रायः न वर्धते।</x:String>
  <x:String x:Key="Text.Settings.Shortcuts" xml:space="preserve">कुञ्चिकासङ्केताः</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOps" xml:space="preserve">सञ्चिकाकर्माणि</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.FileOpsBody" xml:space="preserve">Ctrl+X / C / V　छेदनम्, प्रतिलेखनम्, लेपनम्　　Delete / Shift+Delete　अपनयनम्, नित्यापनयनम्&#10;F2　नामपरिवर्तनम्　　Alt+Enter　गुणधर्माः　　Ctrl+Shift+N　नवीनं कोष्ठम्　　Alt+P　पूर्वदर्शनम्</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Navigation" xml:space="preserve">सञ्चरणं दर्शनं च</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.NavigationBody" xml:space="preserve">Ctrl+L / F4　पदवीसम्पादनम्&#10;Ctrl+F / F3　अन्वेषणम्&#10;Alt+← / →　पश्चात् अग्रे च&#10;Alt+↑　एकं स्तरम् ऊर्ध्वम्&#10;F5　नवीकरणम् / F11　पूर्णपटलम्</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Subtitle" xml:space="preserve">शीघ्रं कार्यं कर्तुं कुञ्चिकासङ्केतानां सूची</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.Tabs" xml:space="preserve">पत्राणि</x:String>
  <x:String x:Key="Text.Settings.Shortcuts.TabsBody" xml:space="preserve">Ctrl+T　नवीनं पत्रम्&#10;Ctrl+W　पत्रं पिधेहि&#10;Ctrl+Shift+T　पिहितं पत्रं पुनः उद्घाटय&#10;Ctrl+Tab　पत्राणि परिवर्तय&#10;Ctrl+1..9　निर्दिष्टं पत्रं चिनु</x:String>
  <x:String x:Key="Text.Settings.ShowCheckBoxes" xml:space="preserve">वस्तुचयनपेटिकाः दर्शय</x:String>
  <x:String x:Key="Text.Settings.ShowExtensions" xml:space="preserve">सञ्चिकाविस्तारान् दर्शय</x:String>
  <x:String x:Key="Text.Settings.ShowHidden" xml:space="preserve">गुप्ताः सञ्चिकाः दर्शय</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTray" xml:space="preserve">आरम्भे सूचनाक्षेत्रे स्थापय</x:String>
  <x:String x:Key="Text.Settings.StartMinimizedToTrayNote" xml:space="preserve">आरम्भानन्तरं गवाक्षं न दर्शयित्वा सूचनाक्षेत्रे स्थापितम् एव आरभते।</x:String>
